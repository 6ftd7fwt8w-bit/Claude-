{%- comment -%}
  Apartado de códigos de descuento en el carrito (página y panel lateral).
  - Tarjeta de celebración con el ahorro real (uno o varios códigos combinados).
  - Oferta cruzada: cuando el código de bienvenida está aplicado, sugiere el segundo código.
  - Campo para añadir códigos (se suman a los que ya hay).
{%- endcomment -%}
{%- liquid
  assign w_code = settings.welcome_code | strip | upcase
  assign x_code = settings.cross_code | strip | upcase
  assign codes_applied = ''
  assign w_applied = 0
  assign x_applied = 0
  for item in cart.items
    for alloc in item.line_level_discount_allocations
      assign t = alloc.discount_application.title | strip | upcase
      if t == w_code
        assign w_applied = w_applied | plus: alloc.amount
      endif
      if t == x_code
        assign x_applied = x_applied | plus: alloc.amount
      endif
      if alloc.discount_application.type == 'discount_code' and alloc.amount > 0
        assign t_key = '|' | append: t | append: '|'
        assign codes_check = '|' | append: codes_applied
        unless codes_check contains t_key
          assign codes_applied = codes_applied | append: t | append: '|'
        endunless
      endif
    endfor
  endfor
  for app in cart.cart_level_discount_applications
    if app.type == 'discount_code'
      assign t = app.title | strip | upcase
      assign t_key = '|' | append: t | append: '|'
      assign codes_check = '|' | append: codes_applied
      unless codes_check contains t_key
        assign codes_applied = codes_applied | append: t | append: '|'
      endunless
    endif
  endfor
  assign codes_list = codes_applied | split: '|'
  assign saving_cents = cart.original_total_price | minus: cart.total_price
  if saving_cents < cart.total_discount
    assign saving_cents = cart.total_discount
  endif
  assign ship_threshold = settings.free_shipping_threshold | times: 100
  assign ship_free = false
  if ship_threshold > 0 and cart.item_count > 0 and cart.total_price >= ship_threshold
    assign ship_free = true
  endif
  assign ship_saving = settings.free_shipping_saving | default: 0 | times: 100 | round
  assign shipping_label = 'cart.free_shipping_deal' | t | upcase
  assign show_cross = false
  if w_applied > 0 and x_applied == 0 and x_code != blank and settings.cross_collection != blank
    assign show_cross = true
  endif
-%}
<div class="cart-discount{% if compact %} cart-discount--compact{% endif %}" data-cart-discount>
  {%- if saving_cents > 0 or ship_free -%}
    <div class="deal-card{% if codes_list.size > 1 %} deal-card--max{% endif %}">
      <span class="deal-card__shine" aria-hidden="true"></span>
      <span class="deal-card__icon" aria-hidden="true">{% render 'icon', name: 'gift' %}</span>
      <div class="deal-card__body">
        {%- liquid
          # Ahorro total de la tarjeta: descuentos + envío gratis (como si fuera otro cupón)
          assign total_saving = saving_cents
          if ship_free
            assign total_saving = total_saving | plus: ship_saving
          endif
          assign total_saving_formatted = total_saving | money
        -%}
        <strong class="deal-card__title">
          {%- if saving_cents == 0 -%}
            {{ 'cart.free_shipping_title' | t }}
          {%- elsif codes_list.size > 1 -%}
            {{ 'cart.deal_title_max' | t }}
          {%- elsif codes_list.first == w_code and ship_free -%}
            {{ 'cart.deal_title_percent_ship' | t: percent: settings.welcome_percent }}
          {%- elsif codes_list.first == w_code -%}
            {{ 'cart.deal_title_percent' | t: percent: settings.welcome_percent }}
          {%- else -%}
            {{ 'cart.deal_title' | t }}
          {%- endif -%}
        </strong>
        {%- if codes_list.size > 1 -%}
          {%- assign codes_joined = codes_list | join: ' + ' -%}
          {%- if ship_free -%}{%- assign codes_joined = codes_joined | append: ' + ' | append: shipping_label -%}{%- endif -%}
          <span class="deal-card__text">{{ 'cart.deal_max_html' | t: codes: codes_joined, amount: total_saving_formatted }}</span>
        {%- elsif total_saving > 0 -%}
          <span class="deal-card__text">{{ 'cart.deal_saving_html' | t: amount: total_saving_formatted }}</span>
        {%- endif -%}
        {%- if codes_list.first == w_code and codes_list.size == 1 and settings.welcome_collection != blank and compact != true -%}
          <a class="deal-card__more" href="{{ settings.welcome_collection.url }}">{{ 'cart.deal_more' | t: percent: settings.welcome_percent }} <span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
        <span class="deal-card__codes">
          {%- for c in codes_list -%}
            <span class="deal-card__code">{{ c }} <button type="button" data-discount-remove="{{ c | escape }}" aria-label="{{ 'cart.discount_remove' | t }}">&times;</button></span>
          {%- endfor -%}
          {%- if ship_free -%}
            <span class="deal-card__code deal-card__code--ship">🚚 {{ shipping_label }}{% if ship_saving > 0 %} −{{ ship_saving | money }}{% endif %}</span>
          {%- endif -%}
        </span>
      </div>
    </div>
    {%- if w_applied > 0 -%}
      {%- comment -%} Cuenta atrás del código de bienvenida (la rellena theme.js) {%- endcomment -%}
      <div class="deal-timer" data-deal-timer hidden>
        <p class="deal-timer__head"><span class="deal-timer__dot" aria-hidden="true"></span>{{ 'cart.timer_head' | t }}</p>
        <div class="deal-timer__clock" aria-live="off">
          <span class="deal-timer__unit" data-deal-h-wrap><b data-deal-h>0</b><small>h</small></span>
          <span class="deal-timer__unit"><b data-deal-m>00</b><small>min</small></span>
          <span class="deal-timer__unit"><b data-deal-s>00</b><small>seg</small></span>
        </div>
        <p class="deal-timer__note">{{ 'cart.timer_note_html' | t }}</p>
      </div>
    {%- endif -%}
    {%- if saving_cents > 0 -%}
    <div class="cart-totals muted" style="font-size:13px"><span>{{ 'cart.before' | t }}</span><s>{{ cart.original_total_price | money }}</s></div>
    {%- endif -%}
  {%- endif -%}

  {%- if show_cross -%}
    <div class="cross-teaser" data-cross-card data-code="{{ settings.cross_code | strip | escape }}" data-url="{{ settings.cross_collection.url }}">
      <span class="cross-teaser__icon" aria-hidden="true">{% render 'icon', name: 'gift' %}</span>
      <span class="cross-teaser__text" data-cross-offer>{{ settings.cross_teaser }}</span>
      <span class="cross-teaser__text" data-cross-pending hidden>{{ settings.cross_pending | escape | replace: '[code]', '<strong>[code]</strong>' | replace: '[code]', x_code }}</span>
      <button type="button" class="cross-teaser__link" data-cross-apply>{{ settings.cross_button }}</button>
      <a class="cross-teaser__link" href="{{ settings.cross_collection.url }}" data-cross-go hidden>{{ settings.cross_go }} &rarr;</a>
    </div>
  {%- endif -%}

  <details class="cart-discount__details"{% unless compact or saving_cents > 0 %} open{% endunless %}>
  <summary class="cart-discount__label">{% render 'icon', name: 'gift' %}<span>{% if saving_cents > 0 %}{{ 'cart.discount_label_more' | t }}{% else %}{{ 'cart.discount_label' | t }}{% endif %}</span></summary>
  <form class="cart-discount__form" data-discount-form novalidate>
    <label class="visually-hidden" for="DiscountCode-{{ form_id | default: 'cart' }}">{{ 'cart.discount_placeholder' | t }}</label>
    <div class="cart-discount__row">
      <input class="input" type="text" id="DiscountCode-{{ form_id | default: 'cart' }}" name="discount" autocomplete="off" autocapitalize="characters" spellcheck="false"
        placeholder="{{ 'cart.discount_placeholder' | t }}" data-discount-input>
      <button type="submit" class="button cart-discount__apply">{{ 'cart.discount_apply' | t }}</button>
    </div>
    <p class="cart-discount__msg" data-discount-msg hidden></p>
  </form>
  </details>
  <div class="cart-discount__form-extra">
    {%- if w_applied == 0 -%}
      <p class="cart-discount__hint" data-discount-hint hidden>
        {%- assign code_html = '<strong>' | append: settings.welcome_code | append: '</strong>' -%}
        {{ 'cart.discount_waiting_html' | t: code: code_html, percent: settings.welcome_percent }}
        {%- if settings.welcome_collection != blank %} <a href="{{ settings.welcome_collection.url }}">{{ 'cart.discount_waiting_link' | t }}</a>{%- endif -%}
      </p>
    {%- endif -%}
  </div>
</div>
