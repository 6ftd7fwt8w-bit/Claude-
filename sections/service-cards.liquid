<section class="section bg-{{ section.settings.background }} reveal" data-reveal>
  <div class="page-width">
    {%- if section.settings.title != blank -%}<h2 class="section-title">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="service-grid" style="--cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="service-card" {{ block.shopify_attributes }}
          {%- if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>
          <span class="service-card__icon">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 160 | image_tag: alt: '' }}
            {%- else -%}
              {% render 'icon', name: block.settings.icon %}
            {%- endif -%}
          </span>
          <span>
            <span class="service-card__title">{{ block.settings.title }}</span>
            <span class="service-card__text" style="display:block">{{ block.settings.text }}</span>
          </span>
          <span class="service-card__arrow">{% render 'icon', name: 'arrow-right' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tarjetas de servicio",
  "settings": [
    { "type": "text", "id": "title", "label": "Título" },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [{ "value": "default", "label": "Crema" }, { "value": "alt", "label": "Arena" }],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Tarjeta",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icono",
          "options": [
            { "value": "brush", "label": "Pincel" }, { "value": "frame", "label": "Cuadro" }, { "value": "truck", "label": "Envío" },
            { "value": "gift", "label": "Regalo" }, { "value": "heart", "label": "Corazón" }, { "value": "lock", "label": "Candado" },
            { "value": "chat", "label": "Mensaje" }, { "value": "whatsapp", "label": "WhatsApp" }, { "value": "star", "label": "Estrella" },
            { "value": "camera", "label": "Cámara" }, { "value": "box", "label": "Caja" }
          ],
          "default": "brush"
        },
        { "type": "image_picker", "id": "image", "label": "Icono propio (opcional)" },
        { "type": "text", "id": "title", "label": "Título", "default": "Asesoramiento" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Te ayudamos a elegir" },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "checkbox", "id": "new_tab", "label": "Abrir en otra pestaña", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Tarjetas de servicio", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
