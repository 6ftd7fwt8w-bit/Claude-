{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
-%}
{%- if settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  <div class="cart-shipping-bar{% if remaining <= 0 %} is-free{% endif %}">
    <p class="cart-shipping-bar__text">
      <span class="cart-shipping-bar__icon" aria-hidden="true">{% if remaining > 0 %}🚚{% else %}🎉{% endif %}</span>
      <span>
      {%- if remaining > 0 -%}
        {%- assign remaining_formatted = remaining | money -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_formatted }}
      {%- else -%}
        {{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
      {%- if settings.free_shipping_zone != blank %} <small>({{ settings.free_shipping_zone }})</small>{%- endif -%}
      </span>
    </p>
    {%- assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 -%}
    <div class="cart-shipping-bar__track"><div class="cart-shipping-bar__fill" style="width: {{ pct }}%"></div></div>
  </div>
{%- endif -%}
{%- if cart.item_count > 0 and hide_discount != true -%}{% render 'cart-discount', form_id: form_id %}{%- endif -%}
{%- liquid
  assign disc_cents = cart.original_total_price | minus: cart.total_price
  assign ship_is_free = false
  if settings.free_shipping_threshold > 0 and cart.item_count > 0 and remaining <= 0
    assign ship_is_free = true
  endif
  assign ship_cents = settings.free_shipping_saving | default: 0 | times: 100 | round
  assign saved_cents = disc_cents
  if ship_is_free
    assign saved_cents = saved_cents | plus: ship_cents
  endif
-%}
{%- if cart.item_count > 0 and saved_cents > 0 -%}
  {%- comment -%} Desglose: importe de los productos, descuentos y envío gratis en verde, y total estimado {%- endcomment -%}
  <div class="cart-breakdown">
    <div class="cart-breakdown__row"><span>{{ 'cart.breakdown_products' | t }}</span><span>{{ cart.original_total_price | money }}</span></div>
    {%- if disc_cents > 0 -%}
      <div class="cart-breakdown__row is-saving"><span>{{ 'cart.breakdown_discounts' | t }}</span><span>−{{ disc_cents | money }}</span></div>
    {%- endif -%}
    {%- if ship_is_free -%}
      <div class="cart-breakdown__row is-saving"><span>{{ 'cart.breakdown_shipping' | t }}{% if settings.free_shipping_zone != blank %} ({{ settings.free_shipping_zone }}){% endif %}</span><span>{% if ship_cents > 0 %}<s>{{ ship_cents | money }}</s> {% endif %}<b>{{ 'cart.breakdown_free' | t }}</b></span></div>
    {%- endif -%}
    <div class="cart-breakdown__total"><span>{{ 'cart.breakdown_total' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>
    {%- assign saved_formatted = saved_cents | money -%}
    <p class="cart-breakdown__saved">🎉 {{ 'cart.breakdown_saved_html' | t: amount: saved_formatted }}</p>
  </div>
{%- else -%}
  <div class="cart-totals"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>
{%- endif -%}
{%- if settings.free_shipping_threshold > 0 and cart.item_count > 0 and remaining <= 0 -%}
  <ul class="cart-free-note">
    <li><span class="cart-free-note__check" aria-hidden="true">✓</span>{{ 'cart.free_note_taxes' | t }}</li>
    <li><span class="cart-free-note__check" aria-hidden="true">✓</span>{{ 'cart.free_note_shipping' | t }}{% if settings.free_shipping_zone != blank %} ({{ settings.free_shipping_zone }}){% endif %}</li>
    <li><span class="cart-free-note__check" aria-hidden="true">✓</span><strong>{{ 'cart.free_note_final' | t }}</strong></li>
  </ul>
  <p class="cart-free-note__small">{{ 'cart.free_note_outside' | t }}</p>
{%- else -%}
  <p class="muted" style="font-size:12px;margin-bottom:14px">{{ 'cart.taxes_shipping' | t }}</p>
{%- endif -%}
