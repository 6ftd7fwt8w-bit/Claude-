{%- comment -%}
  Tarjeta de producto. Parámetros: product, lazy (bool), show_quick_add (bool),
  image_pos ('last' = usa la última foto como principal), ratio (p. ej. '1 / 1'), price_suffix (texto tras el precio),
  hot (texto de la etiqueta 🔥 de producto destacado).
  Si el código de bienvenida vale para el producto, muestra el precio con descuento
{%- endcomment -%}
{%- liquid
  assign img = product.featured_media.preview_image
  assign img2 = product.media[1].preview_image
  if image_pos == 'last' and product.media.size > 1
    assign img = product.media.last.preview_image
    assign img2 = product.featured_media.preview_image
  endif
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign deal = false
  if settings.welcome_code != blank and settings.welcome_collection != blank
    for c in product.collections
      if c.handle == settings.welcome_collection.handle
        assign deal = true
        break
      endif
    endfor
  endif
  assign cross_deal = false
  if deal == false and settings.cross_code != blank and settings.cross_collection != blank and settings.cross_card != blank
    for c in product.collections
      if c.handle == settings.cross_collection.handle
        assign cross_deal = true
        break
      endif
    endfor
  endif
  assign cover_class = ''
  if settings.card_ratio == 'adapt'
    assign cover_class = ' card__img--cover'
  endif
-%}
<div class="card{% if hot != blank %} card--hot{% endif %}">
  <a href="{{ product.url }}" class="card__media"
    {%- if ratio != blank %} style="aspect-ratio: {{ ratio }}"{% elsif settings.card_ratio == 'adapt' and img %} style="aspect-ratio: {{ img.aspect_ratio }}"{% endif %}
    aria-label="{{ product.title | escape }}">
    {%- if hot != blank -%}
      <span class="card__hot"><span class="card__hot-flame" aria-hidden="true">🔥</span>{{ hot }}</span>
    {%- endif -%}
    {%- if product.compare_at_price > product.price and product.available -%}
      <span class="card__badge card__badge--sale">{{ 'products.sale' | t }}</span>
    {%- elsif product.available == false -%}
      <span class="card__badge">{{ 'products.sold_out' | t }}</span>
    {%- else -%}
      {%- assign has_canvas = false -%}
      {%- for v in product.variants -%}{%- if v.option1 contains 'Lienzo' -%}{%- assign has_canvas = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
      {%- if has_canvas -%}<span class="card__badge card__badge--new">{{ 'products.canvas_badge' | t }}</span>{%- endif -%}
    {%- endif -%}
    {%- if img -%}
      {{ img | image_url: width: 900 | image_tag:
        loading: loading,
        widths: '300, 450, 600, 750, 900',
        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 60vw',
        alt: img.alt | default: product.title,
        class: cover_class
      }}
      {%- if settings.card_show_second_image and img2 -%}
        {{ img2 | image_url: width: 900 | image_tag:
          loading: 'lazy',
          widths: '300, 450, 600, 750, 900',
          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 60vw',
          alt: '',
          class: 'card__img--hover card__img--cover'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="card__info">
    {%- if settings.card_show_vendor -%}<div class="card__vendor">{{ product.vendor }}</div>{%- endif -%}
    <a href="{{ product.url }}" class="card__title">{{ product.title | split: ' | ' | first | escape }}</a>
    <div class="card__price">{% render 'price', product: product, show_from: settings.card_from_price %}{% if price_suffix != blank %} <span class="card__price-suffix">{{ price_suffix }}</span>{% endif %}</div>
    {%- if deal -%}
      {%- assign pct = settings.welcome_percent | default: 10 -%}
      {%- assign deal_price = 100 | minus: pct | times: product.price_min | divided_by: 100 -%}
      <div class="card__deal">
        <strong>🍀 ¡Estás de suerte!</strong>
        <span>Con el código de descuento <b>{{ settings.welcome_code }}</b>,{% if product.price_varies %} desde{% endif %} <b class="card__deal-price">{{ deal_price | money }}</b> · por tiempo limitado</span>
      </div>
    {%- elsif cross_deal -%}
      {%- assign cross_code_html = '<b>' | append: settings.cross_code | append: '</b>' -%}
      <div class="card__deal">
        <strong>🍀 ¡Estás de suerte! 3x2</strong>
        <span>{{ settings.cross_card | escape | replace: '[code]', cross_code_html }}</span>
      </div>
    {%- endif -%}
  </div>
</div>
