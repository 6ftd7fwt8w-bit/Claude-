{%- comment -%} Guía de tamaños a escala (persona de referencia + lámina A3 + lienzos) {%- endcomment -%}
<section class="section bg-{{ section.settings.background }} canvas-sizes">
  <div class="page-width">
    {%- if section.settings.title != blank -%}<h2 class="section-title">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.subtitle != blank -%}<p class="section-subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
    {% render 'size-guide', art: section.settings.art, art_a3: section.settings.art_a3 %}
  </div>
</section>

{% schema %}
{
  "name": "Guía de tamaños",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Elige el tamaño" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" },
    { "type": "image_picker", "id": "art", "label": "Ilustración de ejemplo (lienzos)", "info": "Solo la ilustración, sin fondo de habitación" },
    { "type": "image_picker", "id": "art_a3", "label": "Ilustración de ejemplo (lámina A3)" },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [{ "value": "default", "label": "Crema" }, { "value": "alt", "label": "Arena" }],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Guía de tamaños" }]
}
{% endschema %}
