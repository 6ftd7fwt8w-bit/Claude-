<section class="section section--apps bg-{{ section.settings.background }}" id="{{ section.settings.anchor | default: 'apps' | handleize }}">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.text != blank -%}
      <div class="apps-head">
        {%- if section.settings.title != blank -%}<h2 class="section-title">{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="apps-head__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</section>

<style>
  .section--apps .apps-head { text-align: center; max-width: 640px; margin: 0 auto 28px; }
  .section--apps .apps-head .section-title { margin: 0; }
  .section--apps .apps-head__text { margin: 10px 0 0; color: var(--color-muted, #7B7168); }
  /* Judge.me: sin «Sé el primero…» ni título duplicado (ya va el de la sección) */
  .section--apps .jm-no-reviews-state__text,
  .section--apps .jm-review-widget-minimal-header__title { display: none !important; }
</style>

{%- if section.settings.auto_open_review -%}
<script>
  (function () {
    var tries = 0;
    var t = setInterval(function () {
      var btn = document.querySelector('#{{ section.settings.anchor | default: 'apps' | handleize }} .jm-action-buttons__button');
      if (btn) { clearInterval(t); btn.click(); }
      else if (++tries > 60) clearInterval(t);
    }, 250);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Apps (reseñas…)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Título" },
    { "type": "text", "id": "text", "label": "Texto" },
    { "type": "text", "id": "anchor", "label": "Ancla (#)", "default": "opiniones" },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [{ "value": "default", "label": "Crema" }, { "value": "alt", "label": "Arena" }],
      "default": "default"
    },
    { "type": "checkbox", "id": "auto_open_review", "label": "Abrir el formulario de reseña al entrar", "default": false }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Apps (reseñas…)" }]
}
{% endschema %}
