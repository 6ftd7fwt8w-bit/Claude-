{%- comment -%} Renderizado por la Section Rendering API para refrescar el panel del carrito {%- endcomment -%}
{%- if cart.item_count > 0 -%}
  <div class="drawer__body">
    {% render 'cart-items' %}
    {% render 'cart-discount', form_id: 'drawer', compact: true %}
    <div class="drawer__summary">{% render 'cart-summary', form_id: 'drawer', hide_discount: true %}</div>
  </div>
  <div class="drawer__footer">
    {%- liquid
      assign drawer_saved = cart.original_total_price | minus: cart.total_price
      if settings.free_shipping_threshold > 0
        assign ship_limit = settings.free_shipping_threshold | times: 100
        if cart.total_price >= ship_limit
          assign ship_add = settings.free_shipping_saving | default: 0 | times: 100 | round
          assign drawer_saved = drawer_saved | plus: ship_add
        endif
      endif
    -%}
    <div class="drawer__total">
      <span>{% if drawer_saved > 0 %}{{ 'cart.breakdown_total' | t }}{% else %}{{ 'cart.subtotal' | t }}{% endif %}</span>
      <strong>{{ cart.total_price | money }}</strong>
    </div>
    {%- if drawer_saved > 0 -%}{%- assign drawer_saved_formatted = drawer_saved | money -%}<p class="drawer__saved">🎉 {{ 'cart.breakdown_saved_html' | t: amount: drawer_saved_formatted }}</p>{%- endif -%}
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="button button--full">{% render 'icon', name: 'lock' %}{{ 'cart.checkout' | t }}</button>
    </form>
    {% render 'cart-trust' %}
    <div class="drawer__links">
      <button type="button" class="link-underline" data-drawer-close>{{ 'cart.continue' | t }}</button>
      <a href="{{ routes.cart_url }}" class="link-underline">{{ 'cart.view_cart' | t }}</a>
    </div>
  </div>
{%- else -%}
  <div class="drawer__body cart-empty">
    <p>{{ 'cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="button" style="margin-top:12px">{{ 'cart.continue' | t }}</a>
  </div>
{%- endif -%}
<span hidden data-cart-count-value>{{ cart.item_count }}</span>

{% schema %}
{ "name": "Contenido del carrito" }
{% endschema %}
