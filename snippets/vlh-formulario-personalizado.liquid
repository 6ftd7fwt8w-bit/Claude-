{% comment %}
  ============================================================
  VIVA LA HOME — Formulario personalizado de producto (v2, simplificado)
  ============================================================
  Diferencias respecto al formulario completo original:
  - Se eliminan las opciones de Fondo y Texto personalizado como
    extras de pago. Si el cliente quiere algo así, lo indica en el
    campo de notas para el diseñador (ver placeholder de esa sección).
  - Se elimina también la sección de Revisión con diseñador: la
    revisión sigue incluida siempre en el precio base (como se ha
    vendido históricamente), pero deja de ser una decisión o un
    extra dentro del formulario.
  - Se elimina el selector de fecha de entrega y el recargo de
    urgencia. Se sustituye por un texto informativo con un rango de
    fechas estimado (hoy + 15 a hoy + 20 días) calculado en el
    momento de cargar la página, y un aviso para contactar por
    WhatsApp si se necesita antes.
  - La pregunta de "varias fotografías" se integra directamente en
    la sección de subida de fotos, en vez de ir separada.
  - El resto de la lógica de Shopify (variantes, precios, packs,
    marco, add to cart, propiedades del pedido, subida de archivos)
    se mantiene igual que en el formulario completo.
  ============================================================
{% endcomment %}

{%- assign h_pack_regalo     = 'vlh-extra-pack-regalo' -%}
{%- assign h_pack_valentina  = 'vlh-extra-pack-valentina' -%}
{%- assign h_marco_a4        = 'vlh-extra-marco-a4' -%}
{%- assign h_marco_a3        = 'vlh-extra-marco-a3' -%}
{%- assign h_composicion     = 'vlh-extra-composicion-varias-fotos' -%}

{%- assign p_pack_regalo     = all_products[h_pack_regalo] -%}
{%- assign p_pack_valentina  = all_products[h_pack_valentina] -%}
{%- assign p_marco_a4        = all_products[h_marco_a4] -%}
{%- assign p_marco_a3        = all_products[h_marco_a3] -%}
{%- assign p_composicion     = all_products[h_composicion] -%}

{%- comment -%} Listas únicas de valores de Tamaño y de la 2ª opción (si existe), sacadas de las variantes reales del producto {%- endcomment -%}
{%- assign vlh_tamanos_raw = '' -%}
{%- assign vlh_mascotas_raw = '' -%}
{%- for v in product.variants -%}
  {%- unless vlh_tamanos_raw contains v.option1 -%}
    {%- assign vlh_tamanos_raw = vlh_tamanos_raw | append: v.option1 | append: '||' -%}
  {%- endunless -%}
  {%- if v.option2 -%}
    {%- unless vlh_mascotas_raw contains v.option2 -%}
      {%- assign vlh_mascotas_raw = vlh_mascotas_raw | append: v.option2 | append: '||' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign vlh_tamanos = vlh_tamanos_raw | split: '||' -%}
{%- assign vlh_mascotas_valores = vlh_mascotas_raw | split: '||' -%}

<div class="page-width">
<div class="vlh-lamina-form" id="vlh-lamina-form" data-section-id="{{ section.id }}">

  {%- comment -%} Aviso visible SOLO en el editor de temas si falta algún producto oculto {%- endcomment -%}
  {% if request.design_mode %}
    {% assign missing = '' %}
    {% unless p_pack_regalo %}{% assign missing = missing | append: h_pack_regalo | append: ', ' %}{% endunless %}
    {% unless p_pack_valentina %}{% assign missing = missing | append: h_pack_valentina | append: ', ' %}{% endunless %}
    {% unless p_marco_a4 %}{% assign missing = missing | append: h_marco_a4 | append: ', ' %}{% endunless %}
    {% unless p_marco_a3 %}{% assign missing = missing | append: h_marco_a3 | append: ', ' %}{% endunless %}
    {% unless p_composicion %}{% assign missing = missing | append: h_composicion | append: ', ' %}{% endunless %}
    {% if missing != '' %}
      <div class="vlh-admin-warning">
        ⚠️ Faltan por crear estos productos ocultos (handle): {{ missing }}
        Revisa INSTRUCCIONES-configuracion.md
      </div>
    {% endif %}
  {% endif %}

  <form id="vlh-form" novalidate>

    <!-- ============ 1. TAMAÑO ============ -->
    <fieldset class="vlh-field">
      <legend>Tamaño</legend>
      {%- comment -%} Los tamaños cuyo nombre contiene "Lienzo" se muestran aparte, como Lienzo XL {%- endcomment -%}
      {%- assign vlh_hay_lienzo = false -%}
      {%- assign vlh_lienzo_max = '' -%}
      {%- for t in vlh_tamanos -%}{%- if t contains 'Lienzo' -%}{%- assign vlh_hay_lienzo = true -%}{%- assign vlh_lienzo_max = t -%}{%- endif -%}{%- endfor -%}
      {%- if vlh_hay_lienzo -%}
      <button type="button" class="vlh-guide-link vlh-guide-link--all" data-size-guide-open>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="7" width="20" height="10" rx="1.5"/><path d="M6 7v4M10 7v3M14 7v4M18 7v3"/></svg>
        Ver todos los tamaños a escala <span>(láminas y lienzos)</span>
      </button>
      <dialog class="vlh-guide-dialog" data-size-guide aria-label="Guía de tamaños">
        <button type="button" class="vlh-guide-dialog__close" data-size-guide-close aria-label="Cerrar">&times;</button>
        <p class="vlh-guide-dialog__title">¿Qué tamaño elijo?</p>
        {% render 'size-guide', art: guide_art, art_a3: guide_art_a3 %}
      </dialog>
      <div class="vlh-canvas">
        <div class="vlh-canvas__head">
          {%- if lamina_image != blank -%}
            <button type="button" class="vlh-canvas__thumb" data-lightbox-images='{{ lamina_image | image_url: width: 1400 | json | prepend: '[' | append: ']' | escape }}' data-lightbox-title="Así es una lámina" aria-label="Ver cómo queda una lámina">
              {{ lamina_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 64, height: 80, alt: 'Ejemplo de lámina' }}
              <span class="vlh-canvas__zoom" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.8-4.8M10.5 7.5v6M7.5 10.5h6"/></svg></span>
            </button>
          {%- endif -%}
          <div>
            <p class="vlh-size-group__title">Lámina</p>
            <p class="vlh-canvas__text">Papel de algodón verjurado 300 g · marco y pack regalo opcionales</p>
          </div>
        </div>
      {%- endif -%}
      <div class="vlh-radio-cards" id="vlh-tamano-group">
        {% for tamano_valor in vlh_tamanos %}
          {% if tamano_valor contains 'Lienzo' %}{% continue %}{% endif %}
          {% assign vlh_medida = '' %}
          {% if tamano_valor contains 'A4' %}
            {% assign vlh_medida = '21 × 29,7 cm' %}
          {% elsif tamano_valor contains 'A3' %}
            {% assign vlh_medida = '29,7 × 42 cm' %}
          {% endif %}
          <label class="vlh-radio-card">
            <input
              type="radio"
              name="vlh-tamano"
              value="{{ tamano_valor | escape }}"
              {% if tamano_valor contains 'A3' %}checked{% elsif forloop.first and vlh_tamanos.size == 1 %}checked{% endif %}
              required
            >
            <span class="vlh-radio-card__title">{{ tamano_valor }}</span>
            {% if vlh_medida != '' %}
              <span class="vlh-radio-card__medida">{{ vlh_medida }}</span>
            {% endif %}
            <span class="vlh-radio-card__price" data-tamano-precio>—</span>
            {% if tamano_valor contains 'A3' and vlh_hay_lienzo == false %}
              <span class="vlh-radio-card__ribbon">★ Recomendado</span>
            {% endif %}
          </label>
        {% endfor %}
      </div>
      {%- if vlh_hay_lienzo -%}</div>{%- endif -%}
      {%- if vlh_hay_lienzo -%}
        <div class="vlh-canvas">
          <div class="vlh-canvas__head">
            {%- if canvas_image != blank -%}
              {%- capture canvas_imgs -%}[{{ canvas_image | image_url: width: 1400 | json }}{%- if canvas_detail != blank -%},{{ canvas_detail | image_url: width: 1400 | json }}{%- endif -%}]{%- endcapture -%}
              <button type="button" class="vlh-canvas__thumb" data-lightbox-images='{{ canvas_imgs | escape }}' data-lightbox-title="Así es un lienzo" aria-label="Ver cómo queda un lienzo">
                {{ canvas_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 64, height: 80, alt: 'Ejemplo de lienzo' }}
                <span class="vlh-canvas__zoom" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.8-4.8M10.5 7.5v6M7.5 10.5h6"/></svg></span>
              </button>
            {%- endif -%}
            <div>
              <p class="vlh-size-group__title">Lienzo XL <span class="vlh-canvas__new">Nuevo</span></p>
              <p class="vlh-canvas__text">{{ canvas_text | default: 'Listo para colgar · bastidor de madera · tela 100 % algodón' }}</p>
            </div>
          </div>
          <div class="vlh-radio-cards vlh-radio-cards--canvas">
            {% for tamano_valor in vlh_tamanos %}
              {% unless tamano_valor contains 'Lienzo' %}{% continue %}{% endunless %}
              <label class="vlh-radio-card">
                <input type="radio" name="vlh-tamano" value="{{ tamano_valor | escape }}" data-lienzo required>
                {%- if tamano_valor == vlh_lienzo_max -%}<span class="vlh-radio-card__ribbon">★ Recomendado</span>{%- endif -%}
                <span class="vlh-radio-card__title">{{ tamano_valor | remove: 'Lienzo' | remove: 'cm' | replace: 'x', ' × ' | strip }} cm</span>
                <span class="vlh-radio-card__medida">Lienzo</span>
                <span class="vlh-radio-card__price" data-tamano-precio>—</span>
              </label>
            {% endfor %}
          </div>
        </div>
      {%- endif -%}
      <p class="vlh-hint" id="vlh-tamano-valentina-nota" hidden>El Pack Valentina se presenta siempre en A3 con marco. Si quieres otro tamaño o un lienzo, primero desmarca el Pack Valentina más abajo.</p>
    </fieldset>

    <!-- ============ 2. SEGUNDA VARIANTE (solo si el producto la tiene) ============ -->
    {% if product.options.size > 1 %}
    <fieldset class="vlh-field">
      <legend>{{ product.options[1] }}</legend>
      <div class="vlh-radio-list" id="vlh-mascotas-group">
        {% for mascotas_valor in vlh_mascotas_valores %}
          <label class="vlh-radio-row">
            <input
              type="radio"
              name="vlh-mascotas"
              value="{{ mascotas_valor | escape }}"
              {% if forloop.first %}checked{% endif %}
              required
            >
            {{ mascotas_valor }}
            <span class="vlh-radio-row__price" data-mascotas-precio>{% if forloop.first %}sin coste extra{% endif %}</span>
          </label>
        {% endfor %}
      </div>
    </fieldset>
    {% endif %}

    <!-- ============ 6. FOTOGRAFÍA ============ -->
    <fieldset class="vlh-field" id="vlh-upload-field">
      <legend id="vlh-upload-label">Tus fotos</legend>
      <input type="file" id="vlh-upload-input" name="properties[Foto 1]" accept="image/*" required multiple>
      <p class="vlh-hint" id="vlh-upload-hint">JPG o PNG, máx. 20MB por foto. Puedes subir más de una si quieres darnos más referencia.</p>

      {% if p_composicion %}
      <label class="vlh-checkbox vlh-checkbox--frase vlh-composicion">
        <input type="checkbox" name="vlh-composicion" value="si"
          data-variant-id="{{ p_composicion.selected_or_first_available_variant.id }}"
          data-price-cents="{{ p_composicion.selected_or_first_available_variant.price }}">
        <span>Quiero juntar personas o elementos de fotos distintas <span class="vlh-composicion__price" data-composicion-precio></span></span>
      </label>
      <details class="vlh-details vlh-details--mini">
        <summary>¿Cuándo marcarlo?</summary>
        <p class="vlh-hint">Solo si queréis aparecer juntos pero estáis en fotos distintas (por ejemplo, no tenéis ninguna foto todos juntos). Si solo nos mandas varias fotos como referencia, no hace falta: elegimos la que mejor funcione.</p>
      </details>
      {% endif %}

      <label class="vlh-checkbox" style="margin-top:14px;">
        <input type="checkbox" id="vlh-sin-foto-toggle">
        La enviaré después
      </label>
      <details class="vlh-details" id="vlh-sin-foto-details" hidden>
        <summary>¿Cómo la envío después?</summary>
        <p class="vlh-hint" style="margin-top:0;">Podrás enviárnosla después de realizar el pedido, por WhatsApp o email, indicando tu número de pedido.</p>
      </details>
    </fieldset>

    <!-- ============ EXTRAS (opcionales) ============ -->
    <div class="vlh-extras-head">
      <p class="vlh-extras-title">Personaliza tu pedido</p>
      <p class="vlh-extras-sub">Opcional · regalo, marco y detalles de tu ilustración</p>
    </div>

    {%- if vlh_hay_lienzo -%}
    <p class="vlh-lamina-only" data-canvas-note hidden>🎁 🖼️ Pack regalo y marco disponibles para <strong>láminas A4 y A3</strong>. Tu lienzo llega listo para colgar.</p>
    {%- endif -%}
    <div data-lamina-extras>

    <!-- ============ 3. ¿ES PARA REGALO? ============ -->
    <details class="vlh-field vlh-accordion">
      <summary>
        <span class="vlh-accordion__title">Lo quiero para regalar 🎁</span>
        <span class="vlh-accordion__value vlh-accordion__value--empty" id="vlh-pack-summary">+</span>
      </summary>
      <div class="vlh-accordion__body">
      <div class="vlh-radio-cards vlh-radio-cards--packs" id="vlh-pack-group">
        <label class="vlh-radio-card vlh-radio-card--pack">
          <input type="radio" name="vlh-pack" value="no" checked>
          <span class="vlh-radio-card__title">No, gracias</span>
        </label>
        {% if p_pack_regalo %}
        <label class="vlh-radio-card vlh-radio-card--pack">
          <input type="radio" name="vlh-pack" value="regalo"
            data-variant-id="{{ p_pack_regalo.selected_or_first_available_variant.id }}"
            data-price-cents="{{ p_pack_regalo.selected_or_first_available_variant.price }}">
          {% if p_pack_regalo.featured_image %}
            <img class="vlh-radio-card__img vlh-radio-card__img--pack" src="{{ p_pack_regalo.featured_image | image_url: width: 600 }}" alt="Pack regalo" loading="lazy" width="300" height="225">
            {%- if p_pack_regalo.images.size > 0 -%}
              {%- capture pack_imgs -%}[{%- for im in p_pack_regalo.images -%}{{ im | image_url: width: 1400 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
              <button type="button" class="vlh-pack-photos" data-lightbox-images='{{ pack_imgs | escape }}' data-lightbox-title="Pack regalo">Ver fotos ({{ p_pack_regalo.images.size }})</button>
            {%- endif -%}
          {% endif %}
          <span class="vlh-radio-card__title">Pack Regalo</span>
          <span class="vlh-radio-card__price">+ {{ p_pack_regalo.selected_or_first_available_variant.price | money }}</span>
        </label>
        {% endif %}
        {% if p_pack_valentina %}
        <label class="vlh-radio-card vlh-radio-card--pack" id="vlh-pack-valentina-card">
          <input type="radio" name="vlh-pack" value="valentina" id="vlh-pack-valentina-input"
            data-variant-id="{{ p_pack_valentina.selected_or_first_available_variant.id }}"
            data-price-cents="{{ p_pack_valentina.selected_or_first_available_variant.price }}">
          {% if p_pack_valentina.featured_image %}
            <img class="vlh-radio-card__img vlh-radio-card__img--pack" src="{{ p_pack_valentina.featured_image | image_url: width: 600 }}" alt="Pack Valentina" loading="lazy" width="300" height="225">
            {%- if p_pack_valentina.images.size > 0 -%}
              {%- capture pack_imgs -%}[{%- for im in p_pack_valentina.images -%}{{ im | image_url: width: 1400 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
              <button type="button" class="vlh-pack-photos" data-lightbox-images='{{ pack_imgs | escape }}' data-lightbox-title="Pack Valentina">Ver fotos ({{ p_pack_valentina.images.size }})</button>
            {%- endif -%}
          {% endif %}
          <span class="vlh-radio-card__title">Pack Valentina</span>
          <span class="vlh-radio-card__price">+ {{ p_pack_valentina.selected_or_first_available_variant.price | money }}</span>
          <span class="vlh-radio-card__badge" id="vlh-pack-valentina-badge">Se presenta enmarcado en A3</span>
        </label>
        {% endif %}
      </div>

      <p class="vlh-hint" id="vlh-pack-regalo-desc" hidden>Presentación especial lista para regalar.</p>
      <p class="vlh-hint" id="vlh-pack-valentina-desc" hidden>Nuestra presentación más especial, con flores y detalles hechos a mano.</p>

      {% if p_pack_regalo %}
      <details class="vlh-details" id="vlh-pack-regalo-details" hidden>
        <summary>Ver qué incluye el Pack Regalo</summary>
        <div class="vlh-pack-desc__body">{{ p_pack_regalo.description }}</div>
      </details>
      {% endif %}
      {% if p_pack_valentina %}
      <details class="vlh-details" id="vlh-pack-valentina-details" hidden>
        <summary>Ver qué incluye el Pack Valentina</summary>
        <div class="vlh-pack-desc__body">{{ p_pack_valentina.description }}</div>
      </details>
      {% endif %}

      <p class="vlh-hint" id="vlh-tamano-valentina-nota-pack" hidden>Este pack se presenta siempre en A3 y enmarcado — hemos ajustado el tamaño automáticamente.</p>

      <div class="vlh-subpanel" id="vlh-pack-mensaje-panel" hidden>
        <p class="vlh-hint" style="margin-top:0;">Mensaje personalizado para el interior de la tapa (máx. 10 palabras)</p>
        <input type="text" id="vlh-mensaje-pack" maxlength="80" placeholder="Ej: Con todo mi cariño para ti">
        <p class="vlh-hint" id="vlh-mensaje-pack-contador" style="text-align:right;margin-top:4px;">0 / 10 palabras</p>
      </div>
      </div>
    </details>

    <!-- ============ 4. MARCO ============ -->
    <details class="vlh-field vlh-accordion" id="vlh-marco-field">
      <summary>
        <span class="vlh-accordion__title">Lo quiero enmarcado 🖼️</span>
        <span class="vlh-accordion__value vlh-accordion__value--empty" id="vlh-marco-summary">+</span>
      </summary>
      <div class="vlh-accordion__body">
        <p class="vlh-hint" id="vlh-marco-obligatorio-nota" style="margin-top:0;" hidden>El Pack Valentina se presenta siempre enmarcado — elige el acabado que completará tu pedido.</p>
        <div class="vlh-radio-cards" id="vlh-marco-color-group"></div>
        <details class="vlh-details">
          <summary>¿Cómo se envía tu pedido?</summary>
          <p class="vlh-hint" style="margin-top:0;" id="vlh-envio-nota">Si tu pedido no incluye marco ni ningún pack, se envía en sobre rígido. Si incluye marco o algún pack, se envía en caja kraft.</p>
        </details>
      </div>
    </details>

    </div>

    <!-- ============ 7. NOTAS PARA EL DISEÑADOR (plegado) ============ -->
    <details class="vlh-field vlh-accordion vlh-notes">
      <summary>
        <span class="vlh-accordion__title">Añadir detalles para tu ilustración ✍️</span>
        <span class="vlh-accordion__value vlh-accordion__value--empty">+</span>
      </summary>
      <div class="vlh-accordion__body">
        <p class="vlh-hint" style="margin-top:0;">Nombres, una fecha, una frase, el fondo o los colores que prefieras… <span class="vlh-opcional">(opcional)</span></p>
        <textarea id="vlh-descripcion" rows="3" placeholder="Ej: Quiero añadir el texto 'Marta &amp; Pablo · 12.06.2026'. Quiero que el fondo sea sencillo, en tonos verdes, con alguna flor."></textarea>
        <p class="vlh-hint">No necesitas describirlo todo — trabajaremos con cariño tomando como referencia las fotografías que nos envíes, cuidando cada detalle para que la lámina quede elegante y preciosa. Los aspectos que no nos indiques quedarán a criterio de nuestro equipo de diseño, que siempre busca el resultado más armonioso.</p>
      </div>
    </details>

    <!-- ============ 8. ENTREGA Y REVISIÓN (resumido) ============ -->
    <ul class="vlh-perks">
      <li><span aria-hidden="true">📦</span><span>Entrega estimada <strong id="vlh-fecha-estimada"></strong> · <a href="https://wa.me/34604524295?text=Hola%21+Quiero+consultar+disponibilidad+para+una+fecha+concreta" target="_blank" rel="noopener">¿Lo necesitas antes?</a></span></li>
      <li><span aria-hidden="true">✓</span><span>Te enseñamos el diseño antes de prepararlo · hasta 3 ajustes incluidos</span></li>
    </ul>

    <!-- ============ RESUMEN DE PRECIO ============ -->
    <div class="vlh-summary">
      <div class="vlh-summary__row vlh-summary__row--total">
        <span class="vlh-summary__label">Total</span>
        <span><span class="vlh-summary__old" id="vlh-total-old" hidden></span><span class="vlh-summary__value" id="vlh-total-price">—</span></span>
      </div>
      <ul class="vlh-summary__breakdown" id="vlh-breakdown"></ul>
      <p class="vlh-summary__envio">Envío calculado al pagar</p>
    </div>

    <!-- ============ CÓDIGO DE DESCUENTO ============ -->
    {%- liquid
      assign vlh_w_code = settings.welcome_code | strip | upcase
      assign vlh_w_ok = true
      if settings.welcome_collection != blank
        assign vlh_col_handles = product.collections | map: 'handle'
        unless vlh_col_handles contains settings.welcome_collection.handle
          assign vlh_w_ok = false
        endunless
      endif
    -%}
    <div class="vlh-coupon" id="vlh-coupon"
      data-welcome-code="{% if vlh_w_ok %}{{ vlh_w_code | escape }}{% endif %}"
      data-welcome-percent="{{ settings.welcome_percent | default: 10 }}">
      <details class="vlh-coupon__box" id="vlh-coupon-box">
        <summary>🏷️ ¿Tienes un código de descuento?</summary>
        <div class="vlh-coupon__row">
          <input type="text" id="vlh-coupon-input" placeholder="Escribe tu código" autocomplete="off" autocapitalize="characters" spellcheck="false">
          <button type="button" id="vlh-coupon-apply">Aplicar</button>
        </div>
        <p class="vlh-coupon__msg" id="vlh-coupon-msg" hidden></p>
      </details>
      <div class="vlh-coupon__win" id="vlh-coupon-win" hidden>
        <span class="vlh-coupon__shine" aria-hidden="true"></span>
        <p class="vlh-coupon__kicker">🎉 ¡Mejor oferta desbloqueada!</p>
