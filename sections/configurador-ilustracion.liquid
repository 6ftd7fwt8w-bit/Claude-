<script>
(function () {
  const root = document.querySelector('[data-cfg]');
  if (!root) return;
  const data = JSON.parse(root.querySelector('[data-cfg-data]').textContent);
  const $ = (s, el) => (el || root).querySelector(s);
  const $$ = (s, el) => [...(el || root).querySelectorAll(s)];
  const fmt = (c) => (c / 100).toLocaleString(data.locale || 'es', { style: 'currency', currency: 'EUR' });
  const form = $('[data-cfg-form]');
  const SIZES = { lamina: ['A4', 'A3'], marco: ['A4', 'A3'], regalo: ['A4', 'A3'], lienzo: ['Lienzo 70x100', 'Lienzo 80x120'] };
  const SIZE_INFO = { 'A4': ['A4', '21 × 29,7 cm'], 'A3': ['A3', '29,7 × 42 cm'], 'Lienzo 70x100': ['70 × 100', 'cm'], 'Lienzo 80x120': ['80 × 120', 'cm'] };
  const st = { type: 0, count: null, finish: 'lamina', size: 'A4', color: 'marco blanco', pack: 'Pack Regalo' };

  // ---- Producto y variante ----
  // Número «genérico» (1, 2, 3-4, 5-6, 7-8, 9+, paisaje) → valor de la opción del producto
  const P = { '1': '1 persona', '2': '2 personas', '3-4': '3-4 personas', '5-6': '5-6 personas', '7-8': '7-8 personas', '9+': '9 o más personas' };
  const M = { '1': '1 mascota', '2': '2 mascotas', '3-4': '3-4 mascotas', '5-6': '5 o más mascotas' };
  const countIdx = (t) => t.options.findIndex((o) => /^número/i.test(o));
  const sizeIdx = (t) => t.options.findIndex((o) => /tamaño/i.test(o));
  const presIdx = (t) => t.options.findIndex((o) => /presentaci/i.test(o));
  const countVal = (t, key) => { const ci = countIdx(t); return /mascota/i.test(t.options[ci] || '') ? M[key] : P[key]; };
  const supports = (t, key) => {
    if (!t || !t.variants.length || !key) return false;
    const ci = countIdx(t);
    if (ci > -1) { const val = countVal(t, key); return !!val && t.variants.some((v) => v.o[ci] === val); }
    return (t.fixed || '') === key;
  };
  const productFor = (key) => {
    const cur = data.types[st.type];
    if (supports(cur, key)) return cur;
    return data.types.find((t) => t.generic && supports(t, key)) || data.types.find((t) => supports(t, key)) || null;
  };
  const presFor = (finish, color, pack) => finish === 'lienzo' ? 'Lienzo en bastidor'
    : finish === 'regalo' ? pack + ' · ' + color : finish === 'marco' ? 'Enmarcada · ' + color : 'Solo lámina';
  const findVariant = (t, key, size, pres) => {
    if (!t || !size) return null;
    const ci = countIdx(t), si = sizeIdx(t), pi = presIdx(t);
    const cv = ci > -1 ? countVal(t, key) : null;
    return t.variants.find((v) => (ci < 0 || v.o[ci] === cv) && String(v.o[si]).indexOf(size) === 0 && v.o[pi] === pres) || null;
  };

  // ---- Galería ----
  const mainImg = $('[data-cfg-main]');
  const thumbs = $('[data-cfg-thumbs]');
  let imgs = [], cur = 0;
  const show = (i) => {
    if (!imgs.length) return;
    cur = (i + imgs.length) % imgs.length;
    mainImg.removeAttribute('srcset'); mainImg.removeAttribute('sizes');
    mainImg.src = imgs[cur].src; mainImg.alt = imgs[cur].alt || '';
    $$('.cfg__thumb', thumbs).forEach((b, k) => b.classList.toggle('is-active', k === cur));
    const a = thumbs.children[cur]; if (a) thumbs.scrollTo({ left: a.offsetLeft - thumbs.clientWidth / 2 + a.clientWidth / 2, behavior: 'smooth' });
  };
  const paintGallery = () => {
    imgs = data.types[st.type].images || [];
    thumbs.innerHTML = imgs.map((im, k) => `<button type="button" class="cfg__thumb" data-i="${k}" aria-label="Foto ${k + 1}"><img src="${im.thumb}" alt="" loading="lazy" width="68" height="85"></button>`).join('');
    show(0);
  };
  thumbs.addEventListener('click', (e) => { const b = e.target.closest('[data-i]'); if (b) show(+b.dataset.i); });
  let sx = null;
  mainImg.parentElement.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
  mainImg.parentElement.addEventListener('touchend', (e) => { if (sx === null) return; const d = e.changedTouches[0].clientX - sx; if (Math.abs(d) > 40) show(cur + (d < 0 ? 1 : -1)); sx = null; });

  // ---- Pintar todo ----
  let welcomeOn = false;
  const readWelcome = () => { try { const w = JSON.parse(localStorage.getItem('vlh_welcome')) || {}; return w.status === 'accepted' && w.expires > Date.now(); } catch (e) { return false; } };
  const paint = () => {
    welcomeOn = readWelcome();
    const type = data.types[st.type];
    $$('.cfg__type').forEach((b, k) => { b.classList.toggle('is-active', k === st.type); b.setAttribute('aria-selected', k === st.type); });
    // Paso 1: con «Mascota» el último tramo es «5 o más»
    const pets = /mascota/i.test(type.options[countIdx(type)] || '');
    $$('[data-count]').forEach((b) => {
      b.hidden = !productFor(b.dataset.count) || (pets && (b.dataset.count === '7-8' || b.dataset.count === '9+'));
      if (b.dataset.count === '5-6') b.textContent = pets ? '5 o más' : '5-6';
      b.classList.toggle('is-active', b.dataset.count === st.count);
    });
    const t = productFor(st.count);
    // Paso 3: acabado, sus ventajas y tamaños (sin precios: el total de abajo cambia solo)
    const gift = st.finish === 'regalo';
    if (gift && st.pack === 'Pack Valentina') st.size = 'A3';
    if (!SIZES[st.finish].includes(st.size)) st.size = SIZES[st.finish][0];
    $$('[data-finish]').forEach((b) => {
      const f = b.dataset.finish;
      b.disabled = !findVariant(t, st.count, f === 'lienzo' ? SIZES[f][0] : 'A3', presFor(f, 'marco blanco', 'Pack Regalo'));
      b.classList.toggle('is-active', f === st.finish);
    });
    $$('[data-feats]').forEach((u) => { u.hidden = u.dataset.feats !== st.finish; });
    $('[data-cfg-sub="pack"]').hidden = !gift;
    $$('[data-pack]').forEach((b) => {
      b.hidden = !findVariant(t, st.count, 'A3', presFor('regalo', st.color, b.dataset.pack));
      b.classList.toggle('is-active', b.dataset.pack === st.pack);
      b.setAttribute('aria-pressed', b.dataset.pack === st.pack);
    });
    $('[data-cfg-sizes]').innerHTML = SIZES[st.finish].map((sz) => {
      // Con Pack Valentina (solo A3) el A4 sigue visible: al tocarlo pasa a Pack Regalo
      const ok = findVariant(t, st.count, sz, presFor(st.finish, st.color, gift && sz === 'A4' ? 'Pack Regalo' : st.pack));
      const info = SIZE_INFO[sz];
      return ok ? `<button type="button" class="cfg__tile cfg__tile--size${sz === st.size ? ' is-active' : ''}" data-size="${sz}"><strong>${info[0]}</strong><small>${info[1]}</small></button>` : '';
    }).join('');
    $('[data-cfg-sub="color"]').hidden = !(st.finish === 'marco' || gift);
    $$('[data-color]').forEach((b) => b.classList.toggle('is-active', b.dataset.color === st.color));
    $('[data-cfg-sub="message"]').hidden = !gift;
    // Total: precio de antes (compare at) tachado, % de descuento y bienvenida si está activa
    const v = findVariant(t, st.count, st.size, presFor(st.finish, st.color, st.pack));
    const totalEl = $('#vlh-total-price'), oldEl = $('#vlh-total-old'), offEl = $('[data-cfg-off]');
    const now = v ? (welcomeOn ? Math.round(v.price * 0.9) : v.price) : 0;
    const before = v ? Math.max(v.cmp || 0, v.price) : 0;
    totalEl.textContent = v ? fmt(now) : '—';
    const pct = before > now ? Math.round((1 - now / before) * 100) : 0;
    oldEl.hidden = !pct; oldEl.textContent = pct ? fmt(before) : '';
    offEl.hidden = !pct; offEl.textContent = pct ? '−' + pct + ' %' : '';
    totalEl.closest('.cfg__total').classList.toggle('has-discount', !!pct);
    $('#vlh-perk').hidden = !welcomeOn;
    // Barra superior
    const fin = { lamina: 'Lámina', marco: 'Lámina con marco', lienzo: 'Lienzo', regalo: st.pack }[st.finish];
    bar.querySelector('[data-bar-what]').textContent = fin + ' · ' + (SIZE_INFO[st.size] || [st.size])[0] + (st.finish === 'lienzo' ? ' cm' : '');
    bar.querySelector('[data-bar-price]').textContent = v ? fmt(now) : '—';
    bar.querySelector('[data-bar-old]').hidden = !pct; bar.querySelector('[data-bar-old]').textContent = pct ? fmt(before) : '';
    bar.querySelector('[data-bar-off]').hidden = !pct; bar.querySelector('[data-bar-off]').textContent = pct ? '−' + pct + ' %' : '';
    const bi = bar.querySelector('[data-bar-img]'); if (imgs[0]) bi.src = imgs[0].thumb;
    root._variant = v; root._product = t;
  };

  // ---- Eventos ----
  const openDlg = (d) => { if (!d) return; if (d.showModal) d.showModal(); else d.setAttribute('open', ''); };
  const closeDlg = (d) => { if (!d) return; if (d.close) d.close(); else d.removeAttribute('open'); };
  root.addEventListener('click', (e) => {
    const b = e.target.closest('button, [data-pack]'); if (!b || !root.contains(b)) return;
    const dlg = b.closest('dialog');
    if (b.dataset.packMore) { e.stopPropagation(); openDlg($(`[data-pack-dialog="${b.dataset.packMore}"]`)); return; }
    if ('dlgClose' in b.dataset || 'guideClose' in b.dataset) { closeDlg(dlg); return; }
    if (b.dataset.dlgSrc) { const m = $('[data-dlg-main]', dlg); if (m) { m.removeAttribute('srcset'); m.src = b.dataset.dlgSrc; } $$('.cfg__thumb', dlg).forEach((x) => x.classList.toggle('is-active', x === b)); return; }
    if (b.dataset.dlgChoose) { st.finish = 'regalo'; st.pack = b.dataset.dlgChoose; closeDlg(dlg); paint(); return; }
    if (b.dataset.type) { st.type = +b.dataset.type; const t = data.types[st.type]; const def = t.default || t.fixed; if (def && productFor(def)) st.count = def; paintGallery(); paint(); }
    else if (b.dataset.count) {
      st.count = b.dataset.count;
      // Si el tipo elegido no tiene ese número, pasamos al tipo que sí (p. ej. Pareja → Familia con 3-4)
      if (!supports(data.types[st.type], st.count)) { const k = data.types.indexOf(productFor(st.count)); if (k > -1) { st.type = k; paintGallery(); } }
      paint();
    }
    else if (b.dataset.finish) { if (b.disabled) return; st.finish = b.dataset.finish; paint(); }
    else if (b.dataset.size) { st.size = b.dataset.size; if (st.pack === 'Pack Valentina' && st.size === 'A4') st.pack = 'Pack Regalo'; paint(); }
    else if (b.dataset.pack) { st.pack = b.dataset.pack; paint(); }
    else if (b.dataset.color) { st.color = b.dataset.color; paint(); }
    else if ('guideOpen' in b.dataset) openDlg($('[data-guide]'));
  });
  root.addEventListener('keydown', (e) => { const c = e.target.closest && e.target.closest('[data-pack]'); if (c && e.target === c && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); c.click(); } });
  $$('dialog', root).forEach((d) => d.addEventListener('click', (e) => { if (e.target === d) closeDlg(d); }));

  // Barra superior: aparece al pasar los botones de tipo
  const bar = $('[data-cfg-bar]'), head = $('.cfg__head');
  document.body.appendChild(bar);
  const sumEl = $('.cfg__summary');
  // Sale al bajar (pasados los botones de tipo) y solo mientras el total de abajo no se ve
  const barUpd = () => {
    const r = sumEl.getBoundingClientRect(), sumVisible = r.top < window.innerHeight && r.bottom > 0;
    const on = window.scrollY > 0 && head.getBoundingClientRect().bottom < 0 && !sumVisible && !document.body.classList.contains('has-vlh-offer'); bar.classList.toggle('is-on', on); bar.setAttribute('aria-hidden', !on); bar.querySelector('button').tabIndex = on ? 0 : -1;
  };
  window.addEventListener('scroll', barUpd, { passive: true }); window.addEventListener('resize', barUpd); barUpd();
  bar.querySelector('[data-bar-add]').addEventListener('click', () => form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', { cancelable: true })));

  // Fotos
  const files = $('[data-cfg-files]'), later = $('[data-cfg-later]'), drop = $('[data-cfg-drop]');
  files.addEventListener('change', () => {
    const n = files.files.length;
    drop.classList.toggle('has-files', n > 0);
    $('[data-cfg-drop-title]').textContent = n ? (n === 1 ? '1 foto lista ✓' : n + ' fotos listas ✓') : 'Sube tus fotos';
  });
  later.addEventListener('change', () => { drop.hidden = later.checked; $('[data-cfg-date-note]').hidden = !later.checked; });

  // Fecha estimada (10-15 días)
  (() => {
    const d1 = new Date(), d2 = new Date(); d1.setDate(d1.getDate() + 10); d2.setDate(d2.getDate() + 15);
    const m = (d) => d.toLocaleDateString('es-ES', { month: 'long' });
    const el = $('[data-cfg-date]');
    el.textContent = d1.getMonth() === d2.getMonth() ? `del ${d1.getDate()} al ${d2.getDate()} de ${m(d2)}` : `del ${d1.getDate()} de ${m(d1)} al ${d2.getDate()} de ${m(d2)}`;
    const f = (d) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
    el.dataset.rango = f(d1) + ' - ' + f(d2);
  })();

  // Aviso de bienvenida al llegar al total
  const offer = document.getElementById('vlh-offer');
  if (offer) {
    document.body.appendChild(offer);
    const canOffer = () => window.vivaWelcome ? window.vivaWelcome.canOffer() : !readWelcome();
    const hide = () => { offer.classList.remove('is-open'); document.body.classList.remove('has-vlh-offer'); setTimeout(() => { offer.hidden = true; }, 350); };
    offer.querySelectorAll('[data-offer-no]').forEach((b) => b.addEventListener('click', () => { try { sessionStorage.setItem('vlh_welcome_no', '1'); } catch (e) {} hide(); }));
    offer.querySelector('[data-offer-yes]').addEventListener('click', (e) => {
      e.currentTarget.disabled = true;
      if (window.vivaWelcome) window.vivaWelcome.activate(offer.dataset.code);
      paint();
      offer.querySelector('.vlh-offer__ask').hidden = true; offer.querySelector('.vlh-offer__done').hidden = false;
      setTimeout(hide, 2600);
    });
    let shown = false;
    const open = () => {
      if (shown || readWelcome() || !canOffer()) return; shown = true;
      const go = () => {
        const ck = document.getElementById('shopify-pc__banner'), cs = ck && getComputedStyle(ck);
        if (ck && cs.display !== 'none' && cs.visibility !== 'hidden' && ck.getBoundingClientRect().height > 0) { setTimeout(go, 1000); return; }
        offer.hidden = false; document.body.classList.add('has-vlh-offer');
        requestAnimationFrame(() => requestAnimationFrame(() => offer.classList.add('is-open')));
      };
      setTimeout(go, 700);
    };
    if ('IntersectionObserver' in window) new IntersectionObserver((en, o) => { if (en.some((x) => x.isIntersecting)) { o.disconnect(); open(); } }, { threshold: 0.6 }).observe($('.cfg__summary'));
  }

  // Añadir al carrito: UNA línea con la variante elegida
  const err = $('[data-cfg-error]'), btn = $('[data-cfg-submit]');
  const fail = (m) => { err.textContent = m; err.hidden = false; err.scrollIntoView({ behavior: 'smooth', block: 'center' }); };
  form.addEventListener('submit', async (e) => {
    e.preventDefault(); err.hidden = true;
    const v = root._variant;
    if (!st.count) return fail('Elige cuántos salen en tu ilustración (paso 1).');
    if (!later.checked && !files.files.length) return fail('Sube al menos una foto, o marca «Enviaré la foto más tarde» (paso 2).');
    if (!v) return fail('Esta combinación no está disponible. Prueba otro tamaño o acabado.');
    btn.disabled = true; btn.textContent = 'Añadiendo…';
    try {
      const fd = new FormData();
      fd.append('id', v.id); fd.append('quantity', 1);
      fd.append('properties[Tipo de ilustración]', data.types[st.type].label);
      fd.append('properties[¿Tiene la foto?]', later.checked ? 'La enviará más adelante' : 'Sí, adjunta');
      if (!later.checked) [...files.files].forEach((f, i) => fd.append('properties[Foto ' + (i + 1) + ']', f));
      const notes = $('[data-cfg-notes]').value.trim(); if (notes) fd.append('properties[Cómo quiere su ilustración]', notes);
      const msg = $('[data-cfg-message]').value.trim(); if (st.finish === 'regalo' && msg) fd.append('properties[Mensaje del regalo]', msg);
      fd.append('properties[Fecha de entrega estimada]', $('[data-cfg-date]').dataset.rango || '');
      const r = await fetch('/cart/add.js', { method: 'POST', body: fd });
      if (!r.ok) { const j = await r.json().catch(() => ({})); throw new Error(j.description || 'No se pudo añadir al carrito.'); }
      if (readWelcome() && window.vivaAddDiscountCode && offer) { try { await window.vivaAddDiscountCode(offer.dataset.code); } catch (e2) {} }
      if (window.vivaCartAdded) { window.vivaCartAdded(); } else { window.location.href = '/cart'; }
    } catch (ex) { fail(ex.message || 'Ha ocurrido un error. Inténtalo de nuevo.'); }
    btn.disabled = false; btn.textContent = 'Añadir al carrito';
  });

  // Inicio: tipo desde ?tipo=pareja si viene en el enlace
  try {
    const q = (new URLSearchParams(location.search).get('tipo') || '').toLowerCase();
    if (q) { const k = data.types.findIndex((t) => t.label.toLowerCase().indexOf(q) === 0); if (k > -1) st.type = k; }
  } catch (e) {}
  const t0 = data.types[st.type]; st.count = t0 ? (t0.default || t0.fixed || null) : null;
  paintGallery(); paint();
})();
</script>

{% schema %}
{
  "name": "Configurador",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Configura tu ilustración" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Creamos la ilustración perfecta a partir de tu foto para rememorar ese momento especial" },
    { "type": "text", "id": "steps_title", "label": "Título de los pasos", "default": "Reserva tu ilustración en solo 3 pasos" },
    { "type": "image_picker", "id": "img_lamina", "label": "Foto: lámina sola" },
    { "type": "image_picker", "id": "img_marco", "label": "Foto: lámina enmarcada", "info": "Si está vacío usa la foto del producto Marco A3" },
    { "type": "image_picker", "id": "img_lienzo", "label": "Foto: lienzo" },
    { "type": "image_picker", "id": "img_regalo", "label": "Foto: pack regalo", "info": "Si está vacío usa la foto del Pack Regalo" },
    { "type": "header", "content": "Cómo funciona" },
    { "type": "text", "id": "how_title", "label": "Título", "default": "Cómo funciona" },
    { "type": "text", "id": "step_1_title", "label": "Paso 1", "default": "Configura y sube tu foto" },
    { "type": "text", "id": "step_1_text", "label": "Paso 1: texto", "default": "O envíanosla después" },
    { "type": "text", "id": "step_2_title", "label": "Paso 2", "default": "Diseñamos tu ilustración" },
    { "type": "text", "id": "step_2_text", "label": "Paso 2: texto", "default": "A partir de tus fotos y notas" },
    { "type": "text", "id": "step_3_title", "label": "Paso 3", "default": "La revisamos contigo" },
    { "type": "text", "id": "step_3_text", "label": "Paso 3: texto", "default": "Hasta 3 cambios incluidos" },
    { "type": "text", "id": "step_4_title", "label": "Paso 4", "default": "La recibes en casa" },
    { "type": "text", "id": "step_4_text", "label": "Paso 4: texto", "default": "En 10-15 días, envío gratis" },
    { "type": "richtext", "id": "how_text", "label": "Descripción y cómo trabajamos" },
    { "type": "image_picker", "id": "guide_art", "label": "Comparar tamaños: ilustración de ejemplo", "info": "Solo la ilustración, sin fondo" },
    { "type": "image_picker", "id": "guide_art_a3", "label": "Comparar tamaños: ejemplo lámina A3" }
  ],
  "blocks": [
    {
      "type": "tipo",
      "name": "Tipo de ilustración",
      "settings": [
        { "type": "text", "id": "label", "label": "Botón", "default": "Pareja" },
        { "type": "product", "id": "product", "label": "Producto (con la opción «Presentación»)" },
        { "type": "text", "id": "count_fixed", "label": "Número fijo si el producto no tiene opción de número", "info": "Ej.: 2 · 1 · paisaje" },
        { "type": "text", "id": "count_default", "label": "Número preseleccionado", "info": "Ej.: 3-4 · 1" },
        { "type": "checkbox", "id": "generic", "label": "Genérico", "info": "Se usa cuando el tipo elegido no tiene ese número de personas", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Configurador" }]
}
{% endschema %}
