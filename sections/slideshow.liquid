<section class="slideshow{% if section.settings.mobile_layout == 'stacked' %} slideshow--stack{% endif %}" data-slideshow data-autoplay="false" data-vlh-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}"
  style="--hero-height: {{ section.settings.height }}px; --hero-height-mobile: {{ section.settings.height_mobile }}px; --mobile-h: {{ section.settings.mobile_ratio }};">
  <div class="slideshow__track" data-slideshow-track>
    {%- for block in section.blocks -%}
      <div class="slide{% if block.settings.light_text %} slide--light{% endif %}" {{ block.shopify_attributes }} data-slide
        {% unless forloop.first %}aria-hidden="true"{% endunless %}>
        <div class="slide__media" style="--overlay: {{ block.settings.overlay | divided_by: 100.0 }}">
          {%- if block.settings.image != blank -%}
            {%- assign loading = 'lazy' -%}{%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- endif -%}
            {%- assign focal_style = 'object-position: ' | append: block.settings.focal -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 749px)" sizes="100vw"
                  srcset="{{ block.settings.image_mobile | image_url: width: 600 }} 600w, {{ block.settings.image_mobile | image_url: width: 900 }} 900w, {{ block.settings.image_mobile | image_url: width: 1200 }} 1200w">
              {%- endif -%}
              {%- assign slide_alt = block.settings.image.alt | default: block.settings.heading | strip_html -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag:
                loading: loading, fetchpriority: 'high', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw',
                alt: slide_alt,
                style: focal_style }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- liquid
            assign v_desk = ''
            assign v_desk_h = 0
            assign v_mob = ''
            assign v_mob_h = 0
            if block.settings.video != blank
              for src in block.settings.video.sources
                if src.format == 'mp4' and src.height > v_desk_h
                  assign v_desk = src.url
                  assign v_desk_h = src.height
                endif
              endfor
            endif
            if block.settings.video_mobile != blank
              for src in block.settings.video_mobile.sources
                if src.format == 'mp4' and src.height > v_mob_h
                  assign v_mob = src.url
                  assign v_mob_h = src.height
                endif
              endfor
            endif
            if v_mob == ''
              assign v_mob = v_desk
            endif
            if v_desk == ''
              assign v_desk = v_mob
            endif
          -%}
          {%- if v_desk != '' -%}
            <video class="slide__video" muted loop playsinline preload="{% if forloop.first %}auto{% else %}none{% endif %}"
              {% if forloop.first %}autoplay src="{{ v_mob }}"{% endif %}
              data-desk="{{ v_desk }}" data-mob="{{ v_mob }}" aria-hidden="true"></video>
          {%- endif -%}
        </div>
        <div class="slide__content slide__content--{{ block.settings.align }} slide__content--{{ block.settings.valign }}">
          <div class="slide__box{% if block.settings.panel %} slide__box--panel{% endif %} slide__fade">
            {%- if block.settings.tag != blank -%}<span class="tag-highlight script">{{ block.settings.tag }}</span><br>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 class="slide__heading display">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="slide__text">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button{% if block.settings.light_text %} button--light{% endif %}">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <button type="button" class="slideshow__arrow slideshow__arrow--prev" data-slide-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
    <button type="button" class="slideshow__arrow slideshow__arrow--next" data-slide-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    <div class="slideshow__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="slideshow__dot" data-slide-dot="{{ forloop.index0 }}" aria-label="{{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  .slide__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
</style>
<script>
  (function () {
    function init(show) {
      if (!show || show.dataset.vlhInit) return;
      show.dataset.vlhInit = '1';
      var auto = show.dataset.vlhAutoplay === 'true';
      var speed = (parseInt(show.getAttribute('data-speed'), 10) || 6) * 1000;
      var slides = [].slice.call(show.querySelectorAll('[data-slide]'));
      var next = show.querySelector('[data-slide-next]');
      var mq = window.matchMedia('(max-width: 749px)');
      var timer = null, hover = false;
      var rotating = auto && next && slides.length > 1;
      function srcFor(v) { return mq.matches ? v.dataset.mob : v.dataset.desk; }
      function current() {
        for (var k = 0; k < slides.length; k++) { if (slides[k].getAttribute('aria-hidden') !== 'true') return slides[k]; }
        return slides[0];
      }
      function play(v) { var p = v.play(); if (p && p.then) p.then(function () { v._blocked = false; }, function () { v._blocked = true; }); }
      slides.forEach(function (s) {
        var v = s.querySelector('.slide__video');
        if (!v) return;
        if (rotating) {
          v.loop = false;
          v.addEventListener('ended', function () {
            if (current() !== s) return;
            if (hover) { v.currentTime = 0; play(v); } else { next.click(); }
          });
        }
      });
      function schedule(cur) {
        clearTimeout(timer);
        if (!rotating || hover) return;
        var v = cur && cur.querySelector('.slide__video');
        if (v) {
          // El vídeo avanza solo al terminar ('ended'). Si el navegador no deja reproducirlo
          // (p. ej. modo ahorro de batería), pasa a la siguiente a los pocos segundos.
          var waited = 0;
          timer = setTimeout(function check() {
            if (current() !== cur || !v.paused || v.ended) return;
            waited += 4000;
            if (v._blocked || waited > 16000) { next.click(); return; }
            timer = setTimeout(check, 4000);
          }, 4000);
          return;
        }
        timer = setTimeout(function () { next.click(); }, speed);
      }
      function sync() {
        var cur = current();
        slides.forEach(function (s) {
          var v = s.querySelector('.slide__video');
          if (!v) return;
          if (s === cur) {
            var src = srcFor(v);
            if (v.getAttribute('src') !== src) { v.muted = true; v.setAttribute('src', src); v.load(); }
            if (v.ended) v.currentTime = 0;
            play(v);
          } else if (!v.paused || v.currentTime > 0) {
            v.pause();
            try { v.currentTime = 0; } catch (e) {}
          }
        });
        schedule(cur);
      }
      var last = null;
      new MutationObserver(function () { var c = current(); if (c !== last) { last = c; sync(); } })
        .observe(show, { subtree: true, attributes: true, attributeFilter: ['aria-hidden'] });
      show.addEventListener('mouseenter', function () { hover = true; clearTimeout(timer); });
      show.addEventListener('mouseleave', function () { hover = false; schedule(current()); });
      ['touchstart', 'scroll'].forEach(function (ev) {
        window.addEventListener(ev, function once() {
          var v = current().querySelector('.slide__video');
          if (v && v.paused && !v.ended) play(v);
          window.removeEventListener(ev, once);
        }, { passive: true });
      });
      last = current();
      sync();
    }
    function boot(root) { [].forEach.call((root || document).querySelectorAll('[data-slideshow]'), init); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { boot(); });
    else boot();
    document.addEventListener('shopify:section:load', function (e) { boot(e.target); });
  })();
</script>

{% schema %}
{
  "name": "Pase de diapositivas",
  "settings": [
    { "type": "range", "id": "height", "label": "Altura escritorio", "min": 380, "max": 900, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "height_mobile", "label": "Altura móvil", "min": 360, "max": 800, "step": 20, "unit": "px", "default": 560 },
    {
      "type": "select", "id": "mobile_layout", "label": "Diseño en móvil",
      "options": [
        { "value": "stacked", "label": "Imagen arriba, texto debajo" },
        { "value": "overlay", "label": "Texto sobre la imagen" }
      ],
      "default": "stacked"
    },
    {
      "type": "select", "id": "mobile_ratio", "label": "Proporción de imagen en móvil",
      "info": "Solo con 'Imagen arriba, texto debajo'",
      "options": [
        { "value": "1.25", "label": "Vertical (4:5)" },
        { "value": "1.333", "label": "Vertical alta (3:4)" },
        { "value": "1", "label": "Cuadrada" },
        { "value": "0.75", "label": "Horizontal (4:3)" }
      ],
      "default": "1.25"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Cambio automático", "default": true },
    { "type": "range", "id": "speed", "label": "Segundos por diapositiva", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagen móvil (opcional)" },
        { "type": "video", "id": "video", "label": "Vídeo (opcional)", "info": "Sustituye a la imagen. La imagen se ve mientras carga." },
        { "type": "video", "id": "video_mobile", "label": "Vídeo móvil (opcional)" },
        { "type": "text", "id": "focal", "label": "Punto focal (CSS)", "default": "center center", "info": "Ej: 30% center" },
        { "type": "range", "id": "overlay", "label": "Oscurecer imagen", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },
        { "type": "text", "id": "tag", "label": "Etiqueta (cursiva sobre fondo de color)", "default": "Nueva colección" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Iconos de la colección" },
        { "type": "text", "id": "text", "label": "Subtítulo", "default": "Favoritas por una razón." },
        { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver favoritas" },
        { "type": "url", "id": "button_link", "label": "Enlace del botón" },
        {
          "type": "select", "id": "align", "label": "Posición horizontal",
          "options": [{ "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" }],
          "default": "right"
        },
        {
          "type": "select", "id": "valign", "label": "Posición vertical",
          "options": [{ "value": "top", "label": "Arriba" }, { "value": "middle", "label": "Centro" }, { "value": "bottom", "label": "Abajo" }],
          "default": "middle"
        },
        { "type": "checkbox", "id": "panel", "label": "Caja clara detrás del texto", "default": false },
        { "type": "checkbox", "id": "light_text", "label": "Texto blanco", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Pase de diapositivas", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
