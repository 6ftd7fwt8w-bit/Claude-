[
  {
    "name": "theme_info",
    "theme_name": "Viva Galería",
    "theme_version": "1.0.0",
    "theme_author": "Viva la Home",
    "theme_documentation_url": "https://www.vivalahome.store",
    "theme_support_url": "https://www.vivalahome.store/pages/contact"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Ancho del logo (escritorio)",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "default": 130
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Texto del logo (si no hay imagen)",
        "default": "Viva la Home"
      },
      {
        "type": "text",
        "id": "logo_tagline",
        "label": "Subtítulo del logo",
        "default": "LÁMINAS & ILUSTRACIÓN"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Fondo",
        "default": "#F7F3EE"
      },
      {
        "type": "color",
        "id": "color_background_alt",
        "label": "Fondo alternativo (arena)",
        "default": "#EFE8DE"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Acento (bandas topo)",
        "default": "#A89478"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Texto sobre acento",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texto",
        "default": "#231F1C"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Texto secundario",
        "default": "#7B7168"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Botón",
        "default": "#231F1C"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Texto del botón",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Etiqueta destacada (ej. 'Summer Edit')",
        "default": "#F2D16B"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Precio rebajado",
        "default": "#A2573A"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Bordes",
        "default": "#E3DBD0"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "select",
        "id": "font_pairing",
        "label": "Combinación de fuentes",
        "options": [
          {
            "value": "jost",
            "label": "Jost + Cormorant (fina, estilo galería)"
          },
          {
            "value": "montserrat",
            "label": "Montserrat + Playfair (clásica)"
          },
          {
            "value": "dmsans",
            "label": "DM Sans + DM Serif (suave)"
          }
        ],
        "default": "jost"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Escala de títulos",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Tarjetas de producto",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Proporción de imagen",
        "options": [
          {
            "value": "portrait",
            "label": "Vertical (4:5)"
          },
          {
            "value": "tall",
            "label": "Vertical alta (3:4)"
          },
          {
            "value": "square",
            "label": "Cuadrada"
          },
          {
            "value": "adapt",
            "label": "Adaptar a la imagen"
          }
        ],
        "default": "tall"
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Mostrar segunda imagen al pasar el ratón",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_from_price",
        "label": "Mostrar 'Desde' cuando hay varios tamaños",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Mostrar artista / marca",
        "default": false
      },
      {
        "type": "header",
        "content": "Protección de imágenes"
      },
      {
        "type": "checkbox",
        "id": "protect_images",
        "label": "Dificultar la descarga de imágenes",
        "default": true,
        "info": "Desactiva el clic derecho, arrastrar y mantener pulsado sobre las fotos. No impide capturas de pantalla."
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Tipo de carrito",
        "options": [
          {
            "value": "drawer",
            "label": "Panel lateral"
          },
          {
            "value": "page",
            "label": "Página"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Umbral de envío gratis (0 = oculto)",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "€",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Permitir nota de pedido",
        "default": true
      }
    ]
  },
  {
    "name": "Descuento de bienvenida",
    "settings": [
      {
        "type": "paragraph",
        "content": "Lo usan el pop-up de bienvenida, la pastilla con el contador y el carrito."
      },
      {
        "type": "text",
        "id": "welcome_code",
        "label": "Código",
        "default": "HOLA10",
        "info": "Debe existir en Descuentos de Shopify"
      },
      {
        "type": "collection",
        "id": "welcome_collection",
        "label": "Colección a la que se aplica"
      },
      {
        "type": "range",
        "id": "welcome_percent",
        "label": "Porcentaje de descuento",
        "min": 5,
        "max": 50,
        "step": 5,
        "unit": "%",
        "default": 10
      },
      {
        "type": "header",
        "content": "Oferta cruzada en el carrito"
      },
      {
        "type": "paragraph",
        "content": "Cuando el código de bienvenida ya está aplicado, el carrito sugiere este segundo código. Ambos descuentos deben poder combinarse en Shopify."
      },
      {
        "type": "text",
        "id": "cross_code",
        "label": "Código sugerido",
        "default": "PEQUES3X2"
      },
      {
        "type": "collection",
        "id": "cross_collection",
        "label": "Colección del código sugerido"
      },
      {
        "type": "text",
        "id": "cross_teaser",
        "label": "Aviso",
        "default": "¡Tenemos otro descuento para ti!"
      },
      {
        "type": "text",
        "id": "cross_button",
        "label": "Enlace del aviso",
        "default": "Quiero verlo"
      },
      {
        "type": "text",
        "id": "cross_pending",
        "label": "Texto cuando ya lo ha guardado",
        "default": "[code] guardado: elige 3 láminas infantiles y te regalamos la tercera.",
        "info": "[code] se sustituye por el código"
      },
      {
        "type": "text",
        "id": "cross_go",
        "label": "Enlace cuando ya lo ha guardado",
        "default": "Elegir"
      }
    ]
  },
  {
    "name": "Textos de producto",
    "settings": [
      {
        "type": "paragraph",
        "content": "Sustituye frases de las descripciones de producto solo en este tema, sin cambiar el producto en Shopify. Copia la frase exactamente como está (incluidas negritas)."
      },
      {
        "type": "textarea",
        "id": "desc_find_1",
        "label": "Buscar (1)",
        "default": "Todos nuestros productos se realizan <strong>a mano y cuidando cada detalle</strong>."
      },
      {
        "type": "textarea",
        "id": "desc_replace_1",
        "label": "Sustituir por (1)",
        "default": "Diseñamos cada ilustración y preparamos cada pedido <strong>a mano, cuidando cada detalle</strong>."
      },
      {
        "type": "textarea",
        "id": "desc_canvas",
        "label": "Párrafo de lienzo XL",
        "info": "Se añade en los productos con lienzo, antes de «Si seleccionas marco». Admite <strong>negritas</strong>. Déjalo vacío para no mostrarlo.",
        "default": "Si prefieres un formato grande, elige <strong>lienzo XL de 70×100 o 80×120 cm</strong>: tu ilustración sobre tela 100 % algodón, montada en un bastidor de madera y lista para colgar. Al ser un lienzo no necesita marco, y los packs regalo están disponibles solo para las láminas."
      },
      {
        "type": "textarea",
        "id": "desc_find_2",
        "label": "Buscar (2)"
      },
      {
        "type": "textarea",
        "id": "desc_replace_2",
        "label": "Sustituir por (2)"
      }
    ]
  },
  {
    "name": "Buscadores (SEO)",
    "settings": [
      {
        "type": "textarea",
        "id": "shop_description",
        "label": "Descripción de la tienda",
        "info": "Texto que muestran Google y las redes al compartir la portada. Si lo dejas vacío se usa el de Tienda online → Preferencias.",
        "default": "Ilustraciones personalizadas a partir de tus fotos, en lámina o lienzo, para parejas, mascotas y familias. El regalo perfecto para bodas, aniversarios y momentos especiales. Envíos a toda España"
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "default": "https://instagram.com/"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook"
      }
    ]
  }
]