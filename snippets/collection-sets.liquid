{%- comment -%}
  Vista «Sets de 3» de una colección (plantilla collection.sets): cada set es un bloque «set» de la sección
  de colección con nombre, producto de la foto (se usa su última foto, la del set) y las 3 láminas.
  Al tocar un set se abre un panel con las 3 láminas, elección de tamaño y «Añadir las 3».
  Parámetros: blocks (section.blocks)
{%- endcomment -%}
{%- liquid
  assign set_code = settings.cross_code | strip
  assign has_sets = false
  for block in blocks
    if block.type == 'set' and block.settings.collection.handle == collection.handle and block.settings.products.count > 0
      assign has_sets = true
      break
    endif
  endfor
-%}
{%- liquid
  comment
    Descuento en sets de 3 (ajustes pack_*): recuadro arriba y precio rebajado en cada set
  endcomment
  assign pk_code = settings.pack_code | strip
  assign pk_ok = false
  if pk_code != blank and set_code == blank
    assign pk_ok = true
    if settings.pack_end != blank
      assign pk_today = 'now' | date: '%Y%m%d' | plus: 0
      assign pk_last = settings.pack_end | remove: '-' | plus: 0
      if pk_today > pk_last
        assign pk_ok = false
      endif
    endif
  endif
  assign pk_pct = settings.pack_percent | default: 10
-%}
{%- if has_sets -%}
  {%- if pk_ok -%}
    <div class="set-promo{% if settings.pack_bf %} set-promo--bf{% endif %}" data-set-promo>
      <span class="set-promo__stamp" aria-hidden="true">−{{ pk_pct }}<small>%</small></span>
      <div class="set-promo__body">
        <p class="set-promo__kicker">{%- if settings.pack_bf -%}<i class="vp-coupon__live" aria-hidden="true"></i>Black Friday{% else %}Oferta{% endif %}{% if settings.pack_end != blank %} · solo hasta el {{ settings.pack_end | date: '%-d/%-m' }}{% endif %}</p>
        <p class="set-promo__title">−{{ pk_pct }}&nbsp;% en todos los sets de 3 láminas</p>
        <p class="set-promo__text">Elige tu set, marca la casilla del descuento y se aplica solo al añadir las 3.</p>
        {%- if settings.pack_end != blank -%}<p class="vp-coupon__timer set-promo__timer" data-pc-timer></p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <div class="set-intro">
    <p class="set-intro__title">🧩 Sets de 3 láminas que combinan</p>
    {%- if set_code != blank -%}
      <p class="set-intro__deal">🍀 <strong>¡Estás de suerte! 3x2</strong> · con el código <b>{{ set_code }}</b> te regalamos la tercera. Se aplica solo al añadir el set.</p>
    {%- endif -%}
  </div>
  <div class="set-grid">
    {%- for block in blocks -%}
      {%- if block.type == 'set' and block.settings.collection.handle == collection.handle and block.settings.products.count > 0 -%}
        {%- liquid
          assign lead = block.settings.photo_product | default: block.settings.products.first
          assign photo = lead.media.last.preview_image | default: lead.featured_image
          assign set_total = 0
          assign set_min = 999999
          assign set_art = nil
          for p in block.settings.products
            if set_art == nil and p.featured_image
              assign set_art = p.featured_image
            endif
            assign set_total = set_total | plus: p.price_min
            if p.price_min < set_min
              assign set_min = p.price_min
            endif
          endfor
          assign set_pay = set_total | minus: set_min
          if pk_ok
            assign set_pay = 0
            for p in block.settings.products
              assign p_off = p.price_min | times: pk_pct | divided_by: 100
              assign set_pay = set_pay | plus: p.price_min | minus: p_off
            endfor
          endif
        -%}
        <button type="button" class="set-card" data-set-open="set-{{ block.id }}" {{ block.shopify_attributes }}>
          <span class="set-card__media">
            {{ photo | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.name }}
            {%- if set_code != blank -%}<span class="set-card__badge">3x2</span>{%- elsif pk_ok -%}<span class="set-card__badge set-card__badge--bf">{% if settings.pack_bf %}Black Friday {% endif %}−{{ pk_pct }}&nbsp;%</span>{%- endif -%}
          </span>
          <span class="set-card__name">Set «{{ block.settings.name }}»</span>
          <span class="set-card__price">3 láminas · {% if set_code != blank or pk_ok %}<s>{{ set_total | money }}</s> <b>{{ set_pay | money }}</b>{% else %}<b>{{ set_total | money }}</b>{% endif %}</span>
        </button>

        <dialog class="set-sheet" id="set-{{ block.id }}" data-set-sheet data-code="{{ set_code | escape }}">
          <div class="set-sheet__panel">
            <button type="button" class="set-sheet__close" data-set-close aria-label="Cerrar">&times;</button>
            {%- comment -%} Galería: foto del set y, después, las fotos de cada lámina del set (detalles) {%- endcomment -%}
            <div class="set-sheet__media set-gal" data-set-gal>
              <div class="set-gal__track" data-set-gal-track>
                <figure class="set-gal__slide">{{ photo | image_url: width: 900 | image_tag: loading: 'lazy', widths: '500, 700, 900', sizes: '(min-width: 750px) 560px, 100vw', alt: block.settings.name }}</figure>
                {%- for p in block.settings.products -%}
                  {%- assign p_shown = 0 -%}
                  {%- assign p_alt = p.title | split: '–' | last | split: '|' | first | strip -%}<!--gal {{ p.handle }} {{ p.images.size }} {{ p.media.size }}-->
                  {%- for img in p.images -%}
                    {%- if img.src != photo.src and p_shown < 4 -%}
                      {%- assign p_shown = p_shown | plus: 1 -%}
                      <figure class="set-gal__slide" data-gal-product="{{ p.id }}">{{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '500, 700, 900', sizes: '(min-width: 750px) 560px, 100vw', alt: p_alt }}<figcaption class="set-gal__cap">{{ p_alt }}</figcaption></figure>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              </div>
              <button type="button" class="set-gal__nav set-gal__nav--prev" data-set-gal-prev aria-label="Foto anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
              <button type="button" class="set-gal__nav set-gal__nav--next" data-set-gal-next aria-label="Foto siguiente"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
              <span class="set-gal__count" data-set-gal-count></span>
            </div>
            <div class="set-sheet__body">
              <div class="set-sheet__head">
                <div>
                  <p class="set-sheet__eyebrow">Set de 3 láminas</p>
                  <h3 class="set-sheet__title">«{{ block.settings.name }}»</h3>
                </div>
                <button type="button" class="next-prod next-prod--set" data-set-next>
                  <span class="next-prod__txt">Siguiente set</span>
                  <span class="next-prod__arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </button>
              </div>
              <p class="set-sheet__sizes-label">Tamaño para las 3 <span>(o elige cada una abajo)</span></p>
              <div class="set-sheet__sizes" role="radiogroup" aria-label="Tamaño para las 3">
                <button type="button" class="set-size is-active" data-set-size="A4" aria-pressed="true">A4 · 21 × 29,7 cm</button>
                <button type="button" class="set-size" data-set-size="A3" aria-pressed="false">A3 · 29,7 × 42 cm</button>
              </div>
              <button type="button" class="guide-open guide-open--set" data-guide-open {% if set_art %}data-guide-art="{{ set_art | image_url: width: 500 }}"{% endif %}>📏 Ver A4 y A3 a escala <span>(junto a una chica de 1,65 m)</span></button>
              <ul class="set-sheet__items">
                {%- for p in block.settings.products -%}
                  {%- liquid
                    assign v_a4 = p.variants.first
                    assign v_a3 = p.variants.first
                    for v in p.variants
                      if v.title contains 'A4'
                        assign v_a4 = v
                      elsif v.title contains 'A3'
                        assign v_a3 = v
                      endif
                    endfor
                  -%}
                  <li class="set-item" data-set-item data-a4="{{ v_a4.id }}" data-a4-price="{{ v_a4.price }}" data-a3="{{ v_a3.id }}" data-a3-price="{{ v_a3.price }}">
                    <a href="{{ p.url }}" class="set-item__img" data-gal-jump="{{ p.id }}" title="Ver fotos de esta lámina">{{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 64, height: 80, alt: p.title }}</a>
                    <span class="set-item__name">{{ p.title | split: '–' | last | split: '|' | first | strip }}
                      <span class="set-item__sizes" role="group" aria-label="Tamaño de esta lámina">
                        <button type="button" class="set-item__size is-active" data-item-size="A4" aria-pressed="true">A4</button>
                        <button type="button" class="set-item__size" data-item-size="A3" aria-pressed="false">A3</button>
                      </span>
                    </span>
                    <span class="set-item__price" data-set-item-price>{{ v_a4.price | money }}</span>
                  </li>
                {%- endfor -%}
              </ul>
              {%- if set_code == blank -%}{% render 'pack-coupon' %}{%- endif -%}
              {%- if set_code != blank -%}
                <p class="set-sheet__deal"><span aria-hidden="true">🎉</span> <span>¡Enhorabuena! Con el código <b>{{ set_code }}</b> la lámina más barata te sale <b>gratis</b>. Se aplica automáticamente al añadir el set.</span></p>
              {%- endif -%}
              <div class="set-sheet__total">
                <span>Total del set</span>
                <span><s data-set-old></s> <strong data-set-total></strong></span>
              </div>
              {% render 'ship-note' %}
              <button type="button" class="button button--full set-sheet__add" data-set-add>Añadir las 3 al carrito</button>
              <p class="set-sheet__msg" data-set-msg hidden></p>
            </div>
          </div>
        </dialog>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- liquid
    assign guide_art = blank
    for block in blocks
      if block.type == 'set' and block.settings.collection.handle == collection.handle and block.settings.products.count > 0
        for p in block.settings.products
          if p.featured_image
            assign guide_art = p.featured_image
            break
          endif
        endfor
        break
      endif
    endfor
  -%}
  <dialog class="guide-dialog" data-guide aria-label="Comparativa de tamaños A4 y A3">
    <button type="button" class="guide-dialog__close" data-guide-close aria-label="Cerrar">&times;</button>
    <p class="guide-dialog__title">¿A4 o A3?</p>
    {% render 'size-guide', art: guide_art, laminas_only: true %}
  </dialog>
{%- else -%}
  <p class="cart-empty">Pronto tendrás aquí nuestros sets.</p>
{%- endif -%}
