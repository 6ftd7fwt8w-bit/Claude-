{%- comment -%}
  Pop-up de bienvenida con código de descuento.
  - Aparece una vez por visitante (se vuelve a mostrar tras X días si lo cierra sin aceptar).
  - Al aceptar, aplica el código automáticamente (/discount/CODIGO) y redirige.
  - Muestra una pastilla con cuenta atrás mientras el código se mantiene aplicado;
    al terminar, el código se quita del carrito (se puede seguir escribiendo a mano en el pago).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign redirect_path = s.link | default: routes.all_products_collection_url
  assign apply_url = routes.root_url | append: '/discount/' | append: s.code | replace: '//', '/' | append: '?redirect=' | append: redirect_path
-%}
{%- if s.enabled and s.code != blank -%}
<div class="welcome" data-welcome
  data-code="{{ s.code | escape }}" data-apply-url="{{ apply_url }}"
  data-delay="{{ s.delay }}" data-minutes="{{ s.minutes }}" data-repeat-days="{{ s.repeat_days }}"
  data-design-mode="{{ request.design_mode }}" hidden>
  <div class="welcome__overlay" data-welcome-close></div>
  <div class="welcome__dialog" role="dialog" aria-modal="true" aria-labelledby="WelcomeTitle-{{ section.id }}">
    <button type="button" class="welcome__close" data-welcome-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <div class="welcome__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 700, 1000', sizes: '(min-width: 750px) 380px, 100vw', alt: '' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="welcome__body">
      {%- if s.tag != blank -%}<span class="tag-highlight script welcome__tag">{{ s.tag }}</span>{%- endif -%}
      <h2 class="welcome__title" id="WelcomeTitle-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<div class="welcome__text rte">{{ s.text }}</div>{%- endif -%}
      <div class="welcome__code">
        <span class="welcome__code-label">{{ s.code_label }}</span>
        <span class="welcome__code-value">{{ s.code }}</span>
      </div>
      <a href="{{ apply_url }}" class="button button--full welcome__cta" data-welcome-accept>{{ s.button_label }}</a>
      <button type="button" class="welcome__decline" data-welcome-close>{{ s.decline_label }}</button>
      {%- if s.small_print != blank -%}<p class="welcome__small">{{ s.small_print }}</p>{%- endif -%}
    </div>
  </div>
</div>

<div class="welcome-badge" data-welcome-badge hidden role="status" aria-live="polite">
  <span class="welcome-badge__icon">{% render 'icon', name: 'gift' %}</span>
  <span class="welcome-badge__text">
    <strong>{{ s.badge_title | replace: '[code]', s.code }}</strong>
    <span>{{ s.badge_text }} <b class="welcome-badge__timer" data-welcome-timer>--:--</b></span>
  </span>
  <button type="button" class="welcome-badge__close" data-welcome-badge-hide aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Pop-up de bienvenida",
  "class": "section-welcome",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Activar pop-up", "default": true },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "tag", "label": "Etiqueta", "default": "¡Hola!" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Nos alegra mucho verte por aquí" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Para tu primera compra te regalamos un <strong>10 % de descuento</strong> en nuestras láminas personalizadas.</p>" },
    { "type": "text", "id": "code_label", "label": "Texto sobre el código", "default": "Tu código" },
    { "type": "text", "id": "code", "label": "Código de descuento", "default": "HOLA10", "info": "Debe existir en Descuentos de Shopify" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "¡Sí, lo quiero!" },
    { "type": "url", "id": "link", "label": "Página a la que lleva", "default": "/collections/all" },
    { "type": "text", "id": "decline_label", "label": "Texto para rechazar", "default": "Ahora no, gracias" },
    { "type": "text", "id": "small_print", "label": "Letra pequeña", "default": "Válido una vez por cliente en láminas personalizadas." },
    { "type": "header", "content": "Comportamiento" },
    { "type": "range", "id": "delay", "label": "Mostrar tras", "min": 0, "max": 20, "step": 1, "unit": "s", "default": 4 },
    { "type": "range", "id": "repeat_days", "label": "Volver a mostrar si lo cierran, tras", "min": 1, "max": 30, "step": 1, "unit": "d", "default": 7 },
    { "type": "header", "content": "Pastilla con cuenta atrás" },
    { "type": "range", "id": "minutes", "label": "Tiempo que el código queda aplicado", "min": 15, "max": 180, "step": 15, "unit": "min", "default": 90 },
    { "type": "text", "id": "badge_title", "label": "Título", "default": "Tu 10 % con [code] está aplicado", "info": "[code] se sustituye por el código" },
    { "type": "text", "id": "badge_text", "label": "Texto antes del contador", "default": "Te lo guardamos durante" }
  ],
  "presets": [{ "name": "Pop-up de bienvenida" }]
}
{% endschema %}
