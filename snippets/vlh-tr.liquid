{%- comment -%} Traduce al español etiquetas que Shopify envía en inglés (filtros y orden). Parámetro: t {%- endcomment -%}
{%- case t -%}
  {%- when 'Availability' -%}Disponibilidad
  {%- when 'Price' -%}Precio
  {%- when 'In stock' -%}Disponible
  {%- when 'Out of stock' -%}Agotado
  {%- when 'Product type' -%}Tipo de producto
  {%- when 'Vendor', 'Brand' -%}Marca
  {%- when 'Size' -%}Tamaño
  {%- when 'Color', 'Colour' -%}Color
  {%- when 'Tags', 'Tag' -%}Etiquetas
  {%- when 'Featured' -%}Destacados
  {%- when 'Best selling' -%}Más vendidos
  {%- when 'Alphabetically, A-Z' -%}Alfabéticamente, A-Z
  {%- when 'Alphabetically, Z-A' -%}Alfabéticamente, Z-A
  {%- when 'Price, low to high' -%}Precio, de menor a mayor
  {%- when 'Price, high to low' -%}Precio, de mayor a menor
  {%- when 'Date, old to new' -%}Fecha, más antiguos primero
  {%- when 'Date, new to old' -%}Fecha, más recientes primero
  {%- when 'Relevance' -%}Relevancia
  {%- else -%}{{ t }}
{%- endcase -%}
