{%- liquid
  assign collection_obj = section.settings.collection
  assign limit = section.settings.limit
-%}
<section class="section bg-{{ section.settings.background }} reveal" data-reveal>
  <div class="page-width">
    {%- if section.settings.title != blank -%}<h2 class="section-title">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.subtitle != blank -%}<p class="section-subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}

    {%- if section.settings.layout == 'carousel' -%}
      <div class="carousel" data-carousel>
        <button type="button" class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <div class="carousel__track" data-carousel-track style="--cols: {{ section.settings.columns }};">
    {%- else -%}
      <div class="product-grid" style="--cols: {{ section.settings.columns }};">
    {%- endif -%}

    {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
      {%- liquid
        assign fc_ratio = ''
        if section.settings.card_ratio == 'square'
          assign fc_ratio = '1 / 1'
        endif
        assign shown = 0
        assign used = ','
      -%}
      {%- comment -%} Primero los productos elegidos a mano; luego la colección, sin repetir producto ni foto {%- endcomment -%}
      {%- for pass in (1..2) -%}
        {%- if pass == 1 -%}{%- assign src = section.settings.products_first -%}{%- else -%}{%- assign src = collection_obj.products -%}{%- endif -%}
        {%- for product in src limit: 50 -%}
          {%- liquid
            if shown >= limit
              break
            endif
            assign pkey = ',p' | append: product.id | append: ','
            if section.settings.image_pos == 'last' and product.media.size > 1
              assign ikey = ',m' | append: product.media.last.id | append: ','
            else
              assign ikey = ',m' | append: product.featured_media.id | append: ','
            endif
            if used contains pkey or used contains ikey
              continue
            endif
            assign used = used | append: pkey | append: ikey
            assign shown = shown | plus: 1
          -%}
          {% render 'product-card', product: product, image_pos: section.settings.image_pos, ratio: fc_ratio, price_suffix: section.settings.price_suffix %}
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="card">
          <div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
          <div class="card__info"><span class="card__title">{{ 'products.placeholder_title' | t }}</span><div class="card__price">19,95 €</div></div>
        </div>
      {%- endfor -%}
    {%- endif -%}

    {%- if section.settings.layout == 'carousel' -%}
        </div>
        <button type="button" class="carousel__btn carousel__btn--next" data-carousel-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    {%- else -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and collection_obj != blank -%}
      <div style="text-align:center;margin-top:36px">
        <a href="{{ collection_obj.url }}" class="button button--outline">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Las más queridas" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "product_list", "id": "products_first", "label": "Productos que salen primero", "limit": 12, "info": "Opcional. Después se muestran los de la colección, sin repetir productos ni fotos." },
    {
      "type": "select", "id": "image_pos", "label": "Foto principal de cada producto",
      "options": [{ "value": "first", "label": "La primera" }, { "value": "last", "label": "La última (p. ej. composición de set)" }],
      "default": "first"
    },
    {
      "type": "select", "id": "card_ratio", "label": "Formato de las fotos",
      "options": [{ "value": "theme", "label": "Como en el resto de la tienda" }, { "value": "square", "label": "Cuadrado (sin recortar fotos cuadradas)" }],
      "default": "theme"
    },
    { "type": "text", "id": "price_suffix", "label": "Texto tras el precio", "info": "Ej.: la lámina" },
    { "type": "range", "id": "limit", "label": "Máximo de productos", "min": 2, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "columns", "label": "Columnas (escritorio)", "min": 2, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select", "id": "layout", "label": "Diseño",
      "options": [{ "value": "carousel", "label": "Carrusel con flechas" }, { "value": "grid", "label": "Cuadrícula" }],
      "default": "carousel"
    },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [{ "value": "default", "label": "Crema" }, { "value": "alt", "label": "Arena" }],
      "default": "default"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Botón 'Ver todo'", "default": false },
    { "type": "text", "id": "view_all_label", "label": "Texto del botón", "default": "Ver todo" }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
