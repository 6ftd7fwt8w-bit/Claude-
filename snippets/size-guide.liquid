{%- comment -%}
  Guía visual de tamaños a escala (1 cm = 2 px) con una persona de 1,65 m de referencia.
  Parámetros: art (imagen para los lienzos), art_a3 (imagen para la lámina A3, opcional)
{%- endcomment -%}
{%- liquid
  assign art_url = ''
  if art != blank
    assign art_url = art | image_url: width: 500
  endif
  assign a3_url = art_url
  if art_a3 != blank
    assign a3_url = art_a3 | image_url: width: 300
  endif
  assign uid = 'sg' | append: forloop.index | append: art_url.size
-%}
<figure class="size-guide">
  <svg viewBox="0 0 860 470" role="img" aria-labelledby="{{ uid }}-t">
    <title id="{{ uid }}-t">Comparativa de tamaños: persona de 1,65 m, lámina A3 de 29,7 × 42 cm, lienzo de 70 × 100 cm y lienzo de 80 × 120 cm</title>
    <defs>
      <linearGradient id="{{ uid }}-wall" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F4EEE6"/><stop offset="1" stop-color="#EAE1D5"/></linearGradient>
      <filter id="{{ uid }}-sh" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="3" dy="5" stdDeviation="5" flood-color="#5a4632" flood-opacity=".22"/></filter>
      <marker id="{{ uid }}-ar" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#8a7a68"/></marker>
    </defs>
    <rect x="0" y="0" width="860" height="470" fill="url(#{{ uid }}-wall)"/>
    <rect x="0" y="430" width="860" height="40" fill="#DCCFBE"/>
    <line x1="0" y1="430" x2="860" y2="430" stroke="#CBBBA6" stroke-width="2"/>

    {%- comment -%} Persona 165 cm = 330 px, pies en y=430 {%- endcomment -%}
    <g fill="#B9A58C">
      <circle cx="110" cy="122" r="21"/>
      <path d="M86 150 Q110 140 134 150 L146 268 L136 268 L130 196 L128 430 L113 430 L111 280 L109 280 L107 430 L92 430 L90 196 L84 268 L74 268 Z"/>
    </g>
    <line x1="160" y1="100" x2="160" y2="430" stroke="#8a7a68" stroke-width="1.2" marker-start="url(#{{ uid }}-ar)" marker-end="url(#{{ uid }}-ar)"/>
    <text x="168" y="270" class="sg-dim">1,65 m</text>

    {%- comment -%} Centro de las piezas a 150 cm del suelo (y=130) {%- endcomment -%}
    {%- comment -%} Lámina A3: 29,7 × 42 cm -> 59 × 84 px {%- endcomment -%}
    <g filter="url(#{{ uid }}-sh)"><rect x="236" y="88" width="59" height="84" fill="#fff"/></g>
    {%- if a3_url != '' -%}<image href="{{ a3_url }}" x="240" y="92" width="51" height="76" preserveAspectRatio="xMidYMid slice"/>{%- endif -%}
    <text x="265" y="196" class="sg-name" text-anchor="middle">Lámina A3</text>
    <text x="265" y="220" class="sg-dim" text-anchor="middle">29,7 × 42 cm</text>

    {%- comment -%} Lienzo 70 × 100 cm -> 140 × 200 px {%- endcomment -%}
    <g filter="url(#{{ uid }}-sh)"><rect x="360" y="30" width="140" height="200" fill="#fbf8f3"/></g>
    {%- if art_url != '' -%}<image href="{{ art_url }}" x="360" y="30" width="140" height="200" preserveAspectRatio="xMidYMid slice"/>{%- endif -%}
    <rect x="500" y="34" width="5" height="200" fill="#d9cbb8"/>
    <line x1="360" y1="244" x2="500" y2="244" stroke="#8a7a68" stroke-width="1.2" marker-start="url(#{{ uid }}-ar)" marker-end="url(#{{ uid }}-ar)"/>
    <text x="430" y="262" class="sg-dim" text-anchor="middle">70 cm</text>
    <line x1="516" y1="30" x2="516" y2="230" stroke="#8a7a68" stroke-width="1.2" marker-start="url(#{{ uid }}-ar)" marker-end="url(#{{ uid }}-ar)"/>
    <text x="522" y="134" class="sg-dim">100 cm</text>
    <text x="430" y="292" class="sg-name" text-anchor="middle">Lienzo 70 × 100</text>

    {%- comment -%} Lienzo 80 × 120 cm -> 160 × 240 px {%- endcomment -%}
    <g filter="url(#{{ uid }}-sh)"><rect x="600" y="10" width="160" height="240" fill="#fbf8f3"/></g>
    {%- if art_url != '' -%}<image href="{{ art_url }}" x="600" y="10" width="160" height="240" preserveAspectRatio="xMidYMid slice"/>{%- endif -%}
    <rect x="760" y="14" width="5" height="240" fill="#d9cbb8"/>
    <line x1="600" y1="264" x2="760" y2="264" stroke="#8a7a68" stroke-width="1.2" marker-start="url(#{{ uid }}-ar)" marker-end="url(#{{ uid }}-ar)"/>
    <text x="680" y="282" class="sg-dim" text-anchor="middle">80 cm</text>
    <line x1="776" y1="10" x2="776" y2="250" stroke="#8a7a68" stroke-width="1.2" marker-start="url(#{{ uid }}-ar)" marker-end="url(#{{ uid }}-ar)"/>
    <text x="782" y="134" class="sg-dim">120 cm</text>
    <text x="680" y="312" class="sg-name" text-anchor="middle">Lienzo 80 × 120</text>

    {%- comment -%} Aparador de referencia (40 cm de alto) {%- endcomment -%}
    <rect x="330" y="350" width="460" height="80" rx="3" fill="#CDB594"/>
    <rect x="330" y="350" width="460" height="8" fill="#BFA682"/>
  </svg>
  <figcaption class="size-guide__caption">A escala, junto a una persona de 1,65 m. Los lienzos llegan montados en bastidor, listos para colgar.</figcaption>
</figure>
