{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign ship_is_free = false
  if cart.item_count > 0
    if settings.free_shipping_always
      assign ship_is_free = true
    elsif settings.free_shipping_threshold > 0 and remaining <= 0
      assign ship_is_free = true
    endif
  endif
  assign disc_cents = cart.original_total_price | minus: cart.total_price
  assign w_code = settings.welcome_code | strip | upcase
  assign w_applied = false
  for item in cart.items
    for alloc in item.line_level_discount_allocations
      assign t = alloc.discount_application.title | strip | upcase
      if t == w_code and alloc.amount > 0
        assign w_applied = true
      endif
    endfor
  endfor
-%}
{%- if settings.free_shipping_threshold > 0 and settings.free_shipping_always == false and cart.item_count > 0 -%}
  <div class="cart-shipping-bar{% if remaining <= 0 %} is-free{% endif %}">
    <p class="cart-shipping-bar__text">
      <span class="cart-shipping-bar__icon" aria-hidden="true">{% if remaining > 0 %}🚚{% else %}🎉{% endif %}</span>
      <span>
      {%- if remaining > 0 -%}
        {%- assign remaining_formatted = remaining | money -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_formatted }}
      {%- else -%}
        {{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
      {%- if settings.free_shipping_zone != blank %} <small>({{ settings.free_shipping_zone }})</small>{%- endif -%}
      </span>
    </p>
    {%- assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 -%}
    <div class="cart-shipping-bar__track"><div class="cart-shipping-bar__fill" style="width: {{ pct }}%"></div></div>
  </div>
{%- endif -%}
{%- if cart.item_count > 0 and hide_discount != true -%}{% render 'cart-discount' %}{%- endif -%}
{%- if cart.item_count > 0 -%}
  <div class="cart-breakdown">
    <div class="cart-breakdown__row"><span>{{ 'cart.breakdown_products' | t }}</span><span>{{ cart.original_total_price | money }}</span></div>
    {%- if disc_cents > 0 -%}
      <div class="cart-breakdown__row is-saving">
        <span>Te ahorras {{ disc_cents | money }} en este pedido{% if w_applied %}<small class="cart-breakdown__hint">si finalizas el pedido antes de 24&nbsp;h</small>{% endif %}</span>
        <span>−{{ disc_cents | money }}</span>
      </div>
    {%- endif -%}
    <div class="cart-breakdown__row{% if ship_is_free %} is-saving{% endif %}">
      <span>{{ 'cart.breakdown_shipping' | t }}{% if settings.free_shipping_zone != blank %} ({{ settings.free_shipping_zone }}){% endif %}</span>
      <span>{% if ship_is_free %}<b>{{ 'cart.breakdown_free' | t }}</b>{% else %}Al finalizar la compra{% endif %}</span>
    </div>
    <div class="cart-breakdown__total"><span>Total</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>
  </div>
  <p class="cart-free-note__small">IVA incluido.{% if ship_is_free %} {{ 'cart.free_note_outside' | t }}{% endif %}</p>
{%- endif -%}
