{%- comment -%}
  Galería "Visto en Instagram": cada bloque es una foto o un vídeo corto
  (el vídeo se reproduce en bucle, sin sonido) con enlace al post.
{%- endcomment -%}
<section class="section section--tight bg-{{ section.settings.background }}" style="padding-bottom:0">
  {%- if section.settings.eyebrow != blank -%}
    <p class="ig-eyebrow">
      {%- if section.settings.instagram_url != blank -%}<a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">{%- endif -%}
      {% render 'icon', name: 'instagram' %}<span>{{ section.settings.eyebrow }}</span>
      {%- if section.settings.instagram_url != blank -%}</a>{%- endif -%}
    </p>
  {%- endif -%}
  <h2 class="section-title">
    {%- if section.settings.instagram_url != blank -%}
      <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">{{ section.settings.title }}</a>
    {%- else -%}
      {{ section.settings.title }}
    {%- endif -%}
  </h2>
  {%- if section.settings.subtitle != blank -%}<p class="section-subtitle ig-subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
  {%- capture ig_items -%}
    {%- for block in section.blocks -%}
      <a class="gallery__item" href="{{ block.settings.enlace | default: section.settings.instagram_url | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          {{ block.settings.video | video_tag: image_size: '600x800', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
        {%- elsif block.settings.imagen != blank -%}
          {{ block.settings.imagen | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 17vw, 40vw', alt: block.settings.alt | default: section.settings.title }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if section.settings.autoscroll -%}
    <div class="ig-marquee" style="--ig-duration: {{ section.blocks.size | times: section.settings.speed }}s; --ig-width: {{ section.settings.item_width }}px;">
      <div class="ig-marquee__track">
        <div class="ig-marquee__set">{{ ig_items }}</div>
        <div class="ig-marquee__set" aria-hidden="true">{{ ig_items | replace: 'target="_blank"', 'target="_blank" tabindex="-1"' }}</div>
      </div>
    </div>
  {%- else -%}
    <div class="carousel" data-carousel>
      <button type="button" class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <div class="carousel__track" data-carousel-track style="--cols: {{ section.settings.columns }}; --gap: 4px;">{{ ig_items }}</div>
      <button type="button" class="carousel__btn carousel__btn--next" data-carousel-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Visto en Instagram",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo (con icono de Instagram)", "info": "Ej.: @vivalahome.store" },
    { "type": "text", "id": "title", "label": "Título", "default": "Visto en Instagram" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo" },
    { "type": "url", "id": "instagram_url", "label": "Enlace a tu perfil" },
    { "type": "checkbox", "id": "autoscroll", "label": "Movimiento automático", "default": true },
    { "type": "range", "id": "speed", "label": "Lentitud del movimiento (segundos por foto)", "min": 2, "max": 8, "step": 1, "unit": "s", "default": 4 },
    { "type": "range", "id": "item_width", "label": "Ancho de cada foto (movimiento automático)", "min": 160, "max": 360, "step": 10, "unit": "px", "default": 240 },
    { "type": "range", "id": "columns", "label": "Columnas visibles (sin movimiento)", "min": 3, "max": 8, "step": 1, "default": 6 },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [{ "value": "default", "label": "Crema" }, { "value": "alt", "label": "Arena" }],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "foto",
      "name": "Foto o vídeo",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Imagen" },
        { "type": "video", "id": "video", "label": "Vídeo (sustituye a la imagen)" },
        { "type": "url", "id": "enlace", "label": "Enlace al post" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" }
      ]
    }
  ],
  "presets": [{ "name": "Visto en Instagram", "blocks": [{ "type": "foto" }, { "type": "foto" }, { "type": "foto" }, { "type": "foto" }, { "type": "foto" }, { "type": "foto" }] }]
}
{% endschema %}
