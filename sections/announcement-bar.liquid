{%- assign ann_today = 'now' | date: '%Y%m%d' | plus: 0 -%}
{%- comment -%} Si hay un anuncio «Black Friday» vigente, toda la barra va en negro y dorado {%- endcomment -%}
{%- assign ann_bf = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.bf -%}
    {%- assign ann_bf = true -%}
    {%- if block.settings.until != blank -%}
      {%- assign ann_last = block.settings.until | remove: '-' | plus: 0 -%}
      {%- if ann_today > ann_last -%}{%- assign ann_bf = false -%}{%- endif -%}
    {%- endif -%}
    {%- if ann_bf -%}{%- break -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
<div class="announcement{% if ann_bf %} announcement--bf{% endif %}" style="--announcement-bg: {{ section.settings.bg }}; --announcement-fg: {{ section.settings.fg }};">
  <div class="announcement__track" data-announcement>
    {%- assign ann_first = true -%}
    {%- for block in section.blocks -%}
      {%- comment -%} Anuncios con fecha de fin: se ocultan solos al día siguiente {%- endcomment -%}
      {%- if block.settings.until != blank -%}
        {%- assign ann_last = block.settings.until | remove: '-' | plus: 0 -%}
        {%- if ann_today > ann_last -%}{%- continue -%}{%- endif -%}
      {%- endif -%}
      <p class="announcement__item{% if ann_first %} is-active{% endif %}{% if block.settings.urgent %} announcement__item--urgent{% endif %}{% if block.settings.bf %} announcement__item--bf{% endif %}{% if block.settings.pill %} announcement__item--pill{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.pill -%}<span class="announcement__pill">{%- endif -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
        {%- if block.settings.pill -%}</span>{%- endif -%}
      </p>
      {%- assign ann_first = false -%}
    {%- endfor -%}
  </div>
</div>

<style>
  .announcement--bf { background: #0d0b09; color: #fff; border-bottom: 1px solid #3a2f1c; }
  .announcement--bf a { color: inherit; }
  .announcement__item--bf { color: #f2d16b; font-weight: 600; letter-spacing: .06em; }
  .announcement__item--bf b { color: #fff; }
  .announcement__pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 12px; border-radius: 999px; background: #231F1C; color: #fff; font-weight: 700; letter-spacing: .06em; line-height: 1.4; }
  .announcement--bf .announcement__pill { background: #fff; color: #0d0b09; }
  .announcement__item--pill a { text-decoration: none; }
</style>

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "section-announcement",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#F2D16B" },
    { "type": "color", "id": "fg", "label": "Texto", "default": "#231F1C" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anuncio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Nuevo: colección infantil" },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "text", "id": "until", "label": "Mostrar hasta (AAAA-MM-DD)", "info": "Opcional. Al día siguiente el anuncio se oculta solo." },
        { "type": "checkbox", "id": "urgent", "label": "Destacar (oferta con fecha límite)", "default": false },
        { "type": "checkbox", "id": "pill", "label": "Resaltar en una etiqueta", "default": false, "info": "Para mensajes clave como el envío gratis." },
        { "type": "checkbox", "id": "bf", "label": "Estilo Black Friday", "default": false, "info": "Mientras este anuncio esté vigente, toda la barra sale en negro y dorado." }
      ]
    }
  ],
  "presets": [{ "name": "Barra de anuncios", "blocks": [{ "type": "announcement" }] }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
