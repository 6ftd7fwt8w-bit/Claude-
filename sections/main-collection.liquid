{%- liquid
  assign hero_image = collection.image
  if section.settings.hero_image != blank
    assign hero_image = section.settings.hero_image
  endif
  assign banner = nil
  for block in section.blocks
    if block.type == 'banner' and block.settings.collection.handle == collection.handle and block.settings.image != blank
      assign banner = block
      break
    endif
  endfor
-%}
{%- if banner -%}
  {%- comment -%} Portada propia de esta colección: texto oscuro sobre la zona libre de la foto; en móvil, foto arriba y texto debajo {%- endcomment -%}
  <div class="collection-banner collection-banner--{{ banner.settings.text_position | default: 'center' }}" {{ banner.shopify_attributes }}>
    <picture class="collection-banner__media">
      {%- if banner.settings.image_mobile != blank -%}
        <source media="(max-width: 749px)" srcset="{{ banner.settings.image_mobile | image_url: width: 750 }} 750w, {{ banner.settings.image_mobile | image_url: width: 1200 }} 1200w" sizes="100vw">
      {%- endif -%}
      {{ banner.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '1000, 1400, 1800, 2400', sizes: '100vw', alt: collection.title }}
    </picture>
    <div class="collection-banner__content">
      {%- if banner.settings.eyebrow != blank -%}<span class="eyebrow">{{ banner.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="display">{{ collection.title }}</h1>
      {%- if banner.settings.text != blank -%}
        <p class="collection-banner__text">{{ banner.settings.text }}</p>
      {%- elsif collection.description != blank and section.settings.show_description -%}
        <div class="collection-banner__text rte">{{ collection.description }}</div>
      {%- endif -%}
      {% render 'collection-note', collection: collection %}
    </div>
  </div>
{%- else -%}
<div class="collection-hero{% if section.settings.show_image and hero_image %} collection-hero--image{% else %} bg-alt{% endif %}">
  {%- if section.settings.show_image and hero_image -%}
    <div class="collection-hero__media">
      {{ hero_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: collection.title }}
    </div>
  {%- endif -%}
  <div class="collection-hero__content">
    <h1 class="display" style="font-size: clamp(32px, 4vw, 52px)">{{ collection.title }}</h1>
    {%- if collection.description != blank and section.settings.show_description -%}
      <div class="collection-hero__desc rte">{{ collection.description }}</div>
    {%- endif -%}
    {% render 'collection-note', collection: collection %}
  </div>
</div>
{%- endif -%}

<section class="section" style="padding-top:24px">
  <div class="page-width">
    {%- for block in section.blocks -%}
      {%- if block.type == 'themes' and block.settings.collection.handle == collection.handle and block.settings.themes != blank -%}
        {%- comment -%} Botones de temática: filtran la colección por etiqueta (etiqueta|texto por línea) {%- endcomment -%}
        <nav class="theme-pills" aria-label="{{ block.settings.title | default: 'Temáticas' | escape }}" {{ block.shopify_attributes }}>
          {%- liquid
            assign all_active = true
            if template.suffix == 'sets'
              assign all_active = false
            elsif current_tags != blank and current_tags.size > 0
              assign all_active = false
            endif
          -%}
          <a href="{{ collection.url }}" class="theme-pill{% if all_active %} is-active{% endif %}">{{ block.settings.all_label | default: 'Todas' }}</a>
          {%- if block.settings.sets_label != blank -%}
            <a href="{{ collection.url }}?view=sets" class="theme-pill theme-pill--sets{% if template.suffix == 'sets' %} is-active{% endif %}">{{ block.settings.sets_label }}</a>
          {%- endif -%}
          {%- assign theme_lines = block.settings.themes | newline_to_br | split: '<br />' -%}
          {%- for line in theme_lines -%}
            {%- assign parts = line | strip | split: '|' -%}
            {%- if parts.size > 1 -%}
              {%- assign t_tag = parts[0] | strip -%}
              <a href="{{ collection.url }}/{{ t_tag | handle }}" class="theme-pill{% if current_tags contains t_tag %} is-active{% endif %}">{{ parts[1] | strip }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if template.suffix == 'sets' -%}
      {% render 'collection-sets', blocks: section.blocks, collection: collection %}
    {%- else -%}
    {%- paginate collection.products by section.settings.per_page -%}
      <form class="facets" data-facets-form>
        <div class="facets__filters">
          {%- for filter in collection.filters -%}
            <details>
              <summary>{% render 'vlh-tr', t: filter.label %}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
              <div class="facets__panel">
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="facets__price">
                      <input class="input" type="number" name="{{ filter.min_value.param_name }}" placeholder="{{ 0 | money_without_currency }}"
                        value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" aria-label="min">
                      <input class="input" type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" aria-label="max">
                    </div>
                    <button type="submit" class="button" style="margin-top:12px;min-height:36px;width:100%">{{ 'collections.apply' | t }}</button>
                  {%- else -%}
                    {%- for value in filter.values -%}
                      <label>
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %} data-autosubmit>
                        {% render 'vlh-tr', t: value.label %} <span class="muted">({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <div class="facets__sort">
          <label class="visually-hidden" for="SortBy">{{ 'collections.sort_by' | t }}</label>
          <span class="muted" style="font-size:13px;margin-right:10px">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          <select name="sort_by" id="SortBy" data-autosubmit>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{% render 'vlh-tr', t: option.name %}</option>
            {%- endfor -%}
          </select>
        </div>
      </form>

      {%- assign active_count = 0 -%}
      {%- capture active_pills -%}
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            {%- assign active_count = active_count | plus: 1 -%}
            <a class="pill" href="{{ value.url_to_remove }}">{% render 'vlh-tr', t: value.label %} &times;</a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' and filter.min_value.value != nil or filter.type == 'price_range' and filter.max_value.value != nil -%}
            {%- assign active_count = active_count | plus: 1 -%}
            <a class="pill" href="{{ filter.url_to_remove }}">{% render 'vlh-tr', t: filter.label %} &times;</a>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if active_count > 0 -%}
        <div class="facets__active">{{ active_pills }}<a class="pill" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'collections.clear_all' | t }}</a></div>
      {%- endif -%}

      {%- if collection.products.size > 0 -%}
        <div class="product-grid" style="--cols: {{ section.settings.columns }}" data-product-grid data-total="{{ paginate.items }}">
          {%- comment -%} Productos destacados: se muestran primero (solo sin filtros ni otro orden) con la etiqueta 🔥 {%- endcomment -%}
          {%- liquid
            assign hot = nil
            for block in section.blocks
              if block.type == 'featured' and block.settings.collection.handle == collection.handle and block.settings.products != blank
                assign hot = block
                break
              endif
            endfor
            if hot
              for filter in collection.filters
                if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank
                  assign hot = nil
                  break
                endif
              endfor
              if collection.sort_by != blank and collection.sort_by != collection.default_sort_by
                assign hot = nil
              endif
              if current_tags != blank and current_tags.size > 0
                assign hot = nil
              endif
            endif
            assign hot_ids = ''
            if hot
              for p in hot.settings.products
                assign hot_ids = hot_ids | append: ',' | append: p.id | append: ','
              endfor
            endif
          -%}
          {%- if hot and paginate.current_page == 1 -%}
            {%- for product in hot.settings.products -%}
              {% render 'product-card', product: product, lazy: false, hot: hot.settings.label, in_collection: true %}
            {%- endfor -%}
          {%- endif -%}
          {%- for product in collection.products -%}
            {%- assign pid = ',' | append: product.id | append: ',' -%}
            {%- if hot_ids contains pid -%}{%- continue -%}{%- endif -%}
            {%- if forloop.index <= 4 -%}{% render 'product-card', product: product, lazy: false, in_collection: true %}{%- else -%}{% render 'product-card', product: product, in_collection: true %}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="cart-empty">{{ 'collections.empty' | t }}</p>
      {%- endif -%}

      {%- liquid
        assign all_col = section.settings.all_collection
        assign all_handles = section.settings.all_handles | remove: ' ' | split: ','
        assign show_all = false
        if all_col != blank and all_col.handle != collection.handle and all_handles contains collection.handle
          assign show_all = true
        endif
      -%}
      {%- if paginate.pages > 1 or show_all -%}
        {%- liquid
          assign shown = paginate.current_offset | plus: collection.products.size
          assign pct = shown | times: 100 | divided_by: paginate.items
        -%}
        <div class="load-more" data-load-more>
          {%- if paginate.pages > 1 -%}
            <p class="load-more__count" data-load-more-count>{{ 'collections.showing' | t: shown: shown, total: paginate.items }}</p>
            <div class="load-more__bar"><span data-load-more-bar style="width: {{ pct }}%"></span></div>
          {%- endif -%}
          <div class="load-more__actions">
            {%- if paginate.next -%}
              <a class="button button--outline" href="{{ paginate.next.url }}" data-load-more-btn>{{ 'collections.load_more' | t }}</a>
            {%- endif -%}
            {%- if show_all -%}
              <a class="button" href="{{ all_col.url }}">{{ section.settings.all_label | default: all_col.title }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Mostrar imagen de la colección en cabecera", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Imagen de cabecera (sustituye a la de la colección)" },
    { "type": "checkbox", "id": "show_description", "label": "Mostrar descripción", "default": true },
    { "type": "range", "id": "per_page", "label": "Productos por página", "min": 8, "max": 48, "step": 4, "default": 12 },
    { "type": "range", "id": "columns", "label": "Columnas (escritorio)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "header", "content": "Botón «Ver toda la colección»" },
    { "type": "collection", "id": "all_collection", "label": "Colección completa" },
    { "type": "text", "id": "all_label", "label": "Texto del botón", "default": "Ver toda la colección" },
    { "type": "text", "id": "all_handles", "label": "Mostrar en estas colecciones", "info": "Identificadores separados por comas, p. ej. bosque-encantado, estrellas-y-suenos" }
  ],
  "blocks": [
    {
      "type": "themes",
      "name": "Botones de temática",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "all_label", "label": "Texto del primer botón", "default": "Todas" },
        { "type": "text", "id": "sets_label", "label": "Botón «ver por sets»", "info": "Lleva a la vista de sets (plantilla de colección «sets»). Vacío = sin botón", "default": "🧩 Sets de 3" },
        { "type": "textarea", "id": "themes", "label": "Temáticas", "info": "Una por línea: etiqueta|texto. Ej.: tema-bosque|🦊 Animales del bosque. Los productos se marcan con esa etiqueta en Shopify." }
      ]
    },
    {
      "type": "set",
      "name": "Set de láminas",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "name", "label": "Nombre del set", "default": "La reina de la casa" },
        { "type": "product", "id": "photo_product", "label": "Producto de la foto", "info": "Se usa su última foto (la del set de 3 láminas)" },
        { "type": "product_list", "id": "products", "label": "Láminas del set", "limit": 3 }
      ]
    },
    {
      "type": "featured",
      "name": "Destacados 🔥",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "product_list", "id": "products", "label": "Productos (salen los primeros)", "limit": 8 },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Superventas", "info": "Se muestra con un fueguito 🔥 sobre la foto" }
      ]
    },
    {
      "type": "banner",
      "name": "Portada de una colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "image_picker", "id": "image", "label": "Imagen (ordenador)", "info": "Panorámica con el centro despejado para el texto" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagen (móvil)", "info": "Se muestra encima del texto" },
        {
          "type": "select", "id": "text_position", "label": "Posición del texto (ordenador)",
          "options": [{ "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" }],
          "default": "center"
        },
        { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
        { "type": "textarea", "id": "text", "label": "Texto corto", "info": "Si está vacío, se usa la descripción de la colección" }
      ]
    }
  ]
}
{% endschema %}
