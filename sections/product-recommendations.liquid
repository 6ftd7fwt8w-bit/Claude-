{%- liquid
  assign s = section.settings
  assign intent = s.intent | default: 'related'
-%}
{%- if intent == 'complementary' -%}
  {%- comment -%} "Hacen pack": recomendaciones complementarias de Search & Discovery {%- endcomment -%}
  {%- liquid
    assign in_cross = false
    if settings.cross_code != blank and settings.cross_collection != blank
      for c in product.collections
        if c.handle == settings.cross_collection.handle
          assign in_cross = true
        endif
      endfor
    endif
  -%}
  <section class="section bg-{{ s.background }} pack-recs" data-pack-recs
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent=complementary"
    {% unless recommendations.performed %}hidden{% endunless %}>
    {%- if recommendations.performed -%}
      <div data-pack-fresh>
        {%- for rec in recommendations.products -%}
          {% render 'pack-item', product: rec %}
        {%- endfor -%}
      </div>
    {%- elsif product -%}
      <div class="page-width">
        {%- if s.title != blank -%}<h2 class="section-title">{{ s.title }}</h2>{%- endif -%}
        {%- if s.subtitle != blank -%}<p class="section-subtitle">{{ s.subtitle }}</p>{%- endif -%}
        <div class="pack" data-pack>
          <div class="pack__grid" data-pack-grid>
            {% render 'pack-item', product: product, current: true %}
          </div>
          <div class="pack__buy">
            {%- if in_cross -%}
              <div class="pack__offer" data-pack-offer
                data-need-one="{{ 'products.pack_offer_need_one' | t | escape }}"
                data-need-many="{{ 'products.pack_offer_need_many' | t: count: '[n]' | escape }}"
                data-got="{{ 'products.pack_offer_got' | t: amount: '[amount]' | escape }}">
                <span class="pack__offer-tag">{% render 'icon', name: 'gift' %}{{ 'products.pack_offer_tag' | t }}</span>
                <p class="pack__offer-title" data-pack-offer-title>{{ 'products.pack_offer_title' | t }}</p>
                <p class="pack__offer-text" data-pack-offer-text></p>
                <p class="pack__offer-code">{{ 'products.pack_code_note' | t: code: settings.cross_code }}</p>
              </div>
            {%- endif -%}
            <p class="pack__intro" data-pack-intro>{{ 'products.pack_intro' | t }}</p>
            <div class="pack__lines" data-pack-lines hidden>
              <p class="pack__row" data-pack-sub-row hidden><span>{{ 'products.pack_subtotal' | t }}</span><span data-pack-subtotal></span></p>
              {%- if in_cross -%}
                <p class="pack__row pack__row--save" data-pack-save-row hidden><span data-pack-save-label></span><span data-pack-save></span></p>
              {%- endif -%}
              <p class="pack__row pack__row--total"><span>{{ 'products.pack_total' | t }} · <span data-pack-count></span></span><strong data-pack-total></strong></p>
            </div>
            <button type="button" class="button" data-pack-add hidden
              data-label="{{ 'products.pack_add' | t: count: '[n]' | escape }}"
              data-count-label="{{ 'products.pack_count' | t: count: '[n]' | escape }}"
              data-save-label="{{ 'products.pack_save' | t: code: settings.cross_code, count: '[n]' | escape }}"
              data-code="{{ settings.cross_code | escape }}">{{ 'products.add_to_cart' | t }}</button>
          </div>
        </div>
        <div class="pack__more" data-pack-more hidden></div>
      </div>
    {%- endif -%}
  </section>
{%- else -%}
  <section class="section bg-{{ s.background }}" data-recommendations
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent=related">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="page-width">
        <h2 class="section-title">{{ s.title }}</h2>
        {%- if s.subtitle != blank -%}<p class="section-subtitle">{{ s.subtitle }}</p>{%- endif -%}
        <div class="carousel" data-carousel>
          <button type="button" class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
          <div class="carousel__track" data-carousel-track style="--cols: 4;">
            {%- for rec in recommendations.products -%}
              {% render 'product-card', product: rec %}
            {%- endfor -%}
          </div>
          <button type="button" class="carousel__btn carousel__btn--next" data-carousel-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
        </div>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Productos relacionados",
  "settings": [
    {
      "type": "select", "id": "intent", "label": "Tipo",
      "options": [
        { "value": "related", "label": "Relacionados (también te puede gustar)" },
        { "value": "complementary", "label": "Complementarios (hacen pack)" }
      ],
      "default": "related",
      "info": "Los complementarios se configuran en la app Search & Discovery. Si un producto no tiene, la sección no se muestra."
    },
    { "type": "text", "id": "title", "label": "Título", "default": "También te puede gustar" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" },
    { "type": "range", "id": "limit", "label": "Productos", "min": 2, "max": 10, "step": 1, "default": 8 },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [{ "value": "default", "label": "Crema" }, { "value": "alt", "label": "Arena" }],
      "default": "alt"
    }
  ]
}
{% endschema %}
