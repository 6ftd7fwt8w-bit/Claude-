{%- comment -%}
  Descuentos aplicados en el carrito: una línea dorada discreta por código.
  El de bienvenida dura 24 h desde que se activa en el formulario (theme.js lo quita al caducar).
  El campo para escribir códigos está en el checkout de Shopify.
{%- endcomment -%}
{%- liquid
  assign w_code = settings.welcome_code | strip | upcase
  assign codes_applied = ''
  for item in cart.items
    for alloc in item.line_level_discount_allocations
      if alloc.discount_application.type == 'discount_code' and alloc.amount > 0
        assign t = alloc.discount_application.title | strip | upcase
        assign t_key = '|' | append: t | append: '|'
        assign codes_check = '|' | append: codes_applied
        unless codes_check contains t_key
          assign codes_applied = codes_applied | append: t | append: '|'
        endunless
      endif
    endfor
  endfor
  for app in cart.cart_level_discount_applications
    if app.type == 'discount_code' and app.total_allocated_amount > 0
      assign t = app.title | strip | upcase
      assign t_key = '|' | append: t | append: '|'
      assign codes_check = '|' | append: codes_applied
      unless codes_check contains t_key
        assign codes_applied = codes_applied | append: t | append: '|'
      endunless
    endif
  endfor
  assign codes_list = codes_applied | split: '|'
-%}
{%- if codes_list.size > 0 -%}
  <div class="cart-perk-list">
    {%- for c in codes_list -%}
      <p class="cart-perk">
        <span class="cart-perk__star" aria-hidden="true">✦</span>
        {%- if c == w_code -%}
          <span>Descuento de bienvenida del {{ settings.welcome_percent | default: 10 }}&nbsp;% · <b>válido durante 24&nbsp;h</b></span>
        {%- else -%}
          <span>Código <b>{{ c }}</b> aplicado</span>
        {%- endif -%}
      </p>
    {%- endfor -%}
  </div>
{%- endif -%}
