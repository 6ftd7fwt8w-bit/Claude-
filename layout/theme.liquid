<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- liquid
      assign vlh_title = page_title | split: ' | ' | first | strip
      assign vlh_title_dc = vlh_title | downcase
      assign vlh_shop_dc = shop.name | downcase
    -%}
    <title>
      {{ vlh_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless vlh_title_dc contains vlh_shop_dc %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- liquid
      assign vlh_description = page_description
      if settings.shop_description != blank
        if page_description == blank or page_description == shop.description
          assign vlh_description = settings.shop_description
        endif
      endif
    -%}
    {% if vlh_description %}
      <meta name="description" content="{{ vlh_description | escape }}">
    {% endif %}

    {% render 'meta-tags', description: vlh_description %}

    {%- if request.page_type == 'index' -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "Organization",
              "@id": {{ shop.url | append: '/#organization' | json }},
              "name": {{ shop.name | json }},
              "url": {{ shop.url | json }},
              {%- if settings.logo != blank %}
              "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
              {%- endif %}
              "email": {{ shop.email | json }},
              "sameAs": ["https://www.instagram.com/vivalahome.store/"]
            },
            {
              "@type": "WebSite",
              "@id": {{ shop.url | append: '/#website' | json }},
              "name": {{ shop.name | json }},
              "alternateName": ["Viva la Home", "Vivalahome", "vivalahome.store"],
              "url": {{ shop.url | json }},
              "inLanguage": {{ request.locale.iso_code | json }},
              "publisher": { "@id": {{ shop.url | append: '/#organization' | json }} },
              "potentialAction": {
                "@type": "SearchAction",
                "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},
                "query-input": "required name=search_term_string"
              }
            }
          ]
        }
      </script>
    {%- endif -%}

    {%- case settings.font_pairing -%}
      {%- when 'montserrat' -%}
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
        {%- assign font_body = "'Montserrat', sans-serif" -%}
        {%- assign font_serif = "'Playfair Display', serif" -%}
      {%- when 'dmsans' -%}
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
        {%- assign font_body = "'DM Sans', sans-serif" -%}
        {%- assign font_serif = "'DM Serif Display', serif" -%}
      {%- else -%}
        <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet">
        {%- assign font_body = "'Jost', sans-serif" -%}
        {%- assign font_serif = "'Cormorant Garamond', serif" -%}
    {%- endcase -%}

    {% style %}
      :root {
        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-text: {{ settings.color_accent_text }};
        --color-text: {{ settings.color_text }};
        --color-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --color-muted: {{ settings.color_muted }};
        --color-button: {{ settings.color_button }};
        --color-button-text: {{ settings.color_button_text }};
        --color-highlight: {{ settings.color_highlight }};
        --color-sale: {{ settings.color_sale }};
        --color-border: {{ settings.color_border }};
        --font-body: {{ font_body }};
        --font-serif: {{ font_serif }};
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --logo-width: {{ settings.logo_width }}px;
        {%- case settings.card_ratio -%}
          {%- when 'portrait' -%}--card-ratio: 4 / 5;
          {%- when 'square' -%}--card-ratio: 1 / 1;
          {%- when 'adapt' -%}--card-ratio: auto;
          {%- else -%}--card-ratio: 3 / 4;
        {%- endcase -%}
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if settings.protect_images %} protect-images{% endif %}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {%- if request.page_type == 'index' -%}
        <h1 class="visually-hidden">{{ shop.name }} · Ilustraciones personalizadas a partir de tu foto y láminas infantiles</h1>
      {%- endif -%}
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'discount-state' %}

    <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="{{ 'products.zoom' | t }}">
      <button type="button" class="lightbox__close" data-lightbox-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <figure class="lightbox__stage" data-lightbox-stage><img data-lightbox-img alt="" width="1600" height="1600"></figure>
      <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      <p class="lightbox__count" data-lightbox-count></p>
    </div>

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          added: {{ 'products.added' | t | json }},
          discountInvalid: {{ 'cart.discount_invalid' | t | json }},
          discountPending: {{ 'cart.discount_pending' | t | json }},
          discountValidFor: {{ 'cart.discount_valid_for' | t | json }},
          discountSee: {{ 'cart.discount_see' | t | json }},
          dealToastTitle: {{ 'cart.toast_title' | t | json }},
          dealToastText: {{ 'cart.toast_text' | t: code: settings.welcome_code, percent: settings.welcome_percent | json }},
          dealToastCta: {{ 'cart.toast_cta' | t | json }},
          shipRemaining: {{ 'cart.free_shipping_remaining_html' | t: amount: '[amount]' | json }},
          shipReached: {{ 'cart.free_shipping_reached' | t | json }},
          fabTimer: {{ 'cart.fab_timer' | t: percent: settings.welcome_percent | json }},
          fabShip: {{ 'cart.fab_ship' | t: amount: '[amount]' | json }},
          fabShipFree: {{ 'cart.fab_ship_free' | t | json }}
        },
        freeShipping: {
          threshold: {{ settings.free_shipping_threshold | times: 100 | json }},
          zone: {{ settings.free_shipping_zone | json }}
        }
      };
    </script>
  </body>
</html>
