<div class="customer">
  <h1 class="h2" style="text-align:center;margin-bottom:28px">{{ 'customer.reset_password' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ResetPassword">{{ 'general.password' | t }}</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetConfirm">{{ 'customer.confirm_password' | t }}</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button type="submit" class="button button--full">{{ 'customer.reset_password' | t }}</button>
  {%- endform -%}
</div>
