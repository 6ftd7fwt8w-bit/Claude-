{%- comment -%}
  Nota bajo la descripción de la colección (en vez de repetirla en cada tarjeta):
  - código de bienvenida si la colección es la del descuento de bienvenida
  - 3x2 si es la colección del código cruzado (infantil)
  - «también en lienzo XL» si algún producto de la colección tiene variante de lienzo
{%- endcomment -%}
{%- liquid
  assign note_welcome = false
  if settings.welcome_code != blank and settings.welcome_collection != blank and settings.welcome_collection.handle == collection.handle
    assign note_welcome = true
  endif
  assign note_cross = false
  if note_welcome == false and settings.cross_code != blank and settings.cross_collection != blank and settings.cross_collection.handle == collection.handle
    assign note_cross = true
  endif
  assign note_canvas = false
  for p in collection.products limit: 50
    for v in p.variants
      if v.option1 contains 'Lienzo'
        assign note_canvas = true
        break
      endif
    endfor
    if note_canvas
      break
    endif
  endfor
-%}
{%- if note_welcome or note_cross or note_canvas -%}
  <div class="collection-note">
    {%- if note_welcome or note_cross -%}
    <div class="collection-note__card collection-note__card--deal">
      {%- if note_welcome -%}
        {%- liquid
          assign note_pct = settings.welcome_percent | default: 10
          assign note_max = 0
          for p in collection.products limit: 50
            if p.price_max > note_max
              assign note_max = p.price_max
            endif
          endfor
          assign note_ahorro = note_max | times: note_pct | divided_by: 100
        -%}
        <p class="collection-note__text">Código <span class="collection-note__code">{{ settings.welcome_code }}</span> activo · <strong>{{ note_pct }}&nbsp;% de descuento</strong> en tu ilustración{% if note_ahorro > 0 %} <span class="collection-note__save">(ahorra hasta {{ note_ahorro | money }})</span>{% endif %}</p>
      {%- else -%}
        <p class="collection-note__text">Código <span class="collection-note__code">{{ settings.cross_code }}</span> activo · <strong>3x2</strong> en láminas infantiles</p>
      {%- endif -%}
      <p class="collection-note__small">Aplícalo al realizar el pedido.</p>
    </div>
    {%- endif -%}
    {%- if note_canvas -%}
    <p class="collection-note__canvas">
      <svg class="collection-note__icon" width="18" height="18" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l22-4v28l-22 2z"/><path d="M28 5l5 3v26l-5-1"/><path d="M10 27l6-7 4 4 3-3 4 5" stroke-linecap="round"/></svg>
      <span><strong>También en lienzo XL:</strong> selecciónalo al configurar tu lámina.</span>
    </p>
    {%- endif -%}
  </div>
{%- endif -%}
