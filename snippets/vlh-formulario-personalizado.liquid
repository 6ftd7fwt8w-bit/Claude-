<script>
(function () {
  const form = document.getElementById('vlh-form');
  if (!form) return;

  const els = {
    tamanoInputs: form.querySelectorAll('input[name="vlh-tamano"]'),
    mascotasInputs: form.querySelectorAll('input[name="vlh-mascotas"]'),
    packInputs: form.querySelectorAll('input[name="vlh-pack"]'),
    packRegaloDesc: document.getElementById('vlh-pack-regalo-desc'),
    packValentinaDesc: document.getElementById('vlh-pack-valentina-desc'),
    packRegaloDetails: document.getElementById('vlh-pack-regalo-details'),
    packValentinaDetails: document.getElementById('vlh-pack-valentina-details'),
    packMensajePanel: document.getElementById('vlh-pack-mensaje-panel'),
    tamanoValentinaNota: document.getElementById('vlh-tamano-valentina-nota'),
    tamanoValentinaNotaPack: document.getElementById('vlh-tamano-valentina-nota-pack'),
    marcoObligatorioNota: document.getElementById('vlh-marco-obligatorio-nota'),
    marcoField: document.getElementById('vlh-marco-field'),
    marcoColorGroup: document.getElementById('vlh-marco-color-group'),
    mensajePack: document.getElementById('vlh-mensaje-pack'),
    mensajePackContador: document.getElementById('vlh-mensaje-pack-contador'),
    composicionInputs: form.querySelectorAll('input[name="vlh-composicion"]'),
    composicionPrecio: document.querySelector('[data-composicion-precio]'),
    couponWrap: document.getElementById('vlh-coupon'),
    couponBox: document.getElementById('vlh-coupon-box'),
    couponInput: document.getElementById('vlh-coupon-input'),
    couponApply: document.getElementById('vlh-coupon-apply'),
    couponMsg: document.getElementById('vlh-coupon-msg'),
    couponWin: document.getElementById('vlh-coupon-win'),
    couponDetail: document.getElementById('vlh-coupon-detail'),
    couponRemove: document.getElementById('vlh-coupon-remove'),
    totalOldEl: document.getElementById('vlh-total-old'),
    laminaExtras: form.querySelector('[data-lamina-extras]'),
    packSummary: document.getElementById('vlh-pack-summary'),
    marcoSummary: document.getElementById('vlh-marco-summary'),
    sinFotoToggle: document.getElementById('vlh-sin-foto-toggle'),
    sinFotoDetails: document.getElementById('vlh-sin-foto-details'),
    uploadField: document.getElementById('vlh-upload-field'),
    uploadInput: document.getElementById('vlh-upload-input'),
    descripcion: document.getElementById('vlh-descripcion'),
    fechaEstimadaEl: document.getElementById('vlh-fecha-estimada'),
    totalPriceEl: document.getElementById('vlh-total-price'),
    breakdownEl: document.getElementById('vlh-breakdown'),
    errorEl: document.getElementById('vlh-error'),
    submitBtn: document.getElementById('vlh-submit-btn'),
  };

  // Colores de marco disponibles por tamaño (variantes reales de los
  // productos ocultos vlh-extra-marco-a4 / vlh-extra-marco-a3).
  const MARCO_COLORS = {
    "A4": [
      {% if p_marco_a4 %}{% for v in p_marco_a4.variants %}
      {%- assign vlh_marco_img = v.image | default: p_marco_a4.featured_image -%}
      { id: {{ v.id }}, price: {{ v.price }}, label: {{ v.option1 | json }}, image: {% if vlh_marco_img %}{{ vlh_marco_img | image_url: width: 160 | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
      {% endfor %}{% endif %}
    ],
    "A3": [
      {% if p_marco_a3 %}{% for v in p_marco_a3.variants %}
      {%- assign vlh_marco_img = v.image | default: p_marco_a3.featured_image -%}
      { id: {{ v.id }}, price: {{ v.price }}, label: {{ v.option1 | json }}, image: {% if vlh_marco_img %}{{ vlh_marco_img | image_url: width: 160 | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
      {% endfor %}{% endif %}
    ]
  };

  // Variantes reales del producto (Tamaño x Segunda opción), leídas de Shopify.
  const VARIANTES = [
    {% for v in product.variants %}
    { id: {{ v.id }}, price: {{ v.price }}, tamano: {{ v.option1 | json }}, mascotas: {{ v.option2 | json }} }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const money = (cents) => (cents / 100).toLocaleString('es-ES', { style: 'currency', currency: '{{ cart.currency.iso_code | default: "EUR" }}' });

  function getSelectedTamano() {
    const checked = [...els.tamanoInputs].find(i => i.checked);
    return checked ? checked.value : null;
  }
  function getSelectedMascotas() {
    const checked = [...els.mascotasInputs].find(i => i.checked);
    return checked ? checked.value : null;
  }
  function getVarianteActual() {
    const tamano = getSelectedTamano();
    const mascotas = getSelectedMascotas();
    return VARIANTES.find(v => v.tamano === tamano && v.mascotas === mascotas) || null;
  }
  function getCheckedRadio(list) {
    return [...list].find(i => i.checked) || null;
  }
  function isLienzo() {
    return (getSelectedTamano() || '').indexOf('Lienzo') !== -1;
  }
  function getTamanoCategoria() {
    const tamano = getSelectedTamano() || '';
    if (tamano.indexOf('Lienzo') !== -1) return null;
    if (tamano.indexOf('A4') !== -1) return 'A4';
    if (tamano.indexOf('A3') !== -1) return 'A3';
    return null;
  }

  function syncPreciosVariante() {
    const mascotasActual = getSelectedMascotas();
    els.tamanoInputs.forEach(input => {
      const v = VARIANTES.find(v => v.tamano === input.value && v.mascotas === mascotasActual);
      const el = input.closest('label').querySelector('[data-tamano-precio]');
      if (el && v) el.textContent = money(v.price);
    });
    const tamanoActual = getSelectedTamano();
    els.mascotasInputs.forEach(input => {
      const v = VARIANTES.find(v => v.tamano === tamanoActual && v.mascotas === input.value);
      const el = input.closest('label').querySelector('[data-mascotas-precio]');
      if (!el || !v) return;
      const base = VARIANTES.find(vv => vv.tamano === tamanoActual && vv.mascotas === [...els.mascotasInputs][0].value);
      const diff = base ? v.price - base.price : 0;
      el.textContent = diff > 0 ? `+ ${money(diff)}` : 'sin coste extra';
    });
  }

  function isValentina() {
    const pack = getCheckedRadio(els.packInputs);
    return pack && pack.value === 'valentina';
  }
  function isRegalo() {
    const pack = getCheckedRadio(els.packInputs);
    return pack && pack.value === 'regalo';
  }

  function syncValentinaRules() {
    const valentina = isValentina();
    if (valentina && getTamanoCategoria() === 'A4') {
      const inputA3 = [...els.tamanoInputs].find(i => i.value.indexOf('A3') !== -1);
      if (inputA3) inputA3.checked = true;
    }
    els.tamanoInputs.forEach(input => {
      input.disabled = valentina && input.value.indexOf('A3') === -1;
    });
    if (els.tamanoValentinaNota) els.tamanoValentinaNota.hidden = !valentina;
    if (els.tamanoValentinaNotaPack) els.tamanoValentinaNotaPack.hidden = !valentina;
  }

  let vlhEraValentina = false;

  // Lienzo: llega en bastidor listo para colgar -> sin marco ni packs
  function syncLienzoRules() {
    const lienzo = isLienzo();
    els.packInputs.forEach(input => {
      if (input.value === 'no') return;
      input.disabled = lienzo;
      input.closest('label').classList.toggle('is-disabled', lienzo);
      if (lienzo && input.checked) {
        input.checked = false;
        const no = [...els.packInputs].find(i => i.value === 'no');
        if (no) no.checked = true;
      }
    });
    form.querySelectorAll('[data-canvas-note]').forEach(n => { n.hidden = !lienzo; });
    if (els.laminaExtras) {
      els.laminaExtras.hidden = lienzo;
      if (lienzo) els.laminaExtras.querySelectorAll('details').forEach(d => { d.open = false; });
    }
  }

  function syncPackUI() {
    els.packRegaloDesc.hidden = !isRegalo();
    els.packValentinaDesc.hidden = !isValentina();
    if (els.packRegaloDetails) els.packRegaloDetails.hidden = !isRegalo();
    if (els.packValentinaDetails) els.packValentinaDetails.hidden = !isValentina();
    els.packMensajePanel.hidden = !(isRegalo() || isValentina());
    // Al pasar a Pack Valentina, despliega el acordeón de Marco automáticamente
    // para que quede claro que hay que elegir un acabado (es obligatorio con este pack).
    if (isValentina() && !vlhEraValentina && els.marcoField) {
      els.marcoField.open = true;
    }
    vlhEraValentina = isValentina();
    if (els.packSummary) {
      const tieneAlgo = isRegalo() || isValentina();
      els.packSummary.textContent = isRegalo() ? 'Pack Regalo' : isValentina() ? 'Pack Valentina' : '+';
      els.packSummary.classList.toggle('vlh-accordion__value--empty', !tieneAlgo);
    }
  }

  function getMarcoColorsForSize() {
    return MARCO_COLORS[getTamanoCategoria()] || [];
  }
  function getSelectedMarco() {
    return els.marcoColorGroup.querySelector('input[name="vlh-marco-color"]:checked') || null;
  }
  function renderMarcoColors() {
    if (isLienzo()) { els.marcoColorGroup.innerHTML = ''; return; }
    const colors = getMarcoColorsForSize();
    const valentina = isValentina();
    if (!colors.length) {
      els.marcoColorGroup.innerHTML = `<p class="vlh-hint" style="color:#b32020;margin:0;">No hay acabados de marco disponibles para ${getSelectedTamano()} ahora mismo. Contáctanos antes de completar el pedido.</p>`;
      return;
    }
    const previousLabel = getSelectedMarco()?.dataset.label || null;
    const opciones = valentina ? colors : [{ id: '', price: 0, label: 'Sin marco' }, ...colors];
    els.marcoColorGroup.innerHTML = opciones.map((c, i) => {
      const esSinMarco = c.label === 'Sin marco';
      const checked = previousLabel ? (c.label === previousLabel) : (valentina ? i === 0 : esSinMarco);
      return `
        <label class="vlh-radio-card">
          <input type="radio" name="vlh-marco-color" value="${c.label}"
            data-variant-id="${c.id}" data-price-cents="${c.price}" data-label="${c.label}"
            ${checked ? 'checked' : ''}>
          ${c.image ? `<img class="vlh-radio-card__img" src="${c.image}" alt="${c.label}" loading="lazy" width="56" height="56">` : ''}
          <span class="vlh-radio-card__title">${c.label}</span>
          <span class="vlh-radio-card__price">${c.price > 0 ? '+ ' + money(c.price) : 'incluido'}</span>
        </label>`;
    }).join('');
  }
  function syncMarco() {
    renderMarcoColors();
    els.marcoObligatorioNota.hidden = !isValentina();
    if (els.marcoSummary) {
      const marco = getSelectedMarco();
      const tieneMarco = marco && marco.dataset.label && marco.dataset.label !== 'Sin marco';
      els.marcoSummary.textContent = isLienzo() ? 'No necesita' : (tieneMarco ? marco.dataset.label : '+');
      els.marcoSummary.classList.toggle('vlh-accordion__value--empty', !tieneMarco);
    }
  }

  function necesitaComposicion() {
    const c = getCheckedRadio(els.composicionInputs);
    return c ? c.value === 'si' : false;
  }

  function syncComposicion() {
    if (els.composicionPrecio) {
      const input = [...els.composicionInputs].find(i => i.value === 'si');
      if (input && input.dataset.priceCents) {
        els.composicionPrecio.textContent = `+ ${money(parseInt(input.dataset.priceCents, 10))}`;
      }
    }
  }

  function syncFotosUI() {
    const sinFoto = els.sinFotoToggle.checked;
    els.sinFotoDetails.hidden = !sinFoto;
    if (sinFoto) {
      els.uploadInput.hidden = true;
      els.uploadInput.required = false;
    } else {
      els.uploadInput.hidden = false;
      els.uploadInput.required = true;
    }
  }

  // ---------------- FECHA DE ENTREGA ESTIMADA (solo informativo) ----------------
  function formatFecha(d) {
    return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
  }
  function initFechaEstimada() {
    const hoy = new Date();
    const desde = new Date(hoy); desde.setDate(desde.getDate() + 15);
    const hasta = new Date(hoy); hasta.setDate(hasta.getDate() + 20);
    const mes = (d) => d.toLocaleDateString('es-ES', { month: 'long' });
    els.fechaEstimadaEl.textContent = desde.getMonth() === hasta.getMonth()
      ? `del ${desde.getDate()} al ${hasta.getDate()} de ${mes(hasta)}`
      : `del ${desde.getDate()} de ${mes(desde)} al ${hasta.getDate()} de ${mes(hasta)}`;
    els.fechaEstimadaEl.dataset.rango = `${formatFecha(desde)} - ${formatFecha(hasta)}`;
  }

  // ---------------- CÓDIGO DE DESCUENTO ----------------
  let coupon = null; // { code, percent }  (percent = null si no conocemos el importe)
  const WELCOME_CODE = (els.couponWrap && els.couponWrap.dataset.welcomeCode || '').toUpperCase();
  const WELCOME_PCT = parseInt(els.couponWrap && els.couponWrap.dataset.welcomePercent, 10) || 0;

  function setCoupon(code, silent) {
    code = String(code || '').trim().toUpperCase();
    if (!code) return;
    els.couponMsg.hidden = true;
    els.couponMsg.classList.remove('is-ok');
    if (WELCOME_CODE && code === WELCOME_CODE) {
      coupon = { code, percent: WELCOME_PCT };
      els.couponWin.hidden = false;
      els.couponBox.hidden = true;
    } else {
      // Otros códigos: los guardamos y Shopify los valida en el carrito
      coupon = { code, percent: null };
      if (!silent) {
        els.couponMsg.textContent = `Código ${code} guardado: lo aplicamos al añadir al carrito y verás el descuento allí si es válido para este producto.`;
        els.couponMsg.classList.add('is-ok');
        els.couponMsg.hidden = false;
      }
    }
    calcTotal();
  }
  function clearCoupon() {
    coupon = null;
    els.couponWin.hidden = true;
    els.couponBox.hidden = false;
    els.couponInput.value = '';
    els.couponMsg.hidden = true;
    calcTotal();
  }
  if (els.couponWrap) {
    els.couponApply.addEventListener('click', () => {
      if (!els.couponInput.value.trim()) {
        els.couponMsg.textContent = 'Escribe tu código.';
        els.couponMsg.classList.remove('is-ok');
        els.couponMsg.hidden = false;
        return;
      }
      setCoupon(els.couponInput.value);
    });
    els.couponInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); els.couponApply.click(); } });
    els.couponRemove.addEventListener('click', clearCoupon);
    // Si ya aceptó el código de bienvenida (pop-up), lo aplicamos directamente
    try {
      const w = JSON.parse(localStorage.getItem('vlh_welcome') || '{}');
      if (WELCOME_CODE && w.status === 'accepted' && w.expires > Date.now()) {
        els.couponInput.value = WELCOME_CODE;
        setCoupon(WELCOME_CODE, true);
      }
    } catch (e) {}
  }

  function calcTotal() {
    let total = 0;
    const lines = [];

    const variante = getVarianteActual();
    if (variante) {
      total += variante.price;
      lines.push([`${isLienzo() ? '' : 'Ilustración '}${variante.tamano}${variante.mascotas ? ' (' + variante.mascotas + ')' : ''}`, variante.price]);
    }

    const pack = getCheckedRadio(els.packInputs);
    if (pack && pack.dataset.priceCents) {
      const cents = parseInt(pack.dataset.priceCents, 10);
      total += cents;
      lines.push([pack.value === 'regalo' ? 'Pack Regalo' : 'Pack Valentina', cents]);
    }

    const marco = getSelectedMarco();
    if (marco && marco.dataset.priceCents && parseInt(marco.dataset.priceCents, 10) > 0) {
      const cents = parseInt(marco.dataset.priceCents, 10);
      total += cents;
      lines.push([`Marco ${marco.dataset.label}`, cents]);
    }

    if (necesitaComposicion()) {
      const composicion = getCheckedRadio(els.composicionInputs);
      if (composicion && composicion.dataset.priceCents) {
        const cents = parseInt(composicion.dataset.priceCents, 10);
        total += cents;
        lines.push(['Varias fotografías', cents]);
      }
    }

    // Código de descuento (solo sobre la ilustración, como en Shopify)
    let ahorro = 0;
    if (coupon && coupon.percent && variante) {
      ahorro = Math.round(variante.price * coupon.percent / 100);
    }
    const final = total - ahorro;
    els.totalPriceEl.textContent = money(final);
    if (els.totalOldEl) {
      els.totalOldEl.hidden = !ahorro;
      els.totalOldEl.textContent = ahorro ? money(total) : '';
    }
    els.totalPriceEl.closest('.vlh-summary').classList.toggle('has-discount', ahorro > 0);
    let html = lines.map(([label, cents]) => `<li><span>${label}</span><span>${money(cents)}</span></li>`).join('');
    if (ahorro) html += `<li class="is-discount"><span>Descuento ${coupon.code} (−${coupon.percent} %)</span><span>−${money(ahorro)}</span></li>`;
    els.breakdownEl.innerHTML = (lines.length > 1 || ahorro) ? html : '';
    els.breakdownEl.hidden = !(lines.length > 1 || ahorro);
    if (coupon && els.couponDetail) {
      els.couponDetail.innerHTML = ahorro
        ? `Código <b>${coupon.code}</b> aplicado · te ahorras <strong>${money(ahorro)}</strong>`
        : `Código <b>${coupon.code}</b> guardado: se aplicará en el carrito`;
    }
  }

  function syncAll() {
    if (els.errorEl) els.errorEl.hidden = true;
    const pasos = [syncPreciosVariante, syncValentinaRules, syncLienzoRules, syncPackUI, syncMarco, syncComposicion, syncFotosUI, calcTotal];
    pasos.forEach((fn) => { try { fn(); } catch (e) { console.error('Error en ' + fn.name + ':', e); } });
  }

  // Enlaces de campaña: ?tamano=70x100 preselecciona ese tamaño (p. ej. un lienzo)
  try {
    const pedido = new URLSearchParams(window.location.search).get('tamano');
    if (pedido) {
      const clave = pedido.toLowerCase().replace(/\s/g, '');
      const input = [...els.tamanoInputs].find(i => i.value.toLowerCase().replace(/\s/g, '').indexOf(clave) !== -1);
      if (input) input.checked = true;
    }
  } catch (e) {}

  // Guía de tamaños (ventana)
  const guide = form.querySelector('[data-size-guide]');
  if (guide) {
    form.querySelector('[data-size-guide-open]').addEventListener('click', () => { if (guide.showModal) guide.showModal(); else guide.setAttribute('open', ''); });
    guide.querySelector('[data-size-guide-close]').addEventListener('click', () => guide.close ? guide.close() : guide.removeAttribute('open'));
    guide.addEventListener('click', (e) => { if (e.target === guide && guide.close) guide.close(); });
  }

  initFechaEstimada();
  form.addEventListener('change', syncAll);
  els.mensajePack.addEventListener('input', () => {
    const palabras = els.mensajePack.value.split(/\s+/).filter(Boolean);
    if (palabras.length > 10) els.mensajePack.value = palabras.slice(0, 10).join(' ');
    const total = els.mensajePack.value.split(/\s+/).filter(Boolean).length;
    els.mensajePackContador.textContent = `${total} / 10 palabras`;
  });
  syncAll();

  // ---------------- ENVÍO ----------------
  function collectAddons() {
    const addons = [];
    const pack = getCheckedRadio(els.packInputs);
    if (pack && pack.dataset.variantId) addons.push({ id: parseInt(pack.dataset.variantId, 10), quantity: 1 });

    const marco = getSelectedMarco();
    if (marco && marco.dataset.variantId) addons.push({ id: parseInt(marco.dataset.variantId, 10), quantity: 1 });

    if (necesitaComposicion()) {
      const composicion = getCheckedRadio(els.composicionInputs);
      if (composicion && composicion.dataset.variantId) {
        addons.push({ id: parseInt(composicion.dataset.variantId, 10), quantity: 1 });
      }
    }
    return addons;
  }

  function showError(msg) {
    els.errorEl.textContent = msg;
    els.errorEl.hidden = false;
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    els.errorEl.hidden = true;

    const variante = getVarianteActual();
    if (!variante) {
      showError(els.mascotasInputs.length > 0 ? 'Selecciona el tamaño y la otra opción disponible.' : 'Selecciona un tamaño.');
      return;
    }
    if (isValentina() && (!getSelectedMarco() || getSelectedMarco().dataset.label === 'Sin marco')) {
      showError('El Pack Valentina requiere elegir un acabado de marco.');
      return;
    }
    if (!els.sinFotoToggle.checked && (!els.uploadInput.files || els.uploadInput.files.length === 0)) {
      showError('Sube al menos una foto, o marca "La enviaré después".');
      return;
    }

    els.submitBtn.disabled = true;
    els.submitBtn.querySelector('.vlh-submit__text').textContent = 'Añadiendo…';

    try {
      const mainData = new FormData();
      mainData.append('id', variante.id);
      mainData.append('quantity', 1);
      mainData.append('properties[¿Tiene la foto?]', els.sinFotoToggle.checked ? 'La enviará más adelante' : 'Sí, adjunta');
      mainData.append('properties[Fecha de entrega estimada]', els.fechaEstimadaEl.dataset.rango || '');

      if (els.descripcion.value.trim()) {
        mainData.append('properties[Cómo quiere su lámina]', els.descripcion.value.trim());
      }
      if ((isRegalo() || isValentina()) && els.mensajePack.value.trim()) {
        mainData.append('properties[Mensaje para la tapa del pack]', els.mensajePack.value.trim());
      }
      if (!els.sinFotoToggle.checked && els.uploadInput.files.length) {
        [...els.uploadInput.files].forEach((file, i) => {
          mainData.append(`properties[Foto ${i + 1}]`, file);
        });
      }

      const mainRes = await fetch('/cart/add.js', { method: 'POST', body: mainData });
      if (!mainRes.ok) {
        const err = await mainRes.json().catch(() => ({}));
        throw new Error(err.description || 'No se pudo añadir la lámina al carrito.');
      }

      const addons = collectAddons();
      if (addons.length) {
        const addonsRes = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: addons }),
        });
        if (!addonsRes.ok) {
          const err = await addonsRes.json().catch(() => ({}));
          throw new Error(err.description || 'No se pudieron añadir los extras al carrito.');
        }
      }

      // Código de descuento: se guarda en el carrito para que Shopify lo aplique
      if (coupon && coupon.code) {
        try {
          if (window.vivaAddDiscountCode) await window.vivaAddDiscountCode(coupon.code);
          else await fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ discount: coupon.code }) });
        } catch (e) {}
      }

      // Abre el carrito lateral (si el tema lo tiene) en lugar de ir a la página del carrito
      if (window.vivaCartAdded) {
        window.vivaCartAdded();
        els.submitBtn.disabled = false;
        els.submitBtn.querySelector('.vlh-submit__text').textContent = 'Añadir al carrito';
      } else {
        window.location.href = '/cart';
      }
    } catch (err) {
      showError(err.message || 'Ha ocurrido un error. Inténtalo de nuevo.');
      els.submitBtn.disabled = false;
      els.submitBtn.querySelector('.vlh-submit__text').textContent = 'Añadir al carrito';
    }
  });
})();
</script>