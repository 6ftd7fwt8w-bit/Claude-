{%- comment -%}
  Apartado de código de descuento en el carrito (página y panel lateral).
  Si hay descuentos aplicados muestra una tarjeta de celebración con el ahorro real.
{%- endcomment -%}
{%- liquid
  assign codes_applied = ''
  for item in cart.items
    for alloc in item.line_level_discount_allocations
      if alloc.discount_application.type == 'discount_code'
        assign t = alloc.discount_application.title
        unless codes_applied contains t
          assign codes_applied = codes_applied | append: t | append: '|'
        endunless
      endif
    endfor
  endfor
  for app in cart.cart_level_discount_applications
    if app.type == 'discount_code'
      assign t = app.title
      unless codes_applied contains t
        assign codes_applied = codes_applied | append: t | append: '|'
      endunless
    endif
  endfor
  assign codes_list = codes_applied | split: '|'
  assign w_code = settings.welcome_code | strip | upcase
  assign saving_cents = cart.original_total_price | minus: cart.total_price
  if saving_cents < cart.total_discount
    assign saving_cents = cart.total_discount
  endif
  assign saving_formatted = saving_cents | money
-%}
<div class="cart-discount" data-cart-discount>
  {%- if saving_cents > 0 -%}
    <div class="deal-card">
      <span class="deal-card__shine" aria-hidden="true"></span>
      <span class="deal-card__icon" aria-hidden="true">{% render 'icon', name: 'gift' %}</span>
      <div class="deal-card__body">
        <strong class="deal-card__title">
          {%- assign first_code = codes_list.first | upcase -%}
          {%- if first_code == w_code -%}
            {{ 'cart.deal_title_percent' | t: percent: settings.welcome_percent }}
          {%- else -%}
            {{ 'cart.deal_title' | t }}
          {%- endif -%}
        </strong>
        <span class="deal-card__text">{{ 'cart.deal_saving_html' | t: amount: saving_formatted }}</span>
        {%- if first_code == w_code and settings.welcome_collection != blank -%}
          <a class="deal-card__more" href="{{ settings.welcome_collection.url }}">{{ 'cart.deal_more' | t: percent: settings.welcome_percent }} <span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
        <span class="deal-card__codes">
          {%- for c in codes_list -%}
            <span class="deal-card__code">{{ c }} <button type="button" data-discount-remove aria-label="{{ 'cart.discount_remove' | t }}">&times;</button></span>
          {%- endfor -%}
        </span>
      </div>
    </div>
    <div class="cart-totals muted" style="font-size:13px"><span>{{ 'cart.before' | t }}</span><s>{{ cart.original_total_price | money }}</s></div>
  {%- else -%}
    <form class="cart-discount__form" data-discount-form novalidate>
      <label class="cart-discount__label" for="DiscountCode-{{ form_id | default: 'cart' }}">{% render 'icon', name: 'gift' %}<span>{{ 'cart.discount_label' | t }}</span></label>
      <div class="cart-discount__row">
        <input class="input" type="text" id="DiscountCode-{{ form_id | default: 'cart' }}" name="discount" autocomplete="off" autocapitalize="characters" spellcheck="false"
          placeholder="{{ 'cart.discount_placeholder' | t }}" data-discount-input>
        <button type="submit" class="button cart-discount__apply">{{ 'cart.discount_apply' | t }}</button>
      </div>
      <p class="cart-discount__msg" data-discount-msg hidden></p>
      <p class="cart-discount__hint" data-discount-hint hidden>
        {%- assign code_html = '<strong>' | append: settings.welcome_code | append: '</strong>' -%}
        {{ 'cart.discount_waiting_html' | t: code: code_html, percent: settings.welcome_percent }}
        {%- if settings.welcome_collection != blank %} <a href="{{ settings.welcome_collection.url }}">{{ 'cart.discount_waiting_link' | t }}</a>{%- endif -%}
      </p>
    </form>
  {%- endif -%}
</div>
