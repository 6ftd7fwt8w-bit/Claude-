{%- comment -%}
  Reseñas de Judge.me pintadas por el tema (las del carrusel de Judge.me no enseñan las fotos de las clientas
  ni dejan ordenar). Lee la API pública de Judge.me (tienda + productos), pone primero las que tienen foto y
  luego las más recientes, y no muestra el número de reseñas. La media («★★★★★ 5 · Valoración media») solo sale con más de 20 reseñas.
  mode: 'mini'  → una reseña cada vez, compacta (configurador, bajo «Tu ilustración, en solo 3 pasos»)
        'cards' → fila deslizable de tarjetas (portada)
        'list'  → todas en rejilla + botón «Escribir una reseña» (bajo el configurador)
{%- endcomment -%}
{%- assign vr_mode = mode | default: 'cards' -%}
<div class="vrv vrv--{{ vr_mode }}" data-vlh-reviews data-mode="{{ vr_mode }}" data-shop="{{ shop.permanent_domain }}" hidden>
  <p class="vrv__score" data-vrv-score hidden><span class="vrv__score-stars" aria-hidden="true">★★★★★</span> <b data-vrv-avg></b><span class="vrv__score-label"> · Valoración media</span></p>
  <div class="vrv__track" data-vrv-track></div>
  {%- if vr_mode != 'list' -%}
    <div class="vrv__nav">
      <button type="button" class="vrv__arrow" data-vrv-prev aria-label="Reseña anterior">&#8249;</button>
      <span class="vrv__dots" data-vrv-dots></span>
      <button type="button" class="vrv__arrow" data-vrv-next aria-label="Reseña siguiente">&#8250;</button>
    </div>
  {%- endif -%}
  {%- if vr_mode != 'mini' -%}
    <p class="vrv__legal">Opiniones recogidas con Judge.me (plataforma externa de reseñas para tiendas online), sin filtrar por puntuación ni modificar.</p>
  {%- endif -%}
  {%- if write_url != blank -%}
    <p class="vrv__write"><a class="button button--outline" href="{{ write_url }}">{{ write_label | default: 'Escribir una reseña' }}</a></p>
  {%- endif -%}
</div>

<script>
  (function () {
    if (window.vlhReviews) { window.vlhReviews.init(); return; }
    var cache = null;
    function load(shop) {
      if (cache) return cache;
      var key = 'vlh_reviews_v4';
      try { var c = JSON.parse(sessionStorage.getItem(key) || 'null'); if (c && Date.now() - c.t < 600000) { cache = Promise.resolve(c.r); return cache; } } catch (e) {}
      var base = 'https://cdn.judge.me/reviews/all_reviews_js_based?widget_type=review-widget&sort_by=created_at&sort_dir=desc&platform=shopify&shop_domain=' + encodeURIComponent(shop) + '&review_type=';
      // Judge.me devuelve 5 por página: se piden todas las páginas
      var page = function (t, n) { return fetch(base + t + '&page=' + n).then(function (r) { return r.ok ? r.json() : {}; }).catch(function () { return {}; }); };
      var get = function (t) {
        return page(t, 1).then(function (d) {
          var total = Math.min((d.pagination && d.pagination.total_pages) || 1, 30), reqs = [];
          for (var i = 2; i <= total; i++) reqs.push(page(t, i));
          return Promise.all(reqs).then(function (rest) { return rest.reduce(function (a, x) { return a.concat(x.reviews || []); }, d.reviews || []); });
        });
      };
      cache = Promise.all([get('shop-reviews'), get('product-reviews')]).then(function (a) {
        var seen = {}, all = [];
        a[0].concat(a[1]).forEach(function (r) {
          if (!r || seen[r.uuid]) return; seen[r.uuid] = 1;
          var pics = (r.pictures_urls || []).map(function (p) { return { s: p.compact || p.small || p.original, l: p.huge || p.original }; });
          all.push({ n: r.reviewer_name || '', b: (r.body || '').trim(), st: r.rating || 0, v: !!r.verified_buyer, p: pics, d: r.created_at || '' });
        });
        all.sort(function (x, y) { return (y.p.length ? 1 : 0) - (x.p.length ? 1 : 0) || (y.d > x.d ? 1 : y.d < x.d ? -1 : 0); });
        try { sessionStorage.setItem(key, JSON.stringify({ t: Date.now(), r: all })); } catch (e) {}
        return all;
      });
      return cache;
    }
    function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
    // Visor de fotos a pantalla completa (flechas, deslizar, Esc)
    var lb = null;
    function lightbox(pics, i, name) {
      if (!lb) {
        lb = el('div', 'vrv-lb'); lb.setAttribute('role', 'dialog'); lb.setAttribute('aria-modal', 'true');
        lb.innerHTML = '<button type="button" class="vrv-lb__close" aria-label="Cerrar">×</button><button type="button" class="vrv-lb__nav vrv-lb__prev" aria-label="Foto anterior">‹</button><img class="vrv-lb__img" alt=""><button type="button" class="vrv-lb__nav vrv-lb__next" aria-label="Foto siguiente">›</button><span class="vrv-lb__count"></span>';
        document.body.appendChild(lb);
        var x0 = null;
        lb.addEventListener('click', function (e) { if (e.target === lb || e.target.classList.contains('vrv-lb__close')) close(); });
        lb.querySelector('.vrv-lb__prev').onclick = function () { lb._go(-1); };
        lb.querySelector('.vrv-lb__next').onclick = function () { lb._go(1); };
        lb.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
        lb.addEventListener('touchend', function (e) { if (x0 == null) return; var dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) lb._go(dx < 0 ? 1 : -1); x0 = null; });
        document.addEventListener('keydown', function (e) { if (lb.hidden) return; if (e.key === 'Escape') close(); if (e.key === 'ArrowRight') lb._go(1); if (e.key === 'ArrowLeft') lb._go(-1); });
      }
      function close() { lb.hidden = true; document.documentElement.style.overflow = ''; }
      var cur = i;
      lb._go = function (d) { cur = (cur + d + pics.length) % pics.length; paint(); };
      function paint() {
        var img = lb.querySelector('.vrv-lb__img'); img.src = pics[cur].l; img.alt = 'Foto ' + (cur + 1) + ' de ' + name;
        lb.querySelector('.vrv-lb__count').textContent = pics.length > 1 ? (cur + 1) + ' / ' + pics.length : '';
        lb.querySelectorAll('.vrv-lb__nav').forEach(function (b) { b.hidden = pics.length < 2; });
      }
      paint(); lb.hidden = false; document.documentElement.style.overflow = 'hidden';
    }
    function card(r, mode) {
      var c = el('figure', 'vrv__card' + (r.p.length ? ' has-photo' : '') + (r.p.length > 1 ? ' has-photos' : ''));
      var thumb = function (p, i, cls) {
        var b = el('button', cls); b.type = 'button'; b.setAttribute('aria-label', 'Ver foto ' + (i + 1) + ' de ' + r.n);
        var img = el('img'); img.src = mode === 'mini' ? p.s : p.l.replace('width=1024', 'width=240'); img.alt = ''; img.loading = 'lazy';
        b.appendChild(img); b.onclick = function () { lightbox(r.p, i, r.n); }; return b;
      };
      if (r.p.length && mode === 'mini') {
        // Miniatura que va pasando sola por las fotos de la reseña
        var ph = el('div', 'vrv__photo');
        r.p.forEach(function (p, i) { var t = thumb(p, i, 'vrv__slide' + (i ? '' : ' is-on')); ph.appendChild(t); });
        if (r.p.length > 1) {
          ph.appendChild(el('span', 'vrv__pcount', r.p.length + ' fotos'));
          var k = 0; setInterval(function () { if (document.hidden) return; var sl = ph.querySelectorAll('.vrv__slide'); sl[k].classList.remove('is-on'); k = (k + 1) % sl.length; sl[k].classList.add('is-on'); }, 2200);
        }
        c.appendChild(ph);
      }
      var body = el('figcaption', 'vrv__body');
      if (r.p.length && mode !== 'mini') {
        var g = el('div', 'vrv__gallery');
        r.p.forEach(function (p, i) { g.appendChild(thumb(p, i, 'vrv__thumb')); });
        body.appendChild(g);
      }
      var stars = el('span', 'vrv__stars'); stars.setAttribute('aria-label', r.st + ' de 5 estrellas');
      stars.appendChild(document.createTextNode('★★★★★'.slice(0, r.st)));
      if (r.st < 5) stars.appendChild(el('span', 'vrv__stars-off', '★★★★★'.slice(0, 5 - r.st)));
      body.appendChild(stars);
      body.appendChild(el('blockquote', 'vrv__text', r.b));
      var who = el('cite', 'vrv__name', r.n);
      if (r.v) who.appendChild(el('span', 'vrv__verified', '✓ Compra verificada'));
      body.appendChild(who);
      c.appendChild(body);
      return c;
    }
    function build(box, list) {
      var mode = box.dataset.mode, track = box.querySelector('[data-vrv-track]');
      track.innerHTML = '';
      list.forEach(function (r) { track.appendChild(card(r, mode)); });
      box.hidden = false;
      if (mode !== 'mini') requestAnimationFrame(function () {
        track.querySelectorAll('.vrv__text').forEach(function (t) {
          if (t.scrollHeight <= t.clientHeight + 2) return;
          var more = el('button', 'vrv__more', 'Leer más'); more.type = 'button';
          more.onclick = function () { var o = t.classList.toggle('is-open'); more.textContent = o ? 'Leer menos' : 'Leer más'; };
          t.after(more);
        });
      });
      var rated = list.filter(function (r) { return r.st > 0; });
      if (rated.length > 20) {
        var avg = rated.reduce(function (a, r) { return a + r.st; }, 0) / rated.length;
        var a1 = Math.round(avg * 10) / 10; box.querySelector('[data-vrv-avg]').textContent = a1 % 1 ? a1.toFixed(1).replace('.', ',') : String(a1);
        box.querySelector('[data-vrv-score]').hidden = false;
      }
      box.hidden = false;
      if (mode === 'list') {
        // Se ven las primeras 4; «Ver más reseñas» enseña 4 más cada vez
        var STEP = 4, all = [].slice.call(track.children), shown = STEP;
        if (all.length <= STEP) return;
        var btn = el('button', 'button button--outline vrv__seemore', 'Ver más reseñas'); btn.type = 'button';
        var show = function () { all.forEach(function (c, i) { c.hidden = i >= shown; }); btn.hidden = shown >= all.length; };
        btn.onclick = function () { shown += STEP; show(); };
        var wrap = el('p', 'vrv__seemore-wrap'); wrap.appendChild(btn); track.after(wrap);
        show();
        return;
      }
      var dots = box.querySelector('[data-vrv-dots]'), cards = track.children;
      var perView = function () { return Math.max(1, Math.round(track.clientWidth / (cards[0] ? cards[0].getBoundingClientRect().width : 1))); };
      var pages = function () { return Math.max(1, cards.length - perView() + 1); };
      var idx = function () { return cards[0] ? Math.round(track.scrollLeft / (cards[0].getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 0))) : 0; };
      var go = function (i) { var n = pages(); i = (i + n) % n; var w = cards[0].getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 0); track.scrollTo({ left: i * w, behavior: 'smooth' }); };
      var paint = function () {
        var n = pages(), cur = Math.min(idx(), n - 1);
        if (dots.children.length !== n) { dots.innerHTML = ''; for (var i = 0; i < n; i++) { var d = el('i'); dots.appendChild(d); } }
        [].forEach.call(dots.children, function (d, i) { d.classList.toggle('is-on', i === cur); });
        box.classList.toggle('vrv--single', n < 2);
      };
      box.querySelector('[data-vrv-prev]').onclick = function () { go(idx() - 1); stop(); };
      box.querySelector('[data-vrv-next]').onclick = function () { go(idx() + 1); stop(); };
      track.addEventListener('scroll', function () { clearTimeout(track._t); track._t = setTimeout(paint, 80); }, { passive: true });
      window.addEventListener('resize', paint);
      var timer = null, stop = function () { clearInterval(timer); timer = null; };
      if (mode === 'mini' && cards.length > 1) {
        timer = setInterval(function () { if (!document.hidden) go(idx() + 1); }, 6000);
        track.addEventListener('pointerdown', stop, { once: true });
      }
      paint();
    }
    window.vlhReviews = {
      init: function () {
        document.querySelectorAll('[data-vlh-reviews]:not([data-ready])').forEach(function (box) {
          box.setAttribute('data-ready', '');
          load(box.dataset.shop).then(function (list) {
            if (!list.length) return;
            var max = +box.dataset.max || 0;
            build(box, max ? list.slice(0, max) : list);
          });
        });
      }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', window.vlhReviews.init); else window.vlhReviews.init();
  })();
</script>
