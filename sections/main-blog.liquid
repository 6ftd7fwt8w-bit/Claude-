<section class="section">
  <div class="page-width">
    <h1 class="section-title" style="font-size:15px">{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      <div class="tile-grid" style="--cols:3; --tile-ratio: 4 / 3;">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="tile" style="text-align:left">
            <div class="media">
              {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 700, 900', sizes: '(min-width: 990px) 33vw, 90vw' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </div>
            <span class="tile__subtitle" style="margin-top:14px">{{ article.published_at | date: format: 'date' }}</span>
            <h2 class="h3" style="margin-top:4px">{{ article.title }}</h2>
            <p class="muted" style="font-size:14px;margin-top:6px">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog" }
{% endschema %}
