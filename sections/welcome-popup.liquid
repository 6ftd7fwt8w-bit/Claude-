{%- comment -%}
  Pop-up de bienvenida con código de descuento (código, colección y % en Configuración del tema → Descuento de bienvenida).
  - Aparece una vez por visitante (se vuelve a mostrar tras X días si lo cierra sin aceptar).
  - Al aceptar, guarda el código en el carrito (/discount/CODIGO) y deja al cliente en la misma página (p. ej. la portada).
  - Pastilla inferior con dos estados reales (calculados por Shopify):
      · esperando: aún no hay productos de la colección en el carrito
      · aplicado: el código ya descuenta dinero → muestra el ahorro
    y cuenta atrás del tiempo que se lo guardamos aplicado (al terminar se quita del carrito).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign w_code = settings.welcome_code | strip
  assign redirect_path = s.link | default: settings.welcome_collection.url | default: routes.all_products_collection_url
  assign apply_url = routes.root_url | append: '/discount/' | append: w_code | replace: '//', '/' | append: '?redirect=' | append: request.path
-%}
{%- if s.enabled and w_code != blank -%}
<div class="welcome" data-welcome
  data-code="{{ w_code | escape }}" data-apply-url="{{ apply_url }}"
  data-delay="{{ s.delay }}" data-minutes="{{ s.minutes }}" data-repeat-days="{{ s.repeat_days }}"
  data-design-mode="{{ request.design_mode }}" hidden>
  <div class="welcome__overlay" data-welcome-close></div>
  <div class="welcome__dialog" role="dialog" aria-modal="true" aria-labelledby="WelcomeTitle-{{ section.id }}">
    <button type="button" class="welcome__close" data-welcome-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <div class="welcome__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 700, 1000', sizes: '(min-width: 750px) 380px, 100vw', alt: '' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="welcome__body">
      {%- if s.tag != blank -%}<span class="tag-highlight script welcome__tag">{{ s.tag }}</span>{%- endif -%}
      <h2 class="welcome__title" id="WelcomeTitle-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<div class="welcome__text rte">{{ s.text }}</div>{%- endif -%}
      <div class="welcome__code">
        <span class="welcome__code-label">{{ s.code_label }}</span>
        <span class="welcome__code-value">{{ w_code }}</span>
      </div>
      <a href="{{ apply_url }}" class="button button--full welcome__cta" data-welcome-accept>{{ s.button_label }}</a>
      <button type="button" class="welcome__decline" data-welcome-close>{{ s.decline_label }}</button>
      {%- if s.small_print != blank -%}<p class="welcome__small">{{ s.small_print }}</p>{%- endif -%}
    </div>
  </div>
</div>

<div class="welcome-badge" data-welcome-badge hidden role="status" aria-live="polite"
  data-wait-title="{{ s.badge_wait_title | replace: '[code]', w_code | escape }}"
  data-wait-text="{{ s.badge_wait_text | escape }}"
  data-ok-title="{{ s.badge_ok_title | replace: '[code]', w_code | escape }}"
  data-ok-text="{{ s.badge_ok_text | escape }}"
  data-max-title="{{ s.badge_max_title | escape }}"
  data-max-text="{{ s.badge_max_text | escape }}"
  data-cross-title="{{ s.badge_cross_title | escape }}"
  data-cross-text="{{ s.badge_cross_text | escape }}"
  data-wait-url="{{ redirect_path }}" data-ok-url="{{ routes.cart_url }}">
  <a class="welcome-badge__main" href="{{ redirect_path }}" data-badge-link>
    <span class="welcome-badge__icon">{% render 'icon', name: 'gift' %}<span class="welcome-badge__sparkle" aria-hidden="true">✦</span></span>
    <span class="welcome-badge__text">
      <strong data-badge-title>{{ s.badge_wait_title | replace: '[code]', w_code }}</strong>
      <span data-badge-text>{{ s.badge_wait_text }}</span>
      <span class="welcome-badge__timer-line">{{ s.badge_timer_text }} <b class="welcome-badge__timer" data-welcome-timer>--:--</b></span>
    </span>
    <span class="welcome-badge__shine" aria-hidden="true"></span>
  </a>
  <button type="button" class="welcome-badge__close" data-welcome-badge-hide aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Pop-up de bienvenida",
  "class": "section-welcome",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Activar pop-up", "default": true },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "tag", "label": "Etiqueta", "default": "¡Hola!" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Nos alegra mucho verte por aquí" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Para tu primera compra te regalamos un <strong>10 % de descuento</strong> en nuestras ilustraciones personalizadas.</p>" },
    { "type": "text", "id": "code_label", "label": "Texto sobre el código", "default": "Tu código" },
    { "type": "paragraph", "content": "El código, la colección y el % se configuran en Configuración del tema → Descuento de bienvenida." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "¡Sí, lo quiero!" },
    { "type": "url", "id": "link", "label": "Enlace de la pastilla del descuento", "info": "Si está vacío, lleva a la colección del descuento. Al aceptar el pop-up, el cliente se queda en la página en la que estaba." },
    { "type": "text", "id": "decline_label", "label": "Texto para rechazar", "default": "Ahora no, gracias" },
    { "type": "text", "id": "small_print", "label": "Letra pequeña", "default": "Válido una vez por cliente en ilustraciones personalizadas." },
    { "type": "header", "content": "Comportamiento" },
    { "type": "range", "id": "delay", "label": "Mostrar tras", "min": 0, "max": 20, "step": 1, "unit": "s", "default": 4 },
    { "type": "range", "id": "repeat_days", "label": "Volver a mostrar si lo cierran, tras", "min": 1, "max": 30, "step": 1, "unit": "d", "default": 7 },
    { "type": "header", "content": "Pastilla con cuenta atrás" },
    { "type": "range", "id": "minutes", "label": "Tiempo que el código queda aplicado", "min": 15, "max": 180, "step": 15, "unit": "min", "default": 90 },
    { "type": "text", "id": "badge_wait_title", "label": "Esperando: título", "default": "Tu código [code] te está esperando", "info": "[code] se sustituye por el código" },
    { "type": "text", "id": "badge_wait_text", "label": "Esperando: texto", "default": "Elige tu ilustración personalizada para usarlo" },
    { "type": "text", "id": "badge_ok_title", "label": "Aplicado: título", "default": "¡Enhorabuena! Tu [code] ya está aplicado" },
    { "type": "text", "id": "badge_ok_text", "label": "Aplicado: texto", "default": "Te ahorras [amount] en tu pedido", "info": "[amount] se sustituye por el ahorro" },
    { "type": "text", "id": "badge_max_title", "label": "Varios códigos: título", "default": "¡No hay quien dé más!" },
    { "type": "text", "id": "badge_max_text", "label": "Varios códigos: texto", "default": "[codes] · Máximo ahorro: [amount]", "info": "[codes] = códigos aplicados, [amount] = ahorro total" },
    { "type": "text", "id": "badge_cross_title", "label": "Segundo código guardado: título", "default": "¡Tienes otro descuento esperando!" },
    { "type": "text", "id": "badge_cross_text", "label": "Segundo código guardado: texto", "default": "Ya ahorras [amount]. Elige 3 láminas infantiles y te regalamos la tercera" },
    { "type": "text", "id": "badge_timer_text", "label": "Texto antes del contador", "default": "Tu 10 % sigue aplicado durante" }
  ],
  "presets": [{ "name": "Pop-up de bienvenida" }]
}
{% endschema %}
