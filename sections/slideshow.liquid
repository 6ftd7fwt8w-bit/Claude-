<section class="slideshow" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}"
  style="--hero-height: {{ section.settings.height }}px; --hero-height-mobile: {{ section.settings.height_mobile }}px;">
  <div class="slideshow__track" data-slideshow-track>
    {%- for block in section.blocks -%}
      <div class="slide{% if block.settings.light_text %} slide--light{% endif %}" {{ block.shopify_attributes }} data-slide
        {% unless forloop.first %}aria-hidden="true"{% endunless %}>
        <div class="slide__media" style="--overlay: {{ block.settings.overlay | divided_by: 100.0 }}">
          {%- if block.settings.image != blank -%}
            {%- assign loading = 'lazy' -%}{%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- endif -%}
            {%- assign focal_style = 'object-position: ' | append: block.settings.focal -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 900 }}">
              {%- endif -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag:
                loading: loading, fetchpriority: 'high', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw',
                style: focal_style }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="slide__content slide__content--{{ block.settings.align }} slide__content--{{ block.settings.valign }}">
          <div class="slide__box{% if block.settings.panel %} slide__box--panel{% endif %} slide__fade">
            {%- if block.settings.tag != blank -%}<span class="tag-highlight script">{{ block.settings.tag }}</span><br>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 class="slide__heading display">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="slide__text">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button{% if block.settings.light_text %} button--light{% endif %}">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <button type="button" class="slideshow__arrow slideshow__arrow--prev" data-slide-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
    <button type="button" class="slideshow__arrow slideshow__arrow--next" data-slide-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    <div class="slideshow__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="slideshow__dot" data-slide-dot="{{ forloop.index0 }}" aria-label="{{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Pase de diapositivas",
  "settings": [
    { "type": "range", "id": "height", "label": "Altura escritorio", "min": 380, "max": 900, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "height_mobile", "label": "Altura móvil", "min": 360, "max": 800, "step": 20, "unit": "px", "default": 560 },
    { "type": "checkbox", "id": "autoplay", "label": "Cambio automático", "default": true },
    { "type": "range", "id": "speed", "label": "Segundos por diapositiva", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagen móvil (opcional)" },
        { "type": "text", "id": "focal", "label": "Punto focal (CSS)", "default": "center center", "info": "Ej: 30% center" },
        { "type": "range", "id": "overlay", "label": "Oscurecer imagen", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },
        { "type": "text", "id": "tag", "label": "Etiqueta (cursiva sobre fondo de color)", "default": "Nueva colección" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Iconos de la colección" },
        { "type": "text", "id": "text", "label": "Subtítulo", "default": "Favoritas por una razón." },
        { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver favoritas" },
        { "type": "url", "id": "button_link", "label": "Enlace del botón" },
        {
          "type": "select", "id": "align", "label": "Posición horizontal",
          "options": [{ "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" }],
          "default": "right"
        },
        {
          "type": "select", "id": "valign", "label": "Posición vertical",
          "options": [{ "value": "top", "label": "Arriba" }, { "value": "middle", "label": "Centro" }, { "value": "bottom", "label": "Abajo" }],
          "default": "middle"
        },
        { "type": "checkbox", "id": "panel", "label": "Caja clara detrás del texto", "default": false },
        { "type": "checkbox", "id": "light_text", "label": "Texto blanco", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Pase de diapositivas", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
