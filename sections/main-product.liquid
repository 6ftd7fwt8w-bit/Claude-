{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign has_only_default = product.has_only_default_variant
-%}
<section class="section" style="padding-top:28px">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="breadcrumbs">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      {%- if collection -%} / <a href="{{ collection.url }}">{{ collection.title }}</a>
      {%- elsif product.collections.first -%} / <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>{%- endif -%}
      / <span>{{ product.title | split: ' | ' | first }}</span>
    </nav>

    <div class="product" data-product data-section="{{ section.id }}">
      <div class="product__gallery" data-product-gallery>
        {%- for media in product.media -%}
          <div class="media" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- assign loading = 'lazy' -%}{%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- endif -%}
                <a href="{{ media | image_url: width: 2400 }}" target="_blank" rel="noopener" style="display:block;height:100%">
                  {{ media | image_url: width: 1600 | image_tag: loading: loading, widths: '500, 800, 1100, 1400, 1600', sizes: '(min-width: 990px) 55vw, 90vw', alt: media.alt | default: product.title }}
                </a>
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endfor -%}
      </div>

      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | split: ' | ' | first }}</h1>

            {%- when 'price' -%}
              <div {{ block.shopify_attributes }}>
                <div class="product__price" data-product-price>{% render 'price', product: product, variant: current_variant %}</div>
                {%- if cart.taxes_included -%}<div class="product__tax">{{ 'products.tax_included' | t }}</div>{%- endif -%}
              </div>

            {%- when 'text' -%}
              <div class="rte muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'variant_picker' -%}
              {%- unless has_only_default -%}
                <div {{ block.shopify_attributes }} data-variant-picker>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="option" style="margin-bottom:16px">
                      <legend>{{ option.name }}<span data-option-selected="{{ forloop.index0 }}">{{ option.selected_value }}</span></legend>
                      <div class="option__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                          <input type="radio" id="{{ input_id }}" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"
                            data-option-index="{{ forloop.parentloop.index0 }}" {% if value == option.selected_value %}checked{% endif %}>
                          <label for="{{ input_id }}">{{ value }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <div class="product__buy">
                    <div class="qty">
                      <button type="button" data-qty-minus aria-label="-">&minus;</button>
                      <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.quantity' | t }}">
                      <button type="button" data-qty-plus aria-label="+">+</button>
                    </div>
                    <button type="submit" name="add" class="button" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                      {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div style="margin-top:10px">{{ form | payment_button }}</div>
                  {%- endif -%}
                  <p class="form-message form-message--error" data-form-error hidden></p>
                {%- endform -%}
              </div>

            {%- when 'personalization_form' -%}
              <div {{ block.shopify_attributes }}>{% render 'vlh-formulario-personalizado', product: product %}</div>

            {%- when 'pack_cta' -%}
              <div {{ block.shopify_attributes }}>{% render 'vlh-pack-cta', product: product %}</div>

            {%- when 'idea_cta' -%}
              <div {{ block.shopify_attributes }}>{% render 'vlh-idea-cta', product: product %}</div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                {%- if block.settings.collapsible -%}
                  <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                    <summary>{{ block.settings.heading }}</summary>
                    <div class="accordion__content rte">{{ product.description }}</div>
                  </details>
                {%- else -%}
                  <div class="rte" style="font-size:14px" {{ block.shopify_attributes }}>{{ product.description }}</div>
                {%- endif -%}
              {%- endif -%}

            {%- when 'collapsible' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading }}</summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>

            {%- when 'usp' -%}
              <div class="product__usp" {{ block.shopify_attributes }}>
                {%- if block.settings.usp_1 != blank -%}<div>{% render 'icon', name: block.settings.icon_1 %}{{ block.settings.usp_1 }}</div>{%- endif -%}
                {%- if block.settings.usp_2 != blank -%}<div>{% render 'icon', name: block.settings.icon_2 %}{{ block.settings.usp_2 }}</div>{%- endif -%}
                {%- if block.settings.usp_3 != blank -%}<div>{% render 'icon', name: block.settings.icon_3 %}{{ block.settings.usp_3 }}</div>{%- endif -%}
              </div>

            {%- when 'whatsapp' -%}
              {%- assign wa_msg = block.settings.message | append: ' ' | append: product.title | url_encode -%}
              <a class="link-arrow" style="display:inline-flex;gap:8px;align-items:center" href="https://wa.me/{{ block.settings.number }}?text={{ wa_msg }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
                <span style="width:16px;height:16px;display:inline-flex">{% render 'icon', name: 'whatsapp' %}</span>{{ block.settings.label }}
              </a>

            {%- when 'back_link' -%}
              {%- assign back = collection | default: product.collections.first -%}
              {%- if back -%}
                <a href="{{ back.url }}" class="button button--outline button--full" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              {%- endif -%}

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "blocks": [
    { "type": "title", "name": "Título", "limit": 1 },
    { "type": "price", "name": "Precio", "limit": 1 },
    { "type": "text", "name": "Texto", "settings": [{ "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Texto breve</p>" }] },
    { "type": "variant_picker", "name": "Selector de variantes", "limit": 1 },
    {
      "type": "buy_buttons", "name": "Botón de compra", "limit": 1,
      "settings": [{ "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botón de pago rápido", "default": false }]
    },
    { "type": "personalization_form", "name": "Formulario personalizado", "limit": 1 },
    { "type": "pack_cta", "name": "CTA Packs regalo", "limit": 1 },
    { "type": "idea_cta", "name": "CTA Idea a medida", "limit": 1 },
    {
      "type": "description", "name": "Descripción", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "collapsible", "label": "Mostrar como desplegable", "default": true },
        { "type": "text", "id": "heading", "label": "Título del desplegable", "default": "Descripción" },
        { "type": "checkbox", "id": "open", "label": "Abierto por defecto", "default": true }
      ]
    },
    {
      "type": "collapsible", "name": "Desplegable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Envíos y devoluciones" },
        { "type": "richtext", "id": "content", "label": "Contenido" },
        { "type": "page", "id": "page", "label": "Contenido desde página" }
      ]
    },
    {
      "type": "usp", "name": "Ventajas (3 iconos)", "limit": 1,
      "settings": [
        { "type": "text", "id": "usp_1", "label": "Ventaja 1", "default": "Papel de calidad" },
        { "type": "select", "id": "icon_1", "label": "Icono 1", "options": [{ "value": "frame", "label": "Cuadro" }, { "value": "brush", "label": "Pincel" }, { "value": "truck", "label": "Envío" }, { "value": "gift", "label": "Regalo" }, { "value": "heart", "label": "Corazón" }, { "value": "lock", "label": "Candado" }], "default": "frame" },
        { "type": "text", "id": "usp_2", "label": "Ventaja 2", "default": "Envío protegido" },
        { "type": "select", "id": "icon_2", "label": "Icono 2", "options": [{ "value": "frame", "label": "Cuadro" }, { "value": "brush", "label": "Pincel" }, { "value": "truck", "label": "Envío" }, { "value": "gift", "label": "Regalo" }, { "value": "heart", "label": "Corazón" }, { "value": "lock", "label": "Candado" }], "default": "truck" },
        { "type": "text", "id": "usp_3", "label": "Ventaja 3", "default": "Pago seguro" },
        { "type": "select", "id": "icon_3", "label": "Icono 3", "options": [{ "value": "frame", "label": "Cuadro" }, { "value": "brush", "label": "Pincel" }, { "value": "truck", "label": "Envío" }, { "value": "gift", "label": "Regalo" }, { "value": "heart", "label": "Corazón" }, { "value": "lock", "label": "Candado" }], "default": "lock" }
      ]
    },
    {
      "type": "whatsapp", "name": "Enlace WhatsApp", "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "¿Dudas? Escríbenos por WhatsApp" },
        { "type": "text", "id": "number", "label": "Número (con prefijo, sin +)", "default": "34600000000" },
        { "type": "text", "id": "message", "label": "Mensaje", "default": "¡Hola! Tengo una duda sobre" }
      ]
    },
    { "type": "back_link", "name": "Botón volver a colección", "limit": 1, "settings": [{ "type": "text", "id": "label", "label": "Texto", "default": "Ver más láminas" }] },
    { "type": "custom_liquid", "name": "Liquid personalizado", "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Código" }] }
  ]
}
{% endschema %}
