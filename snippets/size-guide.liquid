{%- comment -%}
  Guía visual de tamaños a escala (1 cm = 2 px): chica de 1,65 m y, apoyadas en el suelo a su lado,
  lámina A4, lámina A3, lienzo 70×100 y lienzo 80×120, todas con la misma ilustración.
  Parámetros: art (imagen de la ilustración, sin fondo de habitación)
{%- endcomment -%}
{%- liquid
  assign art_url = ''
  if art != blank
    assign art_url = art | image_url: width: 500
  endif
  assign uid = 'sg' | append: art_url.size
-%}
<figure class="size-guide">
  <svg viewBox="0 0 640 450" role="img" aria-labelledby="{{ uid }}-t">
    <title id="{{ uid }}-t">Comparativa de tamaños junto a una chica de 1,65 m: lámina A4 de 21 × 29,7 cm, lámina A3 de 29,7 × 42 cm, lienzo de 70 × 100 cm y lienzo de 80 × 120 cm</title>
    <defs>
      <filter id="{{ uid }}-sh" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="2" dy="3" stdDeviation="3" flood-color="#5a4632" flood-opacity=".22"/></filter>
      <marker id="{{ uid }}-ar" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#8a7a68"/></marker>
    </defs>

    {%- comment -%} Suelo: solo una línea {%- endcomment -%}
    <line x1="4" y1="380" x2="636" y2="380" stroke="#CDBFAE" stroke-width="1.5"/>

    {%- comment -%} Chica de 165 cm = 330 px (cabeza en y=50, pies en y=380) {%- endcomment -%}
    <g fill="#C9B6A0">
      <path d="M51 68 a19 19 0 0 1 38 0 v36 q-19 7 -38 0 z" fill="#A58D73"/>
      <circle cx="70" cy="68" r="15"/>
      <rect x="66" y="80" width="8" height="18"/>
      <path d="M54 102 q16 -8 32 0 l-4 60 l20 108 h-64 l20 -108 z" fill="#B89F86"/>
      <path d="M55 103 l-9 52 l-3 58 h7 l4 -56 l7 -42 z"/>
      <path d="M85 103 l9 52 l3 58 h-7 l-4 -56 l-7 -42 z"/>
      <path d="M60 270 h9 l-1 104 h-6 z"/>
      <path d="M71 270 h9 l-2 104 h-6 z"/>
      <ellipse cx="64" cy="376" rx="7" ry="3.5"/>
      <ellipse cx="76" cy="376" rx="7" ry="3.5"/>
    </g>
    <line x1="18" y1="50" x2="18" y2="380" stroke="#8a7a68" stroke-width="1.2" marker-start="url(#{{ uid }}-ar)" marker-end="url(#{{ uid }}-ar)"/>
    <text x="8" y="36" class="sg-dim">1,65 m</text>

    {%- comment -%} Piezas apoyadas en el suelo: [x; ancho; alto; nombre; medidas; lienzo; alto de la etiqueta sobre la pieza (0 = debajo del suelo)] {%- endcomment -%}
    {%- assign pieces = '130;42;59;Lámina A4;21 × 29,7 cm;0;28|214;59;84;Lámina A3;29,7 × 42 cm;0;52|308;140;200;Lienzo 70×100;70 × 100 cm;1;0|472;160;240;Lienzo 80×120;80 × 120 cm;1;0' | split: '|' -%}
    {%- for pc in pieces -%}
      {%- liquid
        assign f = pc | split: ';'
        assign px = f[0] | plus: 0
        assign pw = f[1] | plus: 0
        assign ph = f[2] | plus: 0
        assign py = 380 | minus: ph
        assign cx = pw | divided_by: 2 | plus: px
        assign is_canvas = f[5]
        assign up = f[6] | plus: 0
        if up > 0
          assign ly = py | minus: up
        else
          assign ly = 408
        endif
        assign ly2 = ly | plus: 20
        assign m = 3
        if is_canvas == '1'
          assign m = 0
        endif
        assign ix = px | plus: m
        assign iy = py | plus: m
        assign iw = m | times: 2 | minus: pw | times: -1
        assign ih = m | times: 2 | minus: ph | times: -1
      -%}
      <g filter="url(#{{ uid }}-sh)"><rect x="{{ px }}" y="{{ py }}" width="{{ pw }}" height="{{ ph }}" fill="{% if is_canvas == '1' %}#fbf8f3{% else %}#ffffff{% endif %}"/></g>
      {%- if art_url != '' -%}<image href="{{ art_url }}" x="{{ ix }}" y="{{ iy }}" width="{{ iw }}" height="{{ ih }}" preserveAspectRatio="xMidYMid slice"/>{%- endif -%}
      {%- if is_canvas == '1' -%}<rect x="{{ px | plus: pw }}" y="{{ py | plus: 3 }}" width="4" height="{{ ph | minus: 3 }}" fill="#d9cbb8"/>{%- endif -%}
      <text x="{{ cx }}" y="{{ ly }}" class="sg-name" text-anchor="middle">{{ f[3] }}</text>
      <text x="{{ cx }}" y="{{ ly2 }}" class="sg-dim" text-anchor="middle">{{ f[4] }}</text>
    {%- endfor -%}
  </svg>
  <figcaption class="size-guide__caption">A escala, junto a una chica de 1,65 m. Los lienzos llegan montados en bastidor, listos para colgar.</figcaption>
</figure>
