{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign has_only_default = product.has_only_default_variant
-%}
<section class="section" style="padding-top:28px">
  <div class="page-width">
    {%- comment -%} Anterior / siguiente producto de la colección (la de origen o, si no hay, la principal del producto), en bucle {%- endcomment -%}
    {%- liquid
      assign nav_col = collection
      if nav_col == blank
        for c in product.collections
          if c.handle == 'infantil' or c.handle == 'laminas-personalizadas' or c.handle == 'packs-regalo'
            assign nav_col = c
            break
          endif
        endfor
      endif
      if nav_col == blank
        assign nav_col = product.collections.first
      endif
      assign next_p = nil
      assign prev_p = nil
    -%}
    {%- if nav_col != blank and nav_col.products_count > 1 -%}
      {%- paginate nav_col.products by 250 -%}
        {%- liquid
          assign first_p = nil
          assign last_p = nil
          assign found = false
          for p in nav_col.products
            if forloop.first
              assign first_p = p
            endif
            if found
              assign next_p = p
              break
            endif
            if p.id == product.id
              assign found = true
              assign prev_p = last_p
            endif
            assign last_p = p
          endfor
          if found
            if next_p == nil
              assign next_p = first_p
            endif
            if prev_p == nil
              assign prev_p = nav_col.products.last
            endif
          else
            assign next_p = nil
          endif
          if next_p.id == product.id
            assign next_p = nil
          endif
          if prev_p.id == product.id
            assign prev_p = nil
          endif
        -%}
      {%- endpaginate -%}
    {%- endif -%}
    {%- if next_p or prev_p -%}
      {%- liquid
        assign nav_word = 'lámina'
        if nav_col.handle contains 'pack'
          assign nav_word = 'pack'
        elsif nav_col.handle contains 'personalizad'
          assign nav_word = 'ilustración'
        endif
      -%}
      <nav class="prod-nav" aria-label="Navegación entre productos">
        {%- if prev_p -%}
          <a class="next-prod next-prod--prev" href="{{ prev_p.url | within: nav_col }}" rel="prev" data-next-prod title="{{ prev_p.title | split: ' | ' | first | escape }}">
            <span class="next-prod__arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></span>
            {%- if prev_p.featured_image -%}{{ prev_p.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', width: 34, height: 34, alt: '', class: 'next-prod__img' }}{%- endif -%}
            <span class="next-prod__txt">Anterior<span class="next-prod__word"> {{ nav_word }}</span></span>
          </a>
        {%- else -%}<span></span>{%- endif -%}
        {%- if next_p -%}
          <a class="next-prod" href="{{ next_p.url | within: nav_col }}" rel="next" data-next-prod title="{{ next_p.title | split: ' | ' | first | escape }}">
            <span class="next-prod__txt">Siguiente<span class="next-prod__word"> {{ nav_word }}</span></span>
            {%- if next_p.featured_image -%}{{ next_p.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', width: 34, height: 34, alt: '', class: 'next-prod__img' }}{%- endif -%}
            <span class="next-prod__arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        {%- endif -%}
      </nav>
    {%- else -%}
      <nav class="breadcrumbs" aria-label="breadcrumbs">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        {%- if collection -%} / <a href="{{ collection.url }}">{{ collection.title }}</a>
        {%- elsif product.collections.first -%} / <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>{%- endif -%}
        / <span>{{ product.title | split: ' | ' | first }}</span>
      </nav>
    {%- endif -%}

    <div class="product" data-product data-section="{{ section.id }}">
      <div class="product__gallery" data-gallery>
        <div class="gallery-main" data-product-gallery data-gallery-track>
          {%- for media in product.media -%}
            <div class="gallery-main__slide media" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- assign loading = 'lazy' -%}{%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- endif -%}
                  <button type="button" class="gallery-main__zoom" data-gallery-zoom="{{ forloop.index0 }}" aria-label="{{ 'products.zoom' | t }}">
                    {{ media | image_url: width: 1600 | image_tag: loading: loading, widths: '500, 800, 1100, 1400, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                  </button>
                {%- when 'video' -%}
                  {{ media | video_tag: autoplay: false, loop: true, muted: true, controls: true, playsinline: true, preload: 'metadata' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- else -%}
            <div class="gallery-main__slide media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endfor -%}
        </div>
        {%- if product.media.size > 1 -%}
          <button type="button" class="gallery-main__arrow gallery-main__arrow--prev" data-gallery-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
          <button type="button" class="gallery-main__arrow gallery-main__arrow--next" data-gallery-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
          <div class="gallery-thumbs" data-gallery-thumbs>
            {%- for media in product.media -%}
              <button type="button" class="gallery-thumbs__item{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ forloop.index0 }}" aria-label="{{ forloop.index }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="gallery-thumbs__play" aria-hidden="true">▶</span>{%- endif -%}
              </button>
            {%- endfor -%}
          </div>
          <div class="gallery-dots" aria-hidden="true">
            {%- for media in product.media -%}<span class="gallery-dots__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
          </div>
        {%- endif -%}
        <script type="application/json" data-gallery-zoom-list>[
          {%- for media in product.media -%}{%- if media.media_type == 'image' -%}{{ media | image_url: width: 1400 | json }}{%- else -%}null{%- endif -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
        ]</script>
      </div>

      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'breadcrumb' -%}
              {%- assign crumb = block.settings.collection | default: collection | default: product.collections.first -%}
              {%- if crumb -%}
                <a href="{{ crumb.url }}" class="product__crumb" {{ block.shopify_attributes }}>
                  {% render 'icon', name: 'chevron-left' %}<span>{{ block.settings.label | default: crumb.title }}</span>
                </a>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | split: ' | ' | first }}</h1>

            {%- when 'price' -%}
              <div class="product__price-row" {{ block.shopify_attributes }}>
                <div>
                  <div class="product__price" data-product-price>
                    {%- if product.price_varies and product.selected_variant == blank -%}
                      {% render 'price', product: product, show_from: true %}
                    {%- else -%}
                      {% render 'price', product: product, variant: current_variant %}
                    {%- endif -%}
                  </div>
                  {%- if cart.taxes_included -%}<div class="product__tax">{{ 'products.tax_included' | t }}</div>{%- endif -%}
                </div>
              </div>

            {%- when 'text' -%}
              <div class="rte muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'variant_picker' -%}
              {%- unless has_only_default -%}
                <div {{ block.shopify_attributes }} data-variant-picker>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="option" style="margin-bottom:16px">
                      <legend>{{ option.name }}<span data-option-selected="{{ forloop.index0 }}">{{ option.selected_value }}</span></legend>
                      <div class="option__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                          <input type="radio" id="{{ input_id }}" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"
                            data-option-index="{{ forloop.parentloop.index0 }}" {% if value == option.selected_value %}checked{% endif %}>
                          <label for="{{ input_id }}">{{ value }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  {%- liquid
                    assign sizes_joined = product.options_with_values | map: 'values' | join: '|'
                    assign show_lamina_guide = false
                    if sizes_joined contains 'A4' and sizes_joined contains 'A3'
                      assign show_lamina_guide = true
                    endif
                    if sizes_joined contains 'ienzo'
                      assign show_lamina_guide = false
                    endif
                  -%}
                  {%- if show_lamina_guide -%}
                    <button type="button" class="guide-open" data-guide-open>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="8" width="18" height="8" rx="1"/><path d="M7 8v3M11 8v4M15 8v3M19 8v2"/></svg>
                      Ver A4 y A3 a escala <span>(junto a una chica de 1,65 m)</span>
                    </button>
                    <dialog class="guide-dialog" data-guide aria-label="Comparativa de tamaños A4 y A3">
                      <button type="button" class="guide-dialog__close" data-guide-close aria-label="Cerrar">&times;</button>
                      <p class="guide-dialog__title">¿A4 o A3?</p>
                      {% render 'size-guide', art: product.featured_image, laminas_only: true %}
                    </dialog>
                  {%- endif -%}
                  <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <div class="product__buy">
                    <div class="qty">
                      <button type="button" data-qty-minus aria-label="-">&minus;</button>
                      <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.quantity' | t }}">
                      <button type="button" data-qty-plus aria-label="+">+</button>
                    </div>
                    <button type="submit" name="add" class="button" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                      {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div style="margin-top:10px">{{ form | payment_button }}</div>
                  {%- endif -%}
                  <p class="form-message form-message--error" data-form-error hidden></p>
                {%- endform -%}
              </div>

            {%- when 'personalization_form' -%}
              {%- liquid
                comment
                  Fotos de ejemplo: las del producto (metacampos vlh.ejemplo_lamina / vlh.ejemplo_lienzo) o, si no tiene, las del bloque
                endcomment
                assign ej_lamina = product.metafields.vlh.ejemplo_lamina.value | default: block.settings.lamina_image
                assign ej_lienzo = product.metafields.vlh.ejemplo_lienzo.value | default: block.settings.canvas_image
              -%}
              <div {{ block.shopify_attributes }}>{% render 'vlh-formulario-personalizado', product: product, lamina_image: ej_lamina, canvas_image: ej_lienzo, canvas_detail: block.settings.canvas_detail, canvas_text: block.settings.canvas_text, guide_art: block.settings.guide_art, guide_art_a3: block.settings.guide_art_a3 %}</div>

            {%- when 'pack_cta' -%}
              <div {{ block.shopify_attributes }}>{% render 'vlh-pack-cta', product: product %}</div>

            {%- when 'idea_cta' -%}
              <div {{ block.shopify_attributes }}>{% render 'vlh-idea-cta', product: product %}</div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                {%- if block.settings.collapsible -%}
                  <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                    <summary>{{ block.settings.heading }}</summary>
                    <div class="accordion__content rte">{% render 'product-description-text', product: product %}</div>
                  </details>
                {%- else -%}
                  <div class="rte" style="font-size:14px" {{ block.shopify_attributes }}>{% render 'product-description-text', product: product %}</div>
                {%- endif -%}
              {%- endif -%}

            {%- when 'collapsible' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading }}</summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>

            {%- when 'usp' -%}
              <div class="product__usp" {{ block.shopify_attributes }}>
                {%- if block.settings.usp_1 != blank -%}<div>{% render 'icon', name: block.settings.icon_1 %}{{ block.settings.usp_1 }}</div>{%- endif -%}
                {%- if block.settings.usp_2 != blank -%}<div>{% render 'icon', name: block.settings.icon_2 %}{{ block.settings.usp_2 }}</div>{%- endif -%}
                {%- if block.settings.usp_3 != blank -%}<div>{% render 'icon', name: block.settings.icon_3 %}{{ block.settings.usp_3 }}</div>{%- endif -%}
              </div>

            {%- when 'whatsapp' -%}
              {%- assign wa_msg = block.settings.message | append: ' ' | append: product.title | url_encode -%}
              <a class="link-arrow" style="display:inline-flex;gap:8px;align-items:center" href="https://wa.me/{{ block.settings.number }}?text={{ wa_msg }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
                <span style="width:16px;height:16px;display:inline-flex">{% render 'icon', name: 'whatsapp' %}</span>{{ block.settings.label }}
              </a>

            {%- when 'back_link' -%}
              {%- comment -%} Siempre a la colección principal (infantil, personalizadas o packs), no a subcolecciones como «Bosque encantado» {%- endcomment -%}
              {%- liquid
                assign back = block.settings.collection
                if back == blank
                  for c in product.collections
                    if c.handle == 'infantil' or c.handle == 'laminas-personalizadas' or c.handle == 'packs-regalo'
                      assign back = c
                      break
                    endif
                  endfor
                endif
                if back == blank
                  assign back = collection | default: product.collections.first
                endif
              -%}
              {%- if back -%}
                <a href="{{ back.url }}" class="button button--outline button--full" data-back-link {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              {%- endif -%}

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "blocks": [
    { "type": "breadcrumb", "name": "Enlace a la colección", "limit": 1, "settings": [
      { "type": "collection", "id": "collection", "label": "Colección", "info": "Si está vacío, la colección desde la que se llegó" },
      { "type": "text", "id": "label", "label": "Texto", "info": "Si está vacío, el nombre de la colección" }
    ] },
    { "type": "title", "name": "Título", "limit": 1 },
    { "type": "price", "name": "Precio", "limit": 1 },
    { "type": "text", "name": "Texto", "settings": [{ "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Texto breve</p>" }] },
    { "type": "variant_picker", "name": "Selector de variantes", "limit": 1 },
    {
      "type": "buy_buttons", "name": "Botón de compra", "limit": 1,
      "settings": [{ "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botón de pago rápido", "default": false }]
    },
    { "type": "personalization_form", "name": "Formulario personalizado", "limit": 1, "settings": [
      { "type": "image_picker", "id": "lamina_image", "label": "Foto de ejemplo de lámina", "info": "Miniatura junto a los tamaños de lámina. Cada producto puede tener la suya en el metacampo «Ejemplo en lámina»" },
      { "type": "image_picker", "id": "canvas_image", "label": "Foto de ejemplo de lienzo", "info": "Miniatura junto a los tamaños de lienzo. Cada producto puede tener la suya en el metacampo «Ejemplo en lienzo»" },
      { "type": "image_picker", "id": "canvas_detail", "label": "Foto de detalle del lienzo (esquina)", "info": "Segunda foto al ampliar" },
      { "type": "text", "id": "canvas_text", "label": "Texto de los lienzos", "default": "Listo para colgar · bastidor de madera · tela 100 % algodón. Arte que hace única tu estancia." },
      { "type": "image_picker", "id": "guide_art", "label": "Guía de tamaños: ilustración de ejemplo", "info": "Solo la ilustración, sin fondo" },
      { "type": "image_picker", "id": "guide_art_a3", "label": "Guía de tamaños: ejemplo lámina A3" }
    ] },
    { "type": "pack_cta", "name": "CTA Packs regalo", "limit": 1 },
    { "type": "idea_cta", "name": "CTA Idea a medida", "limit": 1 },
    {
      "type": "description", "name": "Descripción", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "collapsible", "label": "Mostrar como desplegable", "default": true },
        { "type": "text", "id": "heading", "label": "Título del desplegable", "default": "Descripción" },
        { "type": "checkbox", "id": "open", "label": "Abierto por defecto", "default": true }
      ]
    },
    {
      "type": "collapsible", "name": "Desplegable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Envíos y devoluciones" },
        { "type": "richtext", "id": "content", "label": "Contenido" },
        { "type": "page", "id": "page", "label": "Contenido desde página" }
      ]
    },
    {
      "type": "usp", "name": "Ventajas (3 iconos)", "limit": 1,
      "settings": [
        { "type": "text", "id": "usp_1", "label": "Ventaja 1", "default": "Algodón verjurado 300 g" },
        { "type": "select", "id": "icon_1", "label": "Icono 1", "options": [{ "value": "frame", "label": "Cuadro" }, { "value": "brush", "label": "Pincel" }, { "value": "truck", "label": "Envío" }, { "value": "gift", "label": "Regalo" }, { "value": "heart", "label": "Corazón" }, { "value": "lock", "label": "Candado" }], "default": "frame" },
        { "type": "text", "id": "usp_2", "label": "Ventaja 2", "default": "Envío protegido" },
        { "type": "select", "id": "icon_2", "label": "Icono 2", "options": [{ "value": "frame", "label": "Cuadro" }, { "value": "brush", "label": "Pincel" }, { "value": "truck", "label": "Envío" }, { "value": "gift", "label": "Regalo" }, { "value": "heart", "label": "Corazón" }, { "value": "lock", "label": "Candado" }], "default": "truck" },
        { "type": "text", "id": "usp_3", "label": "Ventaja 3", "default": "Pago seguro" },
        { "type": "select", "id": "icon_3", "label": "Icono 3", "options": [{ "value": "frame", "label": "Cuadro" }, { "value": "brush", "label": "Pincel" }, { "value": "truck", "label": "Envío" }, { "value": "gift", "label": "Regalo" }, { "value": "heart", "label": "Corazón" }, { "value": "lock", "label": "Candado" }], "default": "lock" }
      ]
    },
    {
      "type": "whatsapp", "name": "Enlace WhatsApp", "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "¿Dudas? Escríbenos por WhatsApp" },
        { "type": "text", "id": "number", "label": "Número (con prefijo, sin +)", "default": "34600000000" },
        { "type": "text", "id": "message", "label": "Mensaje", "default": "¡Hola! Tengo una duda sobre" }
      ]
    },
    { "type": "back_link", "name": "Botón volver a colección", "limit": 1, "settings": [{ "type": "text", "id": "label", "label": "Texto", "default": "Ver más láminas" }, { "type": "collection", "id": "collection", "label": "Colección", "info": "Si está vacío, la colección desde la que se llegó" }] },
    { "type": "custom_liquid", "name": "Liquid personalizado", "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Código" }] }
  ]
}
{% endschema %}
