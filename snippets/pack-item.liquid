{%- comment -%}
  Lámina dentro del bloque "Hacen pack". Parámetros: product, current (bool)
{%- endcomment -%}
{%- liquid
  assign in_cross = false
  if settings.cross_collection != blank
    for c in product.collections
      if c.handle == settings.cross_collection.handle
        assign in_cross = true
      endif
    endfor
  endif
-%}
<div class="pack__item{% if current %} is-current is-on{% endif %}" data-pack-item{% if current %} data-current{% endif %} data-cross="{{ in_cross }}">
  <script type="application/json" data-pack-variants>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"o":{{ v.option1 | json }},"p":{{ v.price }},"a":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>
  {%- if current -%}<span class="pack__label">{{ 'products.pack_current' | t }}</span>{%- endif -%}
  {% render 'product-card', product: product %}
  {%- if product.has_only_default_variant == false -%}
    {%- assign sel = product.selected_or_first_available_variant -%}
    <label class="pack__variant">
      <span class="visually-hidden">{{ product.options.first }}</span>
      <select class="input" data-pack-variant>
        {%- for v in product.variants -%}
          {%- assign money_v = v.price | money -%}
          <option value="{{ v.id }}"{% if v.id == sel.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title | split: ':' | first }} · {{ money_v }}</option>
        {%- endfor -%}
      </select>
    </label>
  {%- endif -%}
  {%- unless current -%}
    <button type="button" class="pack__toggle" aria-pressed="false" data-pack-toggle>
      <span class="pack__toggle-off">+ {{ 'products.pack_include' | t }}</span>
      <span class="pack__toggle-on">&#10003; {{ 'products.pack_included' | t }}</span>
    </button>
  {%- endunless -%}
</div>
