{%- liquid
  assign s = section.settings
  assign split = '1fr 1.45fr'
  if s.image_width == 'half'
    assign split = '1fr 1fr'
  endif
-%}
<section class="{% if s.contained %}section bg-{{ s.outer_background }}{% else %}section--flush{% endif %} reveal" data-reveal>
  <div class="{% if s.contained %}page-width{% endif %}">
    <div class="split{% if s.image_first %} split--reverse{% endif %}"
      style="--split: {{ split }}; --split-rev: {{ split | split: ' ' | reverse | join: ' ' }}; --split-bg: {{ s.panel_bg }};">
      <div class="split__text{% if s.text_center %} split__text--center{% endif %}">
        {%- if s.tag != blank -%}<span class="tag-highlight script">{{ s.tag }}</span>{%- endif -%}
        {%- if s.eyebrow != blank -%}<span class="eyebrow" style="margin-bottom:12px">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="split__heading {% if s.heading_size == 'large' %}display{% else %}h2{% endif %}">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="split__body rte">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank -%}
          <div><a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="button" style="min-height:38px;padding:0 20px;font-size:11px">{{ s.button_label }}</a></div>
        {%- endif -%}
      </div>
      <div class="split__media media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 750px) 60vw, 100vw' }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner partido",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "checkbox", "id": "image_first", "label": "Imagen a la izquierda", "default": false },
    {
      "type": "select", "id": "image_width", "label": "Ancho de imagen",
      "options": [{ "value": "wide", "label": "Ancha" }, { "value": "half", "label": "Mitad" }],
      "default": "wide"
    },
    { "type": "text", "id": "tag", "label": "Etiqueta (cursiva sobre color)", "default": "Favoritas de temporada" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Dignas de coleccionar" },
    {
      "type": "select", "id": "heading_size", "label": "Tamaño del título",
      "options": [{ "value": "large", "label": "Grande" }, { "value": "medium", "label": "Mediano" }],
      "default": "large"
    },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Láminas con un encanto que dura.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Descubrir" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "text_center", "label": "Centrar texto", "default": false },
    { "type": "color", "id": "panel_bg", "label": "Fondo del panel de texto", "default": "#EFE8DE" },
    { "type": "checkbox", "id": "contained", "label": "Ancho de página (con márgenes)", "default": true },
    {
      "type": "select", "id": "outer_background", "label": "Fondo exterior",
      "options": [{ "value": "default", "label": "Crema" }, { "value": "alt", "label": "Arena" }],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Banner partido" }]
}
{% endschema %}
